package partials

import (
	"context"

	"github.com/flowline-io/flowbot/pkg/i18n"
)

// PageHeader renders a page title from i18n message keys. Empty key omits that line.
templ PageHeader(ctx context.Context, titleKey, subtitleKey string) {
	@pageHeaderBody(ctx, pageHeaderLine(ctx, titleKey), pageHeaderLine(ctx, subtitleKey)) {
		{ children... }
	}
}

// PageHeaderLiteral renders a page title from literal strings (dynamic entity names).
templ PageHeaderLiteral(ctx context.Context, title, subtitle string) {
	@pageHeaderBody(ctx, title, subtitle) {
		{ children... }
	}
}

templ pageHeaderBody(ctx context.Context, title, subtitle string) {
	<div class="flex items-center justify-between gap-4 mb-6" data-testid="page-header">
		<div class="min-w-0">
			if title != "" {
				<h1 class="text-2xl font-semibold tracking-tight text-base-content m-0">{ title }</h1>
			}
			if subtitle != "" {
				<p class="text-sm text-base-content/60 m-0 mt-1">{ subtitle }</p>
			}
		</div>
		<div class="flex items-center gap-2 shrink-0">
			{ children... }
		</div>
	</div>
}

func pageHeaderLine(ctx context.Context, key string) string {
	if key == "" {
		return ""
	}
	return i18n.T(ctx, key)
}
