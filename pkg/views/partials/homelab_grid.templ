package partials

import (
	"context"
	"sort"

	"github.com/flowline-io/flowbot/pkg/homelab"
	"github.com/flowline-io/flowbot/pkg/i18n"
)

func uniqueCapTypes(apps []homelab.App) []string {
	seen := make(map[string]struct{})
	for _, app := range apps {
		for _, cap := range app.Capabilities {
			seen[cap.Capability] = struct{}{}
		}
	}
	result := make([]string, 0, len(seen))
	for k := range seen {
		result = append(result, k)
	}
	sort.Strings(result)
	return result
}

templ HomelabGrid(ctx context.Context, apps []homelab.App, scannedAt string) {
	<div id="homelab-registry" x-data="homelabRegistry"
		data-testid="homelab-registry">
		<div class="flowbot-surface flowbot-homelab-toolbar">
			<div class="flowbot-homelab-toolbar-main">
				<label class="flowbot-homelab-toolbar-search">
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="none" class="flowbot-homelab-toolbar-search-icon" aria-hidden="true">
						<circle cx="6.5" cy="6.5" r="4" stroke="currentColor" stroke-width="1.5"></circle>
						<path d="M9.5 9.5 13 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
					</svg>
					<input
						type="search"
						class="flowbot-homelab-toolbar-search-input"
						placeholder={ i18n.T(ctx, "homelab.search_placeholder") }
						x-model="search"
						aria-label={ i18n.T(ctx, "homelab.search_aria") }
						data-testid="homelab-search"/>
				</label>
				<select
					class="select select-bordered select-sm flowbot-homelab-toolbar-select"
					x-model="filterCapability"
					data-testid="homelab-capability-filter">
					<option value="">{ i18n.T(ctx, "homelab.all_capabilities") }</option>
					for _, capType := range uniqueCapTypes(apps) {
						<option value={ capType }>{ capType }</option>
					}
				</select>
				<div class="flowbot-homelab-toolbar-actions">
					<button
						type="button"
						hx-post="/service/web/homelab/rescan"
						class="btn btn-sm btn-ghost flowbot-homelab-toolbar-btn"
						data-testid="homelab-rescan">
						<span class="loading loading-spinner loading-xs htmx-indicator mr-1"></span>
						{ i18n.T(ctx, "homelab.rescan") }
					</button>
					if scannedAt != "" {
						<span class="flowbot-homelab-toolbar-meta"
							data-testid="homelab-scanned-at">{ i18n.T(ctx, "homelab.last_scan") } { scannedAt }</span>
					}
				</div>
			</div>
		</div>
		if len(apps) == 0 {
			@EmptyStateCTA(
				i18n.T(ctx, "homelab.empty.title"),
				i18n.T(ctx, "homelab.empty.detail"),
				"/service/web/homelab",
				i18n.T(ctx, "homelab.empty.cta"),
			)
		} else {
			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4"
				data-testid="homelab-card-grid">
				for _, app := range apps {
					@HomelabCard(ctx, app)
				}
			</div>
		}
	</div>
}
