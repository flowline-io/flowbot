package partials

import (
	"context"

	"github.com/flowline-io/flowbot/pkg/i18n"
	"github.com/flowline-io/flowbot/pkg/types/model"
)

templ AgentSkillRow(ctx context.Context, item model.AgentSkill) {
	<tr id={ agentSkillRowID(item) } hx-target="this" hx-swap="outerHTML" class="hover">
		<td class="text-base-content font-mono text-sm">{ item.Flag }</td>
		<td class="text-base-content font-medium">{ item.Name }</td>
		<td class="text-base-content/70 max-w-xs truncate">{ agentSkillDescriptionPreview(item.Description) }</td>
		<td class="text-center">
			@StatusIcon(EnabledStatusIcon(ctx, item.Enabled), "")
		</td>
		<td class="text-base-content/50">{ item.UpdatedAt.Format("2006-01-02 15:04") }</td>
		<td>
			<div class="flex gap-1">
				if item.Enabled {
					<button type="button"
						hx-put={ agentSkillEnabledURL(item) }
						hx-vals='{"enabled": false}'
						data-confirm={ i18n.T(ctx, "confirm.disable_skill.message") }
						data-confirm-title={ i18n.T(ctx, "confirm.disable_skill.title") }
						data-confirm-btn={ i18n.T(ctx, "confirm.disable_skill.btn") }
						data-confirm-class="btn-warning"
						data-testid="agent-skill-disable"
						class="btn btn-ghost btn-xs text-warning">
						{ i18n.T(ctx, "common.disable") }
					</button>
				} else {
					<button type="button"
						hx-put={ agentSkillEnabledURL(item) }
						hx-vals='{"enabled": true}'
						data-testid="agent-skill-enable"
						class="btn btn-ghost btn-xs text-success">
						{ i18n.T(ctx, "common.enable") }
					</button>
				}
				<button hx-get={ agentSkillEditURL(item) }
					data-testid="agent-skill-edit"
					class="btn btn-ghost btn-xs text-primary">
					{ i18n.T(ctx, "common.edit") }
				</button>
				<button hx-delete={ agentSkillURL(item) }
					data-confirm={ i18n.T(ctx, "confirm.delete_skill.message") }
					data-confirm-title={ i18n.T(ctx, "confirm.delete_skill.title") }
					data-confirm-btn={ i18n.T(ctx, "confirm.delete_skill.btn") }
					data-confirm-class="btn-error"
					data-testid="agent-skill-delete"
					class="btn btn-ghost btn-xs text-error">
					{ i18n.T(ctx, "common.delete") }
					@HtmxIndicator()
				</button>
			</div>
		</td>
	</tr>
}
