package partials

import (
	"github.com/flowline-io/flowbot/pkg/i18n"
	"github.com/flowline-io/flowbot/pkg/types/model"
)

templ ConfigTable(items []model.ConfigItem) {
	<div class="flowbot-surface" id="configs-table" data-testid="configs-table">
		<div class="overflow-x-auto">
			<table class="table flowbot-table-pin">
				<thead>
				<tr>
					<th class="text-xs text-base-content/55">{ i18n.T(ctx, "table.col.id") }</th>
					<th class="text-xs text-base-content/55">{ i18n.T(ctx, "table.col.uid") }</th>
					<th class="text-xs text-base-content/55">{ i18n.T(ctx, "common.topic") }</th>
					<th class="text-xs text-base-content/55">{ i18n.T(ctx, "table.col.key") }</th>
					<th class="text-xs text-base-content/55">{ i18n.T(ctx, "table.col.value") }</th>
					<th class="text-xs text-base-content/55">{ i18n.T(ctx, "table.col.updated") }</th>
					<th class="text-xs text-base-content/55">{ i18n.T(ctx, "table.col.actions") }</th>
				</tr>
				</thead>
				<tbody id="configs-rows">
				for _, item := range items {
					@ConfigRow(ctx, item)
				}
				if len(items) == 0 {
					<tr id="configs-empty">
						<td colspan="7" class="p-0">
							@EmptyStateHXCTA(
								i18n.T(ctx, "table.empty.configs"),
								i18n.T(ctx, "table.empty.configs_detail"),
								"/service/web/configs/new",
								"#configs-rows",
								"afterbegin",
								i18n.T(ctx, "table.empty.configs_cta"),
							)
						</td>
					</tr>
				}
				</tbody>
			</table>
		</div>
	</div>
}
