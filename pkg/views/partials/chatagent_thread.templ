package partials

import (
	"context"

	"github.com/flowline-io/flowbot/pkg/i18n"
	"github.com/flowline-io/flowbot/pkg/types/model"
)

templ ChatAgentThread(ctx context.Context, session model.AgentSession, messages []model.AgentChatMessage, todos []model.AgentTodo, endpoints ChatAgentEndpoints, pending *ChatAgentPendingConfirm) {
	<div
		class="chatagent-thread flex flex-col flex-1 min-h-0"
		data-chatagent-root="thread"
		data-session-id={ session.Flag }
		data-messages-url={ endpoints.MessagesURL }
		if endpoints.MediaURL != "" {
			data-media-url={ endpoints.MediaURL }
		}
		data-cancel-url={ endpoints.CancelURL }
		data-close-url={ endpoints.CloseURL }
		data-confirm-url={ endpoints.ConfirmURL }
		data-events-url={ endpoints.EventsURL }
		data-render-markdown-url={ endpoints.RenderMarkdownURL }
		data-context-url={ endpoints.ContextURL }
		if endpoints.TrajectoryURL != "" {
			data-trajectory-url={ endpoints.TrajectoryURL }
		}
		data-default-model={ endpoints.DefaultModel }
		data-session-model={ session.Model }
		data-session-thinking={ session.ThinkingLevel }
		data-session-approval={ chatAgentSelectedApproval(session.ApprovalMode, endpoints.DefaultApprovalMode) }
		if endpoints.SettingsURL != "" {
			data-settings-url={ endpoints.SettingsURL }
		}
		if endpoints.TodosURL != "" {
			data-todos-url={ endpoints.TodosURL }
		}
		if endpoints.SkillsURL != "" {
			data-skills-url={ endpoints.SkillsURL }
		}
		data-testid="chatagent-thread">
		<header class="chatagent-thread-header shrink-0 px-1 mb-3 sm:mb-5" data-testid="chatagent-thread-header">
			<div class="flex items-start gap-2">
				<div class="min-w-0 flex-1">
					if session.Title != "" {
						<h1 class="chatagent-thread-title text-lg sm:text-2xl font-semibold tracking-tight text-base-content" data-testid="chatagent-thread-title">{ session.Title }</h1>
					} else {
						<h1 class="chatagent-thread-title text-lg sm:text-2xl font-semibold tracking-tight font-mono text-base-content" data-testid="chatagent-thread-title">{ session.Flag }</h1>
					}
					<div class="chatagent-thread-meta" data-testid="chatagent-thread-meta">
						if session.Title != "" {
							@chatAgentThreadMetaChip("", "chatagent-thread-session-id", session.Flag, "hidden lg:inline-flex") {
								<svg xmlns="http://www.w3.org/2000/svg" class="chatagent-thread-meta-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<line x1="4" x2="20" y1="9" y2="9"></line>
									<line x1="4" x2="20" y1="15" y2="15"></line>
									<line x1="10" x2="8" y1="3" y2="21"></line>
									<line x1="16" x2="14" y1="3" y2="21"></line>
								</svg>
								<span class="chatagent-thread-meta-id">{ session.Flag }</span>
							}
						}
						if modelName := chatAgentModelLabel(session, endpoints.DefaultModel); modelName != "" {
							@chatAgentThreadMetaChip("chatagent-session-model-label", "chatagent-session-model-label", i18n.T(ctx, "chatagent.settings.model_aria"), "") {
								<svg xmlns="http://www.w3.org/2000/svg" class="chatagent-thread-meta-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<rect width="16" height="16" x="4" y="4" rx="2"></rect>
									<rect width="6" height="6" x="9" y="9"></rect>
									<path d="M9 1v3M15 1v3M9 20v3M15 20v3M20 9h3M20 15h3M1 9h3M1 15h3"></path>
								</svg>
								<span data-chatagent-model-text>{ modelName }</span>
							}
						}
						@chatAgentThreadMetaChip("chatagent-session-thinking-label", "chatagent-session-thinking-label", i18n.T(ctx, "chatagent.settings.thinking_aria"), "") {
							<svg xmlns="http://www.w3.org/2000/svg" class="chatagent-thread-meta-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<path d="m12 3-1.9 5.8a2 2 0 0 1-1.3 1.3L3 12l5.8 1.9a2 2 0 0 1 1.3 1.3L12 21l1.9-5.8a2 2 0 0 1 1.3-1.3L21 12l-5.8-1.9a2 2 0 0 1-1.3-1.3Z"></path>
							</svg>
							<span data-chatagent-thinking-text>{ i18n.T(ctx, chatAgentThinkingI18nKey(session.ThinkingLevel)) }</span>
						}
						@chatAgentThreadMetaChip("", "chatagent-thread-workspace", i18n.T(ctx, "chatagent.settings.workspace_aria"), "") {
							<svg xmlns="http://www.w3.org/2000/svg" class="chatagent-thread-meta-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z"></path>
							</svg>
							<span>{ chatAgentWorkspaceDisplay(session.Workspace, endpoints.WorkspaceRootLabel) }</span>
						}
					</div>
					if endpoints.TrajectoryURL != "" {
						<div class="chatagent-view-toggle mt-2 flex gap-1" data-testid="chatagent-view-toggle" role="tablist" aria-label={ i18n.T(ctx, "chatagent.session_view") }>
							<button
								type="button"
								class="btn btn-ghost btn-xs chatagent-view-btn is-active"
								data-chatagent-view="chat"
								data-testid="chatagent-view-chat"
								aria-selected="true">{ i18n.T(ctx, "chatagent.view.chat") }</button>
							<button
								type="button"
								class="btn btn-ghost btn-xs chatagent-view-btn"
								data-chatagent-view="trajectory"
								data-testid="chatagent-view-trajectory"
								aria-selected="false">{ i18n.T(ctx, "chatagent.view.trajectory") }</button>
						</div>
					}
				</div>
				<div class="hidden lg:flex flex-wrap justify-end gap-1 shrink-0 pt-0.5" data-testid="chatagent-header-actions-desktop">
					if session.State == "Active" && endpoints.CloseURL != "" {
						<button
							type="button"
							id="chatagent-close-session"
							class="btn btn-ghost btn-sm text-error"
							data-chatagent-close
							data-testid="chatagent-close-session">{ i18n.T(ctx, "chatagent.close_session") }</button>
					}
					if endpoints.InspectURL != "" {
						<a href={ templ.URL(endpoints.InspectURL) } class="btn btn-ghost btn-sm" data-testid="chatagent-inspect">{ i18n.T(ctx, "chatagent.inspect_entries") }</a>
					}
					<a href="/service/web/agents" class="btn btn-ghost btn-sm" data-testid="chatagent-back">{ i18n.T(ctx, "common.back_to_agents") }</a>
				</div>
				<div class="flex lg:hidden items-center gap-0.5 shrink-0 pt-0.5">
					if endpoints.ListURL != "" {
						<button
							type="button"
							class="btn btn-ghost btn-sm btn-square"
							aria-label={ i18n.T(ctx, "chatagent.sessions") }
							title={ i18n.T(ctx, "chatagent.sessions") }
							data-testid="chatagent-sessions-open"
							onclick="document.getElementById('chatagent-sessions-drawer').showModal()">
							<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<path d="M8 6h13"></path>
								<path d="M8 12h13"></path>
								<path d="M8 18h13"></path>
								<path d="M3 6h.01"></path>
								<path d="M3 12h.01"></path>
								<path d="M3 18h.01"></path>
							</svg>
						</button>
					}
					<button
						type="button"
						class="btn btn-ghost btn-sm btn-square"
						aria-label={ i18n.T(ctx, "chatagent.session_actions") }
						data-testid="chatagent-header-menu"
						onclick="document.getElementById('chatagent-header-actions-dialog').showModal()">
						<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<circle cx="12" cy="5" r="1"></circle>
							<circle cx="12" cy="12" r="1"></circle>
							<circle cx="12" cy="19" r="1"></circle>
						</svg>
					</button>
				</div>
			</div>
		</header>
		<dialog
			id="chatagent-header-actions-dialog"
			class="modal lg:hidden"
			data-testid="chatagent-header-menu-panel">
			<div class="modal-box max-w-xs p-2">
				<ul class="menu menu-sm w-full p-0">
					if session.State == "Active" && endpoints.CloseURL != "" {
						<li>
							<button
								type="button"
								class="text-error"
								data-chatagent-close
								data-testid="chatagent-close-session-mobile">{ i18n.T(ctx, "chatagent.close_session") }</button>
						</li>
					}
					if endpoints.InspectURL != "" {
						<li>
							<a href={ templ.URL(endpoints.InspectURL) } data-testid="chatagent-inspect-mobile">{ i18n.T(ctx, "chatagent.inspect_entries") }</a>
						</li>
					}
					<li>
						<a href="/service/web/agents" data-testid="chatagent-back-mobile">{ i18n.T(ctx, "common.back_to_agents") }</a>
					</li>
				</ul>
			</div>
			<form method="dialog" class="modal-backdrop">
				<button type="submit">{ i18n.T(ctx, "common.close") }</button>
			</form>
		</dialog>
		if endpoints.ListURL != "" {
			@ChatAgentSessionsDrawer(ctx, endpoints)
		}
		<div
			id="chatagent-status-toast"
			class="chatagent-status-toast hidden shrink-0 mx-1 mb-3 alert py-2 text-sm"
			data-testid="chatagent-status-toast"></div>
		if len(todos) > 0 {
			@ChatAgentTodosPanel(todos)
		}
		<div class="chatagent-messages-wrap relative flex-1 min-h-0 flex flex-col">
			<div id="chatagent-messages" class="flex-1 min-h-0 px-1 pr-1 pb-4" data-testid="chatagent-messages">
				if pending != nil {
					<div class="chatagent-run-waiting text-sm text-base-content/60 px-1 py-2" data-testid="chatagent-run-waiting">
						{ i18n.T(ctx, "chatagent.waiting_approval") }
					</div>
				}
				for _, msg := range messages {
					@ChatAgentMessage(msg, false)
				}
			</div>
			<div id="chatagent-trajectory" class="chatagent-trajectory hidden flex-1 min-h-0 flex flex-col" data-testid="chatagent-trajectory" hidden>
				<div id="chatagent-trajectory-gantt" class="chatagent-trajectory-gantt shrink-0" data-testid="chatagent-trajectory-gantt"></div>
				<div class="chatagent-trajectory-body flex-1 min-h-0 flex">
					<div id="chatagent-trajectory-log" class="chatagent-trajectory-log flex-1 min-h-0 overflow-y-auto" data-testid="chatagent-trajectory-log"></div>
					<aside id="chatagent-trajectory-inspector" class="chatagent-trajectory-inspector hidden" data-testid="chatagent-trajectory-inspector" hidden>
						<div class="chatagent-trajectory-inspector-head">
							<span id="chatagent-trajectory-inspector-title" class="text-sm font-semibold tracking-tight"></span>
							<button type="button" class="btn btn-ghost btn-xs btn-square" data-testid="chatagent-trajectory-inspector-close" aria-label={ i18n.T(ctx, "chatagent.close_inspector") }>&times;</button>
						</div>
						<div class="chatagent-trajectory-inspector-tabs" role="tablist">
							<button type="button" class="chatagent-inspector-tab is-active" data-inspector-tab="preview" data-testid="chatagent-trajectory-tab-preview">{ i18n.T(ctx, "chatagent.inspector.preview") }</button>
							<button type="button" class="chatagent-inspector-tab" data-inspector-tab="raw" data-testid="chatagent-trajectory-tab-raw">{ i18n.T(ctx, "chatagent.inspector.raw") }</button>
						</div>
						<pre id="chatagent-trajectory-inspector-body" class="chatagent-trajectory-inspector-body" data-testid="chatagent-trajectory-inspector-body"></pre>
					</aside>
				</div>
			</div>
			<button
				type="button"
				id="chatagent-jump-bottom"
				class="chatagent-jump-bottom hidden"
				data-testid="chatagent-jump-bottom"
				aria-label={ i18n.T(ctx, "chatagent.jump_to_bottom") }>
				{ i18n.T(ctx, "chatagent.jump_to_bottom") }
			</button>
		</div>
		@ChatAgentApprovalPanel(session.Flag, endpoints, pending)
		<div class="chatagent-input-bar shrink-0 border-t border-base-300 bg-base-100 px-1 pt-3 pb-4" data-testid="chatagent-input-bar">
			<div class="chatagent-input-stack">
				@ChatAgentContextPopover(ctx, endpoints)
				<div class="chatagent-input-wrap">
					<div id="chatagent-pending-attachments" class="chatagent-pending-attachments empty:hidden" data-testid="chatagent-pending-attachments"></div>
					@ChatAgentRichInput(
						"chatagent-followup-input",
						"chatagent-followup-textarea chatagent-rich-input w-full min-h-12 max-h-40 leading-normal",
						i18n.T(ctx, "chatagent.follow_up_placeholder"),
						i18n.T(ctx, "chatagent.follow_up_aria"),
						session.State != "Active",
					)
					<div class="chatagent-input-footer">
						<div class="flex items-center gap-1 min-w-0">
							<input type="file" id="chatagent-media-input" class="hidden" accept="image/jpeg,image/png,image/webp,image/gif,audio/*,video/mp4,video/webm" data-testid="chatagent-media-input" multiple />
							@ChatAgentAttachButton(
								"chatagent-attach-media",
								!chatAgentModelMultimodal(endpoints.SelectableModels, chatAgentSelectedModel(session.Model, endpoints.DefaultModel)),
								false,
							)
							if endpoints.SettingsURL != "" {
								@ChatAgentSettingsCluster(
									"chatagent-thread-model",
									"chatagent-thread-thinking",
									"chatagent-thread-approval",
									endpoints.SelectableModels,
									chatAgentSelectedModel(session.Model, endpoints.DefaultModel),
									session.ThinkingLevel,
									chatAgentSelectedApproval(session.ApprovalMode, endpoints.DefaultApprovalMode),
									false,
								)
							}
						</div>
						<div class="chatagent-input-footer-right">
							@ChatAgentContextRing()
							<button
								type="button"
								id="chatagent-cancel-run"
								class="chatagent-stop-btn hidden"
								aria-label={ i18n.T(ctx, "chatagent.stop") }
								title={ i18n.T(ctx, "chatagent.stop") }
								data-testid="chatagent-cancel-run">
								<span class="chatagent-stop-square" aria-hidden="true"></span>
							</button>
						</div>
					</div>
				</div>
			</div>
			<p class="text-xs text-error hidden mt-2" id="chatagent-thread-error" data-testid="chatagent-thread-error"></p>
		</div>
	</div>
}

templ chatAgentThreadMetaChip(id, testID, title, extraClass string) {
	<span
		class={ chatAgentThreadMetaChipClass(extraClass) }
		if id != "" {
			id={ id }
		}
		data-testid={ testID }
		title={ title }>
		{ children... }
	</span>
}
