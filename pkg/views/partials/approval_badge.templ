package partials

import "github.com/flowline-io/flowbot/pkg/i18n"

templ navBadgeInnerHTML(targetID string) {
	<span hx-swap-oob={ "innerHTML:#" + targetID }>
		{ children... }
	</span>
}

// ApprovalCountBadge renders a compact count chip for pending tool approvals.
// Empty when count is zero so HTMX can clear previous badges.
templ ApprovalCountBadge(count int) {
	if text := FormatPendingApprovalBadgeText(count); text != "" {
		<span
			class="flowbot-chip flowbot-chip-warning ml-1 tabular-nums"
			data-testid="approval-count-badge"
			title={ i18n.TData(ctx, "chatagent.approval.badge_title", map[string]any{"Count": count}) }
			aria-label={ i18n.TData(ctx, "chatagent.approval.badge_aria", map[string]any{"Count": count}) }>
			{ text }
		</span>
	} else {
		<span data-testid="approval-count-badge-empty" aria-hidden="true"></span>
	}
}

// ApprovalCountBadgeNav is the approval-badge HTMX body: the poller swap plus replica OOB.
templ ApprovalCountBadgeNav(count int) {
	@ApprovalCountBadge(count)
	@navBadgeInnerHTML(NavMobileApprovalBadgeID) {
		@ApprovalCountBadge(count)
	}
	@navBadgeInnerHTML(NavAgentsApprovalBadgeID) {
		@ApprovalCountBadge(count)
	}
}
