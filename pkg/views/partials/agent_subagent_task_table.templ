package partials

import (
	"context"

	"github.com/flowline-io/flowbot/pkg/i18n"
	"github.com/flowline-io/flowbot/pkg/types/model"
)

templ AgentSubagentTaskTable(ctx context.Context, items []model.AgentSubagentTask) {
	<div class="flowbot-surface">
		<div id="agent-subagent-tasks-table"
			data-testid="agent-subagent-tasks-table"
			class="overflow-x-auto">
			<table class="table flowbot-table-pin">
				<thead>
				<tr>
					<th class="text-xs text-base-content/55">{ i18n.T(ctx, "table.col.id") }</th>
					<th class="text-xs text-base-content/55">{ i18n.T(ctx, "table.col.subagent") }</th>
					<th class="text-xs text-base-content/55">{ i18n.T(ctx, "table.col.description") }</th>
					<th class="text-xs text-base-content/55">{ i18n.T(ctx, "table.col.session") }</th>
					<th class="text-xs text-base-content/55">{ i18n.T(ctx, "table.col.status") }</th>
					<th class="text-xs text-base-content/55">{ i18n.T(ctx, "table.col.started") }</th>
					<th class="text-xs text-base-content/55">{ i18n.T(ctx, "table.col.duration") }</th>
					<th class="text-xs text-base-content/55">{ i18n.T(ctx, "table.col.actions") }</th>
				</tr>
				</thead>
				<tbody id="agent-subagent-tasks-rows">
				for _, item := range items {
					@AgentSubagentTaskRow(item)
				}
				if len(items) == 0 {
					<tr id="agent-subagent-tasks-empty">
						<td colspan="8" class="p-0">
							@EmptyStateCTA(
								i18n.T(ctx, "table.empty.subagent_tasks"),
								i18n.T(ctx, "table.empty.subagent_tasks_detail"),
								"/service/web/agents",
								i18n.T(ctx, "table.empty.subagent_tasks_cta"),
							)
						</td>
					</tr>
				}
				</tbody>
			</table>
		</div>
	</div>
}
