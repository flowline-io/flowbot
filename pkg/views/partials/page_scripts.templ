package partials

import "github.com/flowline-io/flowbot/version"

// ChartScripts loads Chart.js for dashboard charts.
templ ChartScripts() {
	<script src="/static/vendor/chart.js.min.js" defer></script>
}

// TokenUsageScripts loads home token usage chart helpers.
templ TokenUsageScripts() {
	@ChartScripts()
	<script src="/static/js/token-usage.js" defer></script>
}

// PipelineStatsScripts loads pipeline stats chart helpers.
templ PipelineStatsScripts() {
	@ChartScripts()
	<script src="/static/js/pipeline-stats.js" defer></script>
}

// WorkflowStatsScripts loads workflow stats chart helpers.
templ WorkflowStatsScripts() {
	@ChartScripts()
	<script src="/static/js/workflow-stats.js" defer></script>
}

// LifeRadarScripts loads Chart.js and the Life dashboard radar helper.
templ LifeRadarScripts() {
	@ChartScripts()
	<script src={ "/static/js/life-radar.js?v=" + version.Buildtags } defer></script>
}

// ClipCopyScripts loads clipboard helpers for data-clip-copy buttons.
templ ClipCopyScripts() {
	<script src={ "/static/js/clip-copy.js?v=" + version.Buildtags } defer></script>
}

// ClipCopyIconButton is an icon-only control that copies text via clip-copy.js.
templ ClipCopyIconButton(testID string, text string, title string) {
	<button type="button"
		class="btn btn-ghost btn-xs btn-square shrink-0"
		title={ title }
		aria-label={ title }
		data-clip-copy
		data-clip-markdown={ text }
		data-testid={ testID }>
		<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" class="w-3.5 h-3.5" aria-hidden="true">
			<path d="M5 6.5A1.5 1.5 0 0 1 6.5 5h6A1.5 1.5 0 0 1 14 6.5v6a1.5 1.5 0 0 1-1.5 1.5h-6A1.5 1.5 0 0 1 5 12.5v-6Z"></path>
			<path d="M3.5 2A1.5 1.5 0 0 0 2 3.5v6A1.5 1.5 0 0 0 3.5 11V6.5a3 3 0 0 1 3-3H11A1.5 1.5 0 0 0 9.5 2h-6Z"></path>
		</svg>
	</button>
}

// EventFilterScripts loads event timeline filter controls and clip-copy for payloads.
// event-filters.js is loaded synchronously (no defer) so Alpine.data registers before alpine:init.
templ EventFilterScripts() {
	@ClipCopyScripts()
	<script src={ "/static/js/event-filters.js?v=" + version.Buildtags }></script>
}

// HomelabRegistryScripts loads homelab registry interactions.
// Loaded synchronously (no defer) so Alpine.data registers before alpine:init.
templ HomelabRegistryScripts() {
	<script src="/static/js/homelab-registry.js"></script>
}

// TableFilterScripts loads shared client-side table filter controls.
// Loaded synchronously (no defer) so Alpine.data registers before alpine:init.
templ TableFilterScripts() {
	<script src="/static/js/table-filter.js"></script>
}
