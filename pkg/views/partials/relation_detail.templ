package partials

import (
	"context"
	"time"

	"github.com/flowline-io/flowbot/pkg/i18n"
	"github.com/flowline-io/flowbot/pkg/types"
)

type RelationDetailParams struct {
	Type string // "node" or "edge"
	Node    types.ResourceRef
	Edge    types.ResourceEdge
}

templ RelationDetail(ctx context.Context, p RelationDetailParams) {
	<div class="flowbot-surface sticky top-4">
		<div class="card-body p-4">
			if p.Type == "node" {
				<h3 class="text-sm font-semibold tracking-tight m-0">{ i18n.T(ctx, "relations.detail.resource_node") }</h3>
				<div class="mt-2 space-y-1 text-sm">
					<div><span class="font-medium">{ i18n.T(ctx, "relations.detail.capability") }</span> { p.Node.Capability }</div>
					<div><span class="font-medium">{ i18n.T(ctx, "relations.detail.app") }</span> { p.Node.App }</div>
					<div><span class="font-medium">{ i18n.T(ctx, "relations.detail.entity_id") }</span> <code class="text-xs">{ p.Node.EntityID }</code></div>
				</div>
			} else if p.Type == "edge" {
				<h3 class="text-sm font-semibold tracking-tight m-0">{ i18n.T(ctx, "relations.detail.relation_edge") }</h3>
				<div class="mt-2 space-y-1 text-sm">
					<div><span class="font-medium">{ i18n.T(ctx, "relations.detail.pipeline") }</span> { p.Edge.PipelineName }</div>
					<div><span class="font-medium">{ i18n.T(ctx, "relations.detail.source") }</span> { p.Edge.SourceCapability } #{ p.Edge.SourceEntityID } ({ p.Edge.SourceApp })</div>
					<div><span class="font-medium">{ i18n.T(ctx, "relations.detail.target") }</span> { p.Edge.TargetCapability } #{ p.Edge.TargetEntityID } ({ p.Edge.TargetApp })</div>
					<div><span class="font-medium">{ i18n.T(ctx, "relations.detail.created") }</span> { p.Edge.CreatedAt.Format(time.RFC3339) }</div>
				</div>
			}
		</div>
	</div>
}
