package partials

import (
	"context"

	"github.com/flowline-io/flowbot/pkg/i18n"
	"github.com/flowline-io/flowbot/pkg/types/model"
)

templ NotifyTemplatesTable(ctx context.Context, templates []model.NotifyTemplate) {
	<div id="notify-templates-table"
		data-testid="notify-templates-table"
		class="flowbot-surface">
		<div class="overflow-x-auto">
			<table class="table flowbot-table-pin">
				<thead>
				<tr>
					<th class="text-xs font-medium text-base-content/55">{ i18n.T(ctx, "table.col.id") }</th>
					<th class="text-xs font-medium text-base-content/55">{ i18n.T(ctx, "table.col.name") }</th>
					<th class="text-xs font-medium text-base-content/55">{ i18n.T(ctx, "common.format") }</th>
					<th class="text-xs font-medium text-base-content/55">{ i18n.T(ctx, "common.overrides") }</th>
					<th class="text-xs font-medium text-base-content/55 text-center">{ i18n.T(ctx, "common.default") }</th>
					<th class="text-xs font-medium text-base-content/55">{ i18n.T(ctx, "table.col.actions") }</th>
				</tr>
				</thead>
				<tbody id="notify-templates-rows">
				for _, tmpl := range templates {
					@NotifyTemplateRow(ctx, tmpl)
				}
				if len(templates) == 0 {
					<tr id="notify-templates-empty" data-testid="notify-templates-empty">
						<td colspan="6" class="p-0">
							@EmptyStateHXCTA(
								i18n.T(ctx, "notify.empty.templates_title"),
								i18n.T(ctx, "notify.empty.templates_detail"),
								"/service/web/notifications/templates/new",
								"#notify-templates-rows",
								"afterbegin",
								i18n.T(ctx, "common.create_template"),
							)
						</td>
					</tr>
				}
				</tbody>
			</table>
		</div>
	</div>
}
