package partials

import (
	"context"

	"github.com/flowline-io/flowbot/pkg/i18n"
	"github.com/flowline-io/flowbot/pkg/types/model"
)

templ AgentSubagentRow(ctx context.Context, item model.AgentSubagent) {
	<tr id={ agentSubagentRowID(item) } hx-target="this" hx-swap="outerHTML" class="hover">
		<td class="text-base-content font-mono text-sm" data-label={ i18n.T(ctx, "common.flag") }>{ item.Flag }</td>
		<td class="text-base-content font-medium" data-label={ i18n.T(ctx, "table.col.name") }>{ item.Name }</td>
		<td class="text-base-content/70 max-w-xs truncate" data-label={ i18n.T(ctx, "table.col.description") }>{ agentSubagentDescriptionPreview(item.Description) }</td>
		<td class="text-base-content/70 font-mono text-sm" data-label={ i18n.T(ctx, "table.col.model") }>{ agentSubagentModelLabel(item.Model) }</td>
		<td class="text-center" data-label={ i18n.T(ctx, "table.col.enabled") }>
			@StatusIcon(EnabledStatusIcon(ctx, item.Enabled), "")
		</td>
		<td class="text-base-content/50" data-label={ i18n.T(ctx, "table.col.updated") }>{ item.UpdatedAt.Format("2006-01-02 15:04") }</td>
		<td data-label={ i18n.T(ctx, "table.col.actions") }>
			<div class="flex gap-1">
				<button hx-get={ agentSubagentEditURL(item) }
					data-testid="agent-subagent-edit"
					class="btn btn-ghost btn-xs text-primary">
					{ i18n.T(ctx, "common.edit") }
				</button>
				<button hx-delete={ agentSubagentURL(item) }
					data-confirm={ i18n.T(ctx, "confirm.delete_subagent.message") }
					data-confirm-title={ i18n.T(ctx, "confirm.delete_subagent.title") }
					data-confirm-btn={ i18n.T(ctx, "confirm.delete_subagent.btn") }
					data-confirm-class="btn-error"
					data-testid="agent-subagent-delete"
					class="btn btn-ghost btn-xs text-error">
					{ i18n.T(ctx, "common.delete") }
					@HtmxIndicator()
				</button>
			</div>
		</td>
	</tr>
}
