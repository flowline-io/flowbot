package partials

import (
	"github.com/flowline-io/flowbot/pkg/i18n"
	"github.com/flowline-io/flowbot/pkg/types/model"
)

templ AgentSkillTable(items []model.AgentSkill) {
	<div class="flowbot-surface" id="agent-skills-table" data-testid="agent-skills-table">
		<div class="overflow-x-auto">
			<table class="table flowbot-table-pin">
				<thead>
				<tr>
					<th class="text-xs text-base-content/55">{ i18n.T(ctx, "common.flag") }</th>
					<th class="text-xs text-base-content/55">{ i18n.T(ctx, "table.col.name") }</th>
					<th class="text-xs text-base-content/55">{ i18n.T(ctx, "table.col.description") }</th>
					<th class="text-xs text-base-content/55 text-center">{ i18n.T(ctx, "table.col.enabled") }</th>
					<th class="text-xs text-base-content/55">{ i18n.T(ctx, "table.col.updated") }</th>
					<th class="text-xs text-base-content/55">{ i18n.T(ctx, "table.col.actions") }</th>
				</tr>
				</thead>
				<tbody id="agent-skills-rows">
				for _, item := range items {
					@AgentSkillRow(ctx, item)
				}
				if len(items) == 0 {
					<tr id="agent-skills-empty">
						<td colspan="6" class="p-0">
							@EmptyStateHXCTA(
								i18n.T(ctx, "table.empty.agent_skills"),
								i18n.T(ctx, "table.empty.agent_skills_detail"),
								"/service/web/agent-skills/new",
								"#agent-skills-rows",
								"afterbegin",
								i18n.T(ctx, "table.empty.agent_skills_cta"),
							)
						</td>
					</tr>
				}
				</tbody>
			</table>
		</div>
	</div>
}
