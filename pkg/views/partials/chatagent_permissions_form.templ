package partials

import (
	"context"
	"strconv"

	"github.com/flowline-io/flowbot/pkg/i18n"
)

templ permissionPatternRow(ctx context.Context, key string, idx int, row PermissionPatternRow, errors map[string]string) {
	<div class="pattern-row flex flex-wrap items-start gap-2">
		<input
			type="text"
			name={ "perm[" + key + "][patterns][" + strconv.Itoa(idx) + "][pattern]" }
			value={ row.Pattern }
			data-testid={ "perm-" + key + "-pattern-" + strconv.Itoa(idx) }
			class={ "input input-bordered input-sm font-mono flex-1 min-w-[12rem] " + PermissionPatternErrorClass(errors, key, idx) }
			placeholder="git *"
		/>
		<select
			name={ "perm[" + key + "][patterns][" + strconv.Itoa(idx) + "][action]" }
			data-testid={ "perm-" + key + "-action-" + strconv.Itoa(idx) }
			class={ "select select-bordered select-sm w-28 " + PermissionPatternActionErrorClass(errors, key, idx) }
		>
			<option value="ask" if row.Action == "ask" || row.Action == "" { selected }>{ PermissionActionLabel(ctx, "ask") }</option>
			<option value="allow" if row.Action == "allow" { selected }>{ PermissionActionLabel(ctx, "allow") }</option>
			<option value="deny" if row.Action == "deny" { selected }>{ PermissionActionLabel(ctx, "deny") }</option>
		</select>
		<button type="button" class="btn btn-ghost btn-sm pattern-row-remove" data-testid={ "perm-" + key + "-remove-" + strconv.Itoa(idx) }>{ i18n.T(ctx, "common.remove") }</button>
		<div class="text-error text-xs w-full">{ PermissionPatternError(errors, key, idx) }</div>
		<div class="text-error text-xs w-full">{ PermissionPatternActionError(errors, key, idx) }</div>
	</div>
}

templ ChatAgentPermissionsForm(ctx context.Context, data PermissionFormPageData) {
	<form method="post" action="/service/web/chatagent-permissions" class="space-y-6" data-testid="chatagent-permissions-form">
		<input type="hidden" name="submit_mode" id="chatagent-permissions-submit-mode" value="form"/>

		<div class="alert alert-info text-sm">
			<span>{ i18n.T(ctx, "permissions.form_hint") }</span>
		</div>

		<div class="space-y-2">
			<h2 class="text-lg font-semibold">{ i18n.T(ctx, "permissions.approval_mode.title") }</h2>
			<p class="text-sm text-base-content/70">
				{ i18n.TData(ctx, "permissions.approval_mode.hint", map[string]any{"Default": data.ApprovalServerDef}) }
			</p>
			<select
				name="approval_mode"
				class="select select-bordered select-sm w-full max-w-xs"
				data-testid="chatagent-approval-mode"
			>
				<option value="manual" if data.ApprovalMode == "manual" || data.ApprovalMode == "" { selected }>{ PermissionApprovalModeLabel(ctx, "manual") }</option>
				<option value="auto" if data.ApprovalMode == "auto" { selected }>{ PermissionApprovalModeLabel(ctx, "auto") }</option>
				<option value="off" if data.ApprovalMode == "off" { selected }>{ PermissionApprovalModeLabel(ctx, "off") }</option>
			</select>
		</div>

		<div class="space-y-3" data-testid="chatagent-server-defaults">
			<div class="flex flex-wrap items-center gap-2">
				<h2 class="text-lg font-semibold">{ i18n.T(ctx, "permissions.server_defaults.title") }</h2>
				if data.ServerDefaults.ChatModelOverridden || data.ServerDefaults.ToolModelOverridden || data.ServerDefaults.ThinkingOverridden {
					<span class="flowbot-chip flowbot-chip-warning">{ i18n.T(ctx, "common.overridden") }</span>
				}
			</div>
			<p class="text-sm text-base-content/70">{ i18n.T(ctx, "permissions.server_defaults.hint") }</p>
			<div class="grid gap-4 md:grid-cols-1 max-w-xl">
				<div class="space-y-1">
					<label class="text-sm font-medium" for="server-chat-model">{ i18n.T(ctx, "permissions.server_defaults.chat_model") }</label>
					<select
						id="server-chat-model"
						name="server_chat_model"
						class="select select-bordered select-sm w-full"
						data-testid="server-chat-model"
					>
						<option
							value={ data.ServerDefaults.InheritValue }
							if data.ServerDefaults.SelectedChatModel == data.ServerDefaults.InheritValue { selected }
						>{ ServerDefaultInheritLabel(ctx, data.ServerDefaults.YAMLChatModel) }</option>
						for _, m := range data.ServerDefaults.SelectableModels {
							if data.ServerDefaults.SelectedChatModel == m.ID {
								<option value={ m.ID } selected>{ m.Name }</option>
							} else {
								<option value={ m.ID }>{ m.Name }</option>
							}
						}
					</select>
				</div>
				<div class="space-y-1">
					<label class="text-sm font-medium" for="server-tool-model">{ i18n.T(ctx, "permissions.server_defaults.tool_model") }</label>
					<select
						id="server-tool-model"
						name="server_tool_model"
						class="select select-bordered select-sm w-full"
						data-testid="server-tool-model"
					>
						<option
							value={ data.ServerDefaults.InheritValue }
							if data.ServerDefaults.SelectedToolModel == data.ServerDefaults.InheritValue { selected }
						>{ ServerDefaultToolInheritLabel(ctx, data.ServerDefaults.YAMLToolModel) }</option>
						<option
							value={ data.ServerDefaults.ToolNoneValue }
							if data.ServerDefaults.SelectedToolModel == data.ServerDefaults.ToolNoneValue { selected }
						>{ i18n.T(ctx, "permissions.server_defaults.tool_none") }</option>
						for _, m := range data.ServerDefaults.SelectableModels {
							if data.ServerDefaults.SelectedToolModel == m.ID {
								<option value={ m.ID } selected>{ m.Name }</option>
							} else {
								<option value={ m.ID }>{ m.Name }</option>
							}
						}
					</select>
				</div>
				<div class="space-y-1">
					<label class="text-sm font-medium" for="server-thinking-level">{ i18n.T(ctx, "permissions.server_defaults.thinking_level") }</label>
					<select
						id="server-thinking-level"
						name="server_thinking_level"
						class="select select-bordered select-sm w-full"
						data-testid="server-thinking-level"
					>
						<option
							value={ data.ServerDefaults.InheritValue }
							if data.ServerDefaults.SelectedThinkingLevel == data.ServerDefaults.InheritValue { selected }
						>{ ServerDefaultThinkingInheritLabel(ctx) }</option>
						@serverDefaultThinkingOption("default", i18n.T(ctx, "chatagent.settings.thinking.default"), data.ServerDefaults.SelectedThinkingLevel)
						@serverDefaultThinkingOption("off", i18n.T(ctx, "chatagent.settings.thinking.off"), data.ServerDefaults.SelectedThinkingLevel)
						@serverDefaultThinkingOption("low", i18n.T(ctx, "chatagent.settings.thinking.low"), data.ServerDefaults.SelectedThinkingLevel)
						@serverDefaultThinkingOption("medium", i18n.T(ctx, "chatagent.settings.thinking.medium"), data.ServerDefaults.SelectedThinkingLevel)
						@serverDefaultThinkingOption("high", i18n.T(ctx, "chatagent.settings.thinking.high"), data.ServerDefaults.SelectedThinkingLevel)
					</select>
				</div>
			</div>
			<button
				type="submit"
				formmethod="post"
				formaction="/service/web/chatagent-permissions/reset-server-defaults"
				class="btn btn-ghost btn-sm"
				data-testid="chatagent-server-defaults-reset"
				data-confirm={ i18n.T(ctx, "confirm.reset_server_defaults.message") }
				data-confirm-title={ i18n.T(ctx, "confirm.reset_server_defaults.title") }
				data-confirm-btn={ i18n.T(ctx, "confirm.reset_server_defaults.btn") }
				data-confirm-class="btn-warning"
			>
				{ i18n.T(ctx, "permissions.server_defaults.reset") }
			</button>
		</div>

		<div class="space-y-4">
			<h2 class="text-lg font-semibold">{ i18n.T(ctx, "permissions.general.title") }</h2>
			<div class="overflow-x-auto">
				<table class="table table-sm">
					<thead>
						<tr>
							<th>{ i18n.T(ctx, "common.permission") }</th>
							<th>{ i18n.T(ctx, "common.default") }</th>
							<th>{ i18n.T(ctx, "common.your_setting") }</th>
						</tr>
					</thead>
					<tbody>
						for _, field := range data.Fields {
							if !field.Meta.SupportsPatterns {
								<tr data-testid={ "perm-row-" + field.Meta.Key }>
									<td>
										<div class="font-medium">{ field.Meta.Label }</div>
										<div class="text-xs text-base-content/60">{ field.Meta.Description }</div>
										if field.IsOverridden {
											<span class="flowbot-chip flowbot-chip-warning mt-1">{ i18n.T(ctx, "common.overridden") }</span>
										}
									</td>
									<td>
										<span class="font-mono text-xs">{ field.DefaultSummary }</span>
									</td>
									<td>
										<select
											name={ "perm[" + field.Meta.Key + "]" }
											data-testid={ "perm-" + field.Meta.Key + "-action" }
											class={ "select select-bordered select-sm w-full max-w-xs " + fieldError(data.Errors, "perm."+field.Meta.Key) }
										>
											<option value="inherit" if field.SelectedAction == "inherit" { selected }>{ i18n.T(ctx, "common.inherit_default") }</option>
											<option value="ask" if field.SelectedAction == "ask" { selected }>{ PermissionActionLabel(ctx, "ask") }</option>
											if !field.Meta.DisallowAllow {
												<option value="allow" if field.SelectedAction == "allow" { selected }>{ PermissionActionLabel(ctx, "allow") }</option>
											}
											<option value="deny" if field.SelectedAction == "deny" { selected }>{ PermissionActionLabel(ctx, "deny") }</option>
										</select>
										<div class="text-error text-xs">{ PermissionFieldError(data.Errors, field.Meta.Key) }</div>
									</td>
								</tr>
							}
						}
					</tbody>
				</table>
			</div>
		</div>

		<div class="space-y-4">
			<h2 class="text-lg font-semibold">{ i18n.T(ctx, "permissions.pattern.title") }</h2>
			<p class="text-sm text-base-content/70">
				{ i18n.T(ctx, "permissions.pattern.hint") }
			</p>
			for _, field := range data.Fields {
				if field.Meta.SupportsPatterns {
					<div class="flowbot-surface bg-base-200/40" data-testid={ "perm-pattern-" + field.Meta.Key }>
						<div class="p-4 space-y-3">
							<div class="flex flex-wrap items-center gap-2">
								<h3 class="font-medium">{ field.Meta.Label }</h3>
								if field.IsOverridden {
									<span class="flowbot-chip flowbot-chip-warning">{ i18n.T(ctx, "common.overridden") }</span>
								} else {
									<span class="flowbot-chip flowbot-chip-muted">{ i18n.T(ctx, "common.inheriting_default") }</span>
								}
							</div>
							<p class="text-xs text-base-content/60">{ field.Meta.Description }</p>
							<p class="text-xs"><span class="font-medium">{ i18n.T(ctx, "common.default") }:</span> <span class="font-mono">{ field.DefaultSummary }</span></p>

							<div
								id={ "perm-patterns-" + field.Meta.Key }
								class="space-y-2 pattern-rows"
								data-perm-key={ field.Meta.Key }
								data-next-index={ strconv.Itoa(len(field.PatternRows)) }
							>
								for idx, row := range field.PatternRows {
									@permissionPatternRow(ctx, field.Meta.Key, idx, row, data.Errors)
								}
							</div>
							<button type="button" class="btn btn-ghost btn-sm pattern-row-add" data-perm-key={ field.Meta.Key } data-testid={ "perm-" + field.Meta.Key + "-add" }>
								{ i18n.T(ctx, "permissions.pattern.add") }
							</button>
						</div>
					</div>
				}
			}
		</div>

		<div class="space-y-2">
			<h2 class="text-lg font-semibold">{ i18n.T(ctx, "permissions.wildcard.title") }</h2>
			<p class="text-sm text-base-content/70">
				{ i18n.T(ctx, "permissions.wildcard.hint") }
			</p>
		</div>

		<details class="collapse collapse-arrow bg-base-200/40 border border-base-300">
			<summary class="collapse-title font-medium">{ i18n.T(ctx, "common.advanced_json") }</summary>
			<div class="collapse-content space-y-2">
				<p class="text-xs text-base-content/60">{ i18n.T(ctx, "permissions.advanced_json_hint") }</p>
				<textarea
					name="rules"
					class={ "textarea textarea-bordered font-mono text-xs w-full h-48 " + fieldError(data.Errors, "rules") }
					data-testid="chatagent-permissions-json"
				>{ data.UserJSON }</textarea>
				<div class="text-error text-xs">{ data.Errors["rules"] }</div>
				<button
					type="submit"
					class="btn btn-outline btn-sm"
					data-testid="chatagent-permissions-save-json"
					onclick="document.getElementById('chatagent-permissions-submit-mode').value='json'"
				>
					{ i18n.T(ctx, "common.save_json") }
				</button>
			</div>
		</details>

		<div class="flex gap-2 pt-2">
			<button
				type="submit"
				class="btn btn-primary btn-sm"
				data-testid="chatagent-permissions-save"
				onclick="document.getElementById('chatagent-permissions-submit-mode').value='form'"
			>
				{ i18n.T(ctx, "common.save") }
			</button>
			<button type="submit" formaction="/service/web/chatagent-permissions/reset" class="btn btn-ghost btn-sm" data-testid="chatagent-permissions-reset">
				{ i18n.T(ctx, "common.reset_to_defaults") }
			</button>
		</div>
	</form>
}

templ serverDefaultThinkingOption(value, label, selected string) {
	if selected == value {
		<option value={ value } selected>{ label }</option>
	} else {
		<option value={ value }>{ label }</option>
	}
}
