package partials

import "github.com/flowline-io/flowbot/pkg/types/model"

templ ChatAgentToolMessage(msg model.AgentChatMessage) {
	<div class="chat chat-start" data-role="tool" data-testid="chatagent-message-tool">
		<details
			class="chatagent-tool chatagent-step"
			data-testid="chatagent-tool-details"
			if msg.ToolStatus != "" {
				data-tool-status={ msg.ToolStatus }
			}
			if ChatAgentToolCardExpanded(msg.ToolStatus) {
				open
			}
		>
			<summary class="chatagent-tool-summary chatagent-step-summary cursor-pointer select-none list-none">
				@chatAgentToolIcon()
				<span class="chatagent-step-label font-mono" data-testid="chatagent-tool-name">{ msg.ToolName }</span>
				if preview := ChatAgentToolPreview(msg); preview != "" {
					<span class="chatagent-step-dot" aria-hidden="true">·</span>
					<span class="chatagent-step-preview" data-testid="chatagent-step-preview">{ preview }</span>
				}
				if msg.DurationMs > 0 {
					<span class="chatagent-duration text-xs text-base-content/50" data-testid="chatagent-duration">{ ChatAgentDurationLabel(msg.DurationMs) }</span>
				}
			</summary>
			<div class="chatagent-tool-body">
				if msg.ToolStdout != "" {
					<pre class="chatagent-tool-output" data-testid="chatagent-tool-stdout">{ msg.ToolStdout }</pre>
				}
				if msg.ToolStderr != "" {
					<pre class="chatagent-tool-output chatagent-tool-stderr" data-testid="chatagent-tool-stderr">{ msg.ToolStderr }</pre>
				}
				if msg.Text != "" && msg.ToolStdout == "" && msg.ToolStderr == "" {
					<p class="mt-1 text-xs text-base-content/70 font-mono">{ msg.Text }</p>
				}
			</div>
		</details>
	</div>
}
