package partials

import "fmt"

templ FunctionListTable(entries []FunctionListEntry) {
	if len(entries) == 0 {
		<div class="text-center py-12" data-testid="function-empty">
			@EmptyStateOnClickCTA(
				"No functions yet",
				"Create a named function to transform data in a sandbox.",
				"document.getElementById('create-modal').showModal()",
				"Create function",
			)
		</div>
	} else {
		<div class="flowbot-surface" data-testid="function-table">
			<div class="overflow-x-auto">
				<table class="table w-full">
					<thead>
						<tr>
							<th>Name</th>
							<th class="w-28">Status</th>
							<th class="w-28">Published</th>
							<th class="w-40 text-right">Actions</th>
						</tr>
					</thead>
					<tbody>
						for _, entry := range entries {
							<tr class="hover" data-testid={ "function-row-" + entry.Name }>
								<td class="font-medium min-w-0">
									<a href={ templ.URL(FunctionWebPath(entry.Name)) } class="link link-hover truncate block" data-testid={ "function-link-" + entry.Name }>{ entry.Name }</a>
									if entry.HasUnpublishedChanges {
										<span class="flowbot-chip flowbot-chip-warning mt-1">Unpublished changes</span>
									}
								</td>
								<td>
									if entry.Status == "published" {
										<span class="flowbot-chip flowbot-chip-success">Published</span>
									} else {
										<span class="flowbot-chip flowbot-chip-muted">Draft</span>
									}
								</td>
								<td class="tabular-nums text-sm">
									if entry.PublishedVersion != nil {
										{ fmt.Sprintf("v%d", *entry.PublishedVersion) }
									} else {
										<span class="text-base-content/30">—</span>
									}
								</td>
								<td class="text-right">
									<a href={ templ.URL(FunctionWebPath(entry.Name)) } class="btn btn-ghost btn-sm" data-testid={ "btn-open-function-" + entry.Name }>Open</a>
									<button
										type="button"
										class="btn btn-ghost btn-sm text-error"
										hx-delete={ "/service/web/functions/" + entry.Name }
										hx-target="body"
										data-confirm={ "Delete function " + entry.Name + "?" }
										data-testid={ "btn-delete-function-" + entry.Name }
									>Delete</button>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		</div>
	}
}
