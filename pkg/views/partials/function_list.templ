package partials

import (
	"context"
	"fmt"

	"github.com/flowline-io/flowbot/pkg/i18n"
)

templ FunctionListTable(ctx context.Context, entries []FunctionListEntry) {
	if len(entries) == 0 {
		<div class="text-center py-12" data-testid="function-empty">
			@EmptyStateOnClickCTA(
				i18n.T(ctx, "table.empty.functions"),
				i18n.T(ctx, "table.empty.functions_detail"),
				"document.getElementById('create-modal').showModal()",
				i18n.T(ctx, "table.empty.functions_cta"),
			)
		</div>
	} else {
		<div class="flowbot-surface" data-testid="function-table">
			<div class="overflow-x-auto">
				<table class="table w-full">
					<thead>
						<tr>
							<th>{ i18n.T(ctx, "table.col.name") }</th>
							<th class="w-28">{ i18n.T(ctx, "table.col.status") }</th>
							<th class="w-28">{ i18n.T(ctx, "table.col.published") }</th>
							<th class="w-40 text-right">{ i18n.T(ctx, "table.col.actions") }</th>
						</tr>
					</thead>
					<tbody>
						for _, entry := range entries {
							<tr class="hover" data-testid={ "function-row-" + entry.Name }>
								<td class="font-medium min-w-0">
									<a href={ templ.URL(FunctionWebPath(entry.Name)) } class="link link-hover truncate block" data-testid={ "function-link-" + entry.Name }>{ entry.Name }</a>
									if entry.HasUnpublishedChanges {
										<span class="flowbot-chip flowbot-chip-warning mt-1">{ i18n.T(ctx, "table.chip.unpublished") }</span>
									}
								</td>
								<td>
									if entry.Status == "published" {
										<span class="flowbot-chip flowbot-chip-success">{ i18n.T(ctx, "table.chip.published") }</span>
									} else {
										<span class="flowbot-chip flowbot-chip-muted">{ i18n.T(ctx, "table.chip.draft") }</span>
									}
								</td>
								<td class="tabular-nums text-sm">
									if entry.PublishedVersion != nil {
										{ fmt.Sprintf("v%d", *entry.PublishedVersion) }
									} else {
										<span class="text-base-content/30">—</span>
									}
								</td>
								<td class="text-right">
									<a href={ templ.URL(FunctionWebPath(entry.Name)) } class="btn btn-ghost btn-sm" data-testid={ "btn-open-function-" + entry.Name }>{ i18n.T(ctx, "common.open") }</a>
									<button
										type="button"
										class="btn btn-ghost btn-sm text-error"
										hx-delete={ "/service/web/functions/" + entry.Name }
										hx-target="body"
										data-confirm={ i18n.TData(ctx, "confirm.delete_function.message", map[string]any{"Name": entry.Name}) }
										data-confirm-title={ i18n.T(ctx, "confirm.delete_function.title") }
										data-confirm-btn={ i18n.T(ctx, "confirm.delete_function.btn") }
										data-testid={ "btn-delete-function-" + entry.Name }
									>{ i18n.T(ctx, "common.delete") }</button>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		</div>
	}
}
