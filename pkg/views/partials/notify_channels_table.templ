package partials

import (
	"context"

	"github.com/flowline-io/flowbot/pkg/i18n"
	"github.com/flowline-io/flowbot/pkg/types/model"
)

templ NotifyChannelsTable(ctx context.Context, channels []model.NotifyChannel, highlight string) {
	<div id="notify-channels-table"
		data-testid="notify-channels-table"
		class="flowbot-surface">
		<div class="overflow-x-auto">
			<table class="table flowbot-table-pin flowbot-table-cards">
				<thead>
				<tr>
					<th class="text-xs font-medium text-base-content/55">{ i18n.T(ctx, "table.col.name") }</th>
					<th class="text-xs font-medium text-base-content/55">{ i18n.T(ctx, "common.protocol") }</th>
					<th class="text-xs font-medium text-base-content/55">{ i18n.T(ctx, "common.uri") }</th>
					<th class="text-xs font-medium text-base-content/55 text-center">{ i18n.T(ctx, "table.col.status") }</th>
					<th class="text-xs font-medium text-base-content/55 text-center">{ i18n.T(ctx, "common.default") }</th>
					<th class="text-xs font-medium text-base-content/55">{ i18n.T(ctx, "table.col.actions") }</th>
				</tr>
				</thead>
				<tbody id="notify-channels-rows">
				for _, ch := range channels {
					@NotifyChannelRow(ctx, ch, highlight == ch.Name)
				}
				if len(channels) == 0 {
					<tr id="notify-channels-empty">
						<td colspan="6" class="p-0">
							@EmptyStateHXCTA(
								i18n.T(ctx, "notify.empty.channels_title"),
								i18n.T(ctx, "notify.empty.channels_detail"),
								"/service/web/notifications/channels/new",
								"#notify-channels-rows",
								"afterbegin",
								i18n.T(ctx, "common.create_channel"),
							)
						</td>
					</tr>
				}
				</tbody>
			</table>
		</div>
	</div>
}
