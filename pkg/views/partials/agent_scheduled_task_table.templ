package partials

import (
	"github.com/flowline-io/flowbot/pkg/i18n"
	"github.com/flowline-io/flowbot/pkg/types/model"
)

templ AgentScheduledTaskTable(items []model.AgentScheduledTask) {
	<div class="flowbot-surface" id="agent-scheduled-tasks-table" data-testid="agent-scheduled-tasks-table">
		<div class="overflow-x-auto">
			<table class="table flowbot-table-pin">
				<thead>
					<tr>
						<th class="text-xs text-base-content/55">{ i18n.T(ctx, "table.col.name") }</th>
						<th class="text-xs text-base-content/55">{ i18n.T(ctx, "table.col.task_id") }</th>
						<th class="text-xs text-base-content/55">{ i18n.T(ctx, "table.col.kind") }</th>
						<th class="text-xs text-base-content/55">{ i18n.T(ctx, "table.col.schedule") }</th>
						<th class="text-xs text-base-content/55 text-center">{ i18n.T(ctx, "table.col.state") }</th>
						<th class="text-xs text-base-content/55">{ i18n.T(ctx, "table.col.next_run") }</th>
						<th class="text-xs text-base-content/55">{ i18n.T(ctx, "table.col.last_run") }</th>
						<th class="text-xs text-base-content/55">{ i18n.T(ctx, "table.col.updated") }</th>
					</tr>
				</thead>
				<tbody id="agent-scheduled-tasks-rows">
					for _, item := range items {
						@AgentScheduledTaskRow(ctx, item)
					}
					if len(items) == 0 {
						<tr id="agent-scheduled-tasks-empty">
							<td colspan="8" class="p-0">
								@EmptyStateCTA(
									i18n.T(ctx, "table.empty.scheduled_tasks"),
									i18n.T(ctx, "table.empty.scheduled_tasks_detail"),
									"/service/web/agents",
									i18n.T(ctx, "table.empty.scheduled_tasks_cta"),
								)
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</div>
}
