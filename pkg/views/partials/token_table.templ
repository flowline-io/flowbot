package partials

import (
	"context"

	"github.com/flowline-io/flowbot/pkg/i18n"
	"github.com/flowline-io/flowbot/pkg/types/model"
)

templ TokenTable(ctx context.Context, items []model.TokenItem) {
	<div class="flowbot-surface" x-data="tableFilter">
		@TableFilterBar(i18n.T(ctx, "table.search_tokens"), "token-table-filter")
		<div id="tokens-table" data-testid="token-table" class="overflow-x-auto">
			<table class="table flowbot-table-pin">
				<thead>
				<tr>
					<th class="text-xs font-medium text-base-content/55">{ i18n.T(ctx, "table.col.uid") }</th>
					<th class="text-xs font-medium text-base-content/55">{ i18n.T(ctx, "table.col.token") }</th>
					<th class="text-xs font-medium text-base-content/55">{ i18n.T(ctx, "table.col.created") }</th>
					<th class="text-xs font-medium text-base-content/55">{ i18n.T(ctx, "table.col.last_used") }</th>
					<th class="text-xs font-medium text-base-content/55">{ i18n.T(ctx, "table.col.expires") }</th>
					<th class="text-xs font-medium text-base-content/55">{ i18n.T(ctx, "table.col.scopes") }</th>
					<th class="text-xs font-medium text-base-content/55">{ i18n.T(ctx, "table.col.actions") }</th>
				</tr>
				</thead>
				<tbody id="tokens-rows">
				for _, item := range items {
					@TokenRow(ctx, item)
				}
				if len(items) == 0 {
					<tr id="tokens-empty">
						<td colspan="7" class="p-0">
							@EmptyStateHXCTA(
								i18n.T(ctx, "table.empty.tokens"),
								i18n.T(ctx, "table.empty.tokens_detail"),
								"/service/web/tokens/new",
								"#tokens-rows",
								"afterbegin",
								i18n.T(ctx, "table.empty.tokens_cta"),
							)
						</td>
					</tr>
				}
				</tbody>
			</table>
		</div>
	</div>
}
