package partials

import (
	"context"

	"github.com/flowline-io/flowbot/pkg/i18n"
	"github.com/flowline-io/flowbot/pkg/types/model"
)

templ AgentSkillForm(ctx context.Context, item model.AgentSkill, isNew bool, errors map[string]string) {
	<tr id={ agentSkillFormID(item, isNew) }>
		<td colspan="6" class="bg-base-200/50">
			<div class="grid grid-cols-1 md:grid-cols-2 gap-4 p-4">
				<div>
					<label class="label"><span class="label-text">{ i18n.T(ctx, "common.flag") }</span></label>
					<input type="text" name="flag" value={ item.Flag }
						data-testid="agent-skill-flag"
						class={ "input input-bordered input-sm w-full font-mono " + fieldError(errors, "flag") }
						placeholder={ i18n.T(ctx, "agent.skill.flag_placeholder") }
						required maxlength="128"
						if !isNew {
							readonly="readonly"
						}
					/>
					<div class="text-error text-xs">{ errors["flag"] }</div>
				</div>
				<div>
					<label class="label"><span class="label-text">{ i18n.T(ctx, "table.col.name") }</span></label>
					<input type="text" name="name" value={ item.Name }
						data-testid="agent-skill-name"
						placeholder={ i18n.T(ctx, "agent.skill.name_placeholder") }
						required maxlength="128"
					/>
					<p class="text-xs text-base-content/50 mt-1">{ i18n.T(ctx, "agent.skill.name_hint") }</p>
					<div class="text-error text-xs">{ errors["name"] }</div>
				</div>
				<div class="md:col-span-2">
					<label class="label"><span class="label-text">{ i18n.T(ctx, "table.col.description") }</span></label>
					<input type="text" name="description" value={ item.Description }
						data-testid="agent-skill-description"
						class={ "input input-bordered input-sm w-full " + fieldError(errors, "description") }
						placeholder={ i18n.T(ctx, "agent.skill.description_placeholder") }
					/>
					<div class="text-error text-xs">{ errors["description"] }</div>
				</div>
				<div>
					<label class="label"><span class="label-text">{ i18n.T(ctx, "agent.skill.base_dir") }</span></label>
					<input type="text" name="base_dir" value={ item.BaseDir }
						data-testid="agent-skill-base-dir"
						class="input input-bordered input-sm w-full font-mono"
						placeholder={ i18n.T(ctx, "agent.skill.base_dir_placeholder") }
					/>
				</div>
				<div>
					<label class="label"><span class="label-text">{ i18n.T(ctx, "common.source") }</span></label>
					<input type="text" name="source" value={ item.Source }
						data-testid="agent-skill-source"
						class="input input-bordered input-sm w-full"
						placeholder={ i18n.T(ctx, "agent.skill.source_placeholder") }
					/>
				</div>
				<div class="md:col-span-2">
					<label class="label"><span class="label-text">{ i18n.T(ctx, "common.content") }</span></label>
					<textarea name="content" rows="12"
						data-testid="agent-skill-content"
						class={ "textarea textarea-bordered w-full font-mono text-sm " + fieldError(errors, "content") }
						placeholder={ i18n.T(ctx, "agent.skill.content_placeholder") }>{ item.Content }</textarea>
					<div class="text-error text-xs">{ errors["content"] }</div>
				</div>
				<div class="flex flex-col gap-2">
					<label class="label cursor-pointer justify-start gap-2">
						<input type="checkbox" name="enabled" value="true"
							data-testid="agent-skill-enabled"
							class="checkbox checkbox-sm"
							if item.Enabled || isNew {
								checked
							}
						/>
						<span class="label-text">{ i18n.T(ctx, "common.enabled") }</span>
					</label>
					<label class="label cursor-pointer justify-start gap-2">
						<input type="checkbox" name="disable_model_invocation" value="true"
							data-testid="agent-skill-disable-invocation"
							class="checkbox checkbox-sm"
							if item.DisableModelInvocation {
								checked
							}
						/>
						<span class="label-text">{ i18n.T(ctx, "agent.skill.disable_invocation") }</span>
					</label>
				</div>
				<div class="flex items-end gap-2">
					<button type="button"
						if isNew {
							hx-post="/service/web/agent-skills"
						} else {
							hx-put={ agentSkillURL(item) }
						}
						hx-target="closest tr"
						hx-swap="outerHTML"
						hx-include="closest tr"
						data-testid="agent-skill-save"
						class="btn btn-primary btn-sm">
						{ i18n.T(ctx, "common.save") }
					</button>
					<button type="button"
						hx-get={ agentSkillCancelURL() }
						hx-target="#agent-skills-table"
						hx-swap="outerHTML"
						data-testid="agent-skill-cancel"
						class="btn btn-ghost btn-sm">
						{ i18n.T(ctx, "common.cancel") }
					</button>
				</div>
				if !isNew {
					<div id={ agentSkillFilesContainerID(item) }
						class="md:col-span-2"
						hx-get={ agentSkillFilesListURL(item) }
						hx-trigger="load"
						hx-swap="innerHTML">
						@PanelSkeleton(ctx)
					</div>
				}
			</div>
		</td>
	</tr>
}
