package partials

import (
	"context"

	"github.com/flowline-io/flowbot/pkg/i18n"
	"github.com/flowline-io/flowbot/pkg/types/model"
)

templ NotifyChannelRow(ctx context.Context, item model.NotifyChannel, highlighted bool) {
	<tr id={ notifyChannelRowID(item) }
		hx-target="this"
		hx-swap="outerHTML"
		class={ "hover", templ.KV("bg-primary/10 ring-1 ring-primary/30", highlighted) }
		if highlighted {
			data-notify-highlight="1"
		}
	>
		<td class="text-base-content font-medium" data-label={ i18n.T(ctx, "table.col.name") }>{ item.Name }</td>
		<td class="text-base-content/70" data-label={ i18n.T(ctx, "common.protocol") }>
			<span class="flowbot-chip flowbot-chip-muted">{ item.Protocol }</span>
		</td>
		<td class="text-base-content/50 font-mono text-xs max-w-xs truncate" data-label={ i18n.T(ctx, "common.uri") }>{ item.URI }</td>
		<td class="text-center" data-label={ i18n.T(ctx, "table.col.status") }>
			@StatusIcon(EnabledStatusIcon(ctx, item.Enabled), "")
		</td>
		<td class="text-center" data-label={ i18n.T(ctx, "common.default") }>
			if item.IsDefault {
				<span class="flowbot-chip flowbot-chip-primary" data-testid="channel-default-badge">{ i18n.T(ctx, "common.default") }</span>
			} else if item.Enabled {
				<button hx-post={ notifyChannelDefaultURL(item) }
					hx-target="#notify-channels-table"
					hx-swap="outerHTML"
					data-testid="channel-set-default"
					class="btn btn-ghost btn-xs text-primary">
					{ i18n.T(ctx, "common.set_default") }
				</button>
			}
		</td>
		<td data-label={ i18n.T(ctx, "table.col.actions") }>
			<div class="flex gap-1">
				<button hx-get={ notifyChannelEditURL(item) }
					data-testid="channel-edit"
					class="btn btn-ghost btn-xs text-primary">
					{ i18n.T(ctx, "common.edit") }
				</button>
				<button hx-post={ notifyChannelTestURL(item) }
					hx-swap="none"
					data-testid="channel-test"
					class="btn btn-ghost btn-xs text-info">
					{ i18n.T(ctx, "common.test") }
					@HtmxIndicator()
				</button>
				<button hx-delete={ notifyChannelDeleteURL(item) }
					data-confirm={ i18n.T(ctx, "confirm.delete_channel.message") }
					data-confirm-title={ i18n.T(ctx, "confirm.delete_channel.title") }
					data-confirm-btn={ i18n.T(ctx, "confirm.delete_channel.btn") }
					data-confirm-class="btn-error"
					data-testid="channel-delete"
					class="btn btn-ghost btn-xs text-error">
					{ i18n.T(ctx, "common.delete") }
					@HtmxIndicator()
				</button>
			</div>
		</td>
	</tr>
}
