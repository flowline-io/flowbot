package partials

import (
	"context"

	"github.com/flowline-io/flowbot/pkg/hub"
	"github.com/flowline-io/flowbot/pkg/i18n"
)

templ CapabilityGrid(ctx context.Context, descriptors []hub.Descriptor, filtered bool) {
	<div id="capability-grid" data-testid="capability-grid">
		if len(descriptors) == 0 {
			if filtered {
				@EmptyState(i18n.T(ctx, "capability.empty.filtered"))
			} else {
				@EmptyStateCTA(
					i18n.T(ctx, "capability.empty.none"),
					i18n.T(ctx, "capability.empty.detail"),
					"/service/web/hub",
					i18n.T(ctx, "capability.empty.cta"),
				)
			}
		} else {
			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
				for _, d := range descriptors {
					@CapabilityCard(ctx, d)
				}
			</div>
		}
	</div>
}
