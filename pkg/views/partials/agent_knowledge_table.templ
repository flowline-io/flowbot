package partials

import (
	"github.com/flowline-io/flowbot/pkg/i18n"
	"github.com/flowline-io/flowbot/pkg/types/model"
)

templ AgentKnowledgeTable(items []model.AgentKnowledge, q string) {
	<div class="flowbot-surface" id="agent-knowledge-table" data-testid="agent-knowledge-table">
		<div class="overflow-x-auto">
			<table class="table flowbot-table-pin">
				<thead>
				<tr>
					<th class="text-xs text-base-content/55">{ i18n.T(ctx, "common.path") }</th>
					<th class="text-xs text-base-content/55">{ i18n.T(ctx, "common.title") }</th>
					<th class="text-xs text-base-content/55">{ i18n.T(ctx, "common.tags") }</th>
					<th class="text-xs text-base-content/55">{ i18n.T(ctx, "common.summary") }</th>
					<th class="text-xs text-base-content/55">{ i18n.T(ctx, "table.col.updated") }</th>
					<th class="text-xs text-base-content/55">{ i18n.T(ctx, "table.col.actions") }</th>
				</tr>
				</thead>
				<tbody id="agent-knowledge-rows">
				for _, item := range items {
					@AgentKnowledgeRow(ctx, item)
				}
				if len(items) == 0 {
					<tr id="agent-knowledge-empty">
						<td colspan="6" class="p-0">
							@EmptyStateHXCTA(
								i18n.T(ctx, "table.empty.knowledge"),
								i18n.T(ctx, "table.empty.knowledge_detail"),
								"/service/web/agent-knowledge/new",
								"#agent-knowledge-rows",
								"afterbegin",
								i18n.T(ctx, "table.empty.knowledge_cta"),
							)
						</td>
					</tr>
				}
				</tbody>
			</table>
		</div>
	</div>
}
