package partials

import (
	"context"

	"github.com/flowline-io/flowbot/pkg/i18n"
	"github.com/flowline-io/flowbot/pkg/types/model"
)

templ AgentScheduledTaskRunsTable(ctx context.Context, items []model.AgentScheduledTaskRun) {
	<div class="flowbot-surface" data-testid="agent-scheduled-task-runs-table">
		<div class="card-body">
			<h2 class="text-lg font-semibold tracking-tight m-0 mb-3">{ i18n.T(ctx, "agent.scheduled.recent_runs") }</h2>
			<div class="overflow-x-auto">
				<table class="table flowbot-table-pin">
					<thead>
						<tr>
							<th class="text-xs text-base-content/55">{ i18n.T(ctx, "table.col.run_id") }</th>
							<th class="text-xs text-base-content/55 text-center">{ i18n.T(ctx, "table.col.state") }</th>
							<th class="text-xs text-base-content/55">{ i18n.T(ctx, "table.col.run_session") }</th>
							<th class="text-xs text-base-content/55">{ i18n.T(ctx, "table.col.started") }</th>
							<th class="text-xs text-base-content/55">{ i18n.T(ctx, "table.col.finished") }</th>
							<th class="text-xs text-base-content/55">{ i18n.T(ctx, "table.col.reply") }</th>
							<th class="text-xs text-base-content/55">{ i18n.T(ctx, "table.col.error") }</th>
						</tr>
					</thead>
					<tbody>
						for _, item := range items {
							<tr class="hover">
								<td class="font-mono text-xs">{ item.RunID }</td>
								<td class="text-center">@StatusIcon(ScheduledTaskRunStateStatusIcon(ctx, item.State), "")</td>
								<td class="font-mono text-xs">
									if item.RunSessionID != "" {
										<a href={ agentSessionDetailURL(item.RunSessionID) } class="link link-hover">{ item.RunSessionID }</a>
									} else {
										<span class="text-base-content/30">-</span>
									}
								</td>
								<td class="text-xs whitespace-nowrap">{ item.StartedAt.Format("2006-01-02 15:04:05") }</td>
								<td class="text-xs whitespace-nowrap">{ AgentScheduledTaskTimeOrDash(item.FinishedAt) }</td>
								<td class="max-w-sm text-xs">
									if item.Reply != "" {
										<span title={ item.Reply }>{ AgentScheduledTaskTextPreview(item.Reply, 120) }</span>
									} else {
										<span class="text-base-content/30">-</span>
									}
								</td>
								<td class="max-w-sm text-xs">
									if item.Error != "" {
										<span title={ item.Error } class="text-error">{ AgentScheduledTaskTextPreview(item.Error, 120) }</span>
									} else {
										<span class="text-base-content/30">-</span>
									}
								</td>
							</tr>
						}
						if len(items) == 0 {
							<tr>
								<td colspan="7" class="p-0">
									@EmptyStateCTA(
										i18n.T(ctx, "agent.scheduled.runs.empty_title"),
										i18n.T(ctx, "agent.scheduled.runs.empty_detail"),
										"",
										"",
									)
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		</div>
	</div>
}
