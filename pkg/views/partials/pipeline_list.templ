package partials

import (
	"context"
	"fmt"

	"github.com/flowline-io/flowbot/pkg/i18n"
)

// PipelineTriggerIcon renders a compact letter badge for a configured pipeline trigger.
templ PipelineTriggerIcon(tr PipelineTriggerSummary) {
	<span
		class={
			"tooltip tooltip-top inline-flex items-center justify-center w-6 h-6 rounded text-xs font-bold",
			templ.KV("bg-primary/10 text-primary", tr.Enabled),
			templ.KV("bg-base-200 text-base-content/40", !tr.Enabled),
		}
		data-tip={ tr.Label }
		aria-label={ tr.Label }
		role="img"
	>{ tr.Letter }</span>
}

templ PipelineListTable(ctx context.Context, entries []PipelineListEntry) {
	if len(entries) == 0 {
			<div class="text-center py-12" data-testid="pipeline-empty">
				@EmptyStateOnClickCTA(
					i18n.T(ctx, "pipeline.empty.title"),
					i18n.T(ctx, "pipeline.empty.detail"),
					"document.getElementById('create-modal').showModal()",
					i18n.T(ctx, "common.create_pipeline"),
				)
			</div>
	} else {
		<div class="flowbot-surface" data-testid="pipeline-table">
			<div class="overflow-x-auto">
			<table class="table table-fixed w-full min-w-[60rem]">
				<thead>
					<tr>
						<th class="w-[22%]">{ i18n.T(ctx, "table.col.name") }</th>
						<th class="w-24">{ i18n.T(ctx, "table.col.status") }</th>
						<th class="w-16">{ i18n.T(ctx, "common.triggers") }</th>
						<th class="w-12 text-center">{ i18n.T(ctx, "common.steps") }</th>
						<th class="w-14 text-center">{ i18n.T(ctx, "common.runtime") }</th>
						<th class="w-[16%]" title={ i18n.T(ctx, "table.col.runs_7d_tip") }>
							<span class="border-b border-dotted border-base-content/35 cursor-help">{ i18n.T(ctx, "table.col.runs_7d") }</span>
						</th>
						<th class="w-36">{ i18n.T(ctx, "common.last_run") }</th>
						<th class="w-48 text-right">{ i18n.T(ctx, "table.col.actions") }</th>
					</tr>
				</thead>
				<tbody>
					for _, entry := range entries {
						<tr class="hover">
							<td class="font-medium text-base-content min-w-0">
								<a href={ templ.URL(PipelineWebPath(entry.Name)) } class="link link-hover truncate block">{ entry.Name }</a>
							</td>
							<td>
				if entry.Status == "published" {
									<span class="flowbot-chip flowbot-chip-success">
										{ i18n.T(ctx, "common.published") }
									</span>
								} else {
									<span class="flowbot-chip flowbot-chip-muted">{ i18n.T(ctx, "common.draft") }</span>
								}
							</td>
							<td>
								if len(entry.Triggers) == 0 {
									<span class="text-base-content/30 text-xs">—</span>
								} else {
									<div class="flex items-center gap-1" data-testid={ "pipeline-triggers-" + entry.Name }>
										for _, tr := range entry.Triggers {
											@PipelineTriggerIcon(tr)
										}
									</div>
								}
							</td>
							<td class="text-center tabular-nums text-sm" data-testid={ "pipeline-steps-" + entry.Name }>{ fmt.Sprintf("%d", entry.StepCount) }</td>
							<td class="text-center">
								if entry.Status == "published" {
									@StatusIcon(PipelineRuntimeStatusIcon(entry.Enabled), "pipeline-runtime-"+entry.Name)
								} else {
									<span class="text-base-content/30 text-xs">—</span>
								}
							</td>
							<td class="tabular-nums text-xs whitespace-nowrap overflow-hidden text-ellipsis"
								title={ RunLatencyCompactTip(entry.Stats) }
								data-testid={ "pipeline-runs-stats-" + entry.Name }>
								{ RunLatencyCompactOrDash(entry.Stats) }
							</td>
							<td
								class="text-base-content/50 text-xs whitespace-nowrap overflow-hidden text-ellipsis"
								title={ PipelineLastRunOrDash(entry.LastRunAt) }>
								{ PipelineLastRunOrDash(entry.LastRunAt) }
							</td>
							<td class="text-right">
								<div class="flex items-center justify-end gap-1 flex-nowrap">
									if entry.Status == "published" {
										if entry.Enabled {
											<button type="button"
												hx-put={ templ.URL(PipelineWebPath(entry.Name) + "/enabled") }
												hx-vals='{"enabled": false}'
												hx-target="#pipeline-list-container"
												hx-swap="outerHTML"
											data-confirm={ i18n.T(ctx, "confirm.pause_pipeline.message") }
											data-confirm-title={ i18n.T(ctx, "confirm.pause_pipeline.title") }
											data-confirm-btn={ i18n.T(ctx, "confirm.pause_pipeline.btn") }
												data-confirm-class="btn-warning"
												data-testid={ "btn-pause-" + entry.Name }
												class="btn btn-ghost btn-xs text-warning">{ i18n.T(ctx, "common.pause") }</button>
										} else {
											<button type="button"
												hx-put={ templ.URL(PipelineWebPath(entry.Name) + "/enabled") }
												hx-vals='{"enabled": true}'
												hx-target="#pipeline-list-container"
												hx-swap="outerHTML"
												data-testid={ "btn-resume-" + entry.Name }
												class="btn btn-ghost btn-xs text-success">{ i18n.T(ctx, "common.resume") }</button>
										}
									}
									<a href={ templ.URL(PipelineWebPath(entry.Name) + "/runs") }
										class="btn btn-ghost btn-xs"
										data-testid={ "pipeline-runs-link-" + entry.Name }>{ i18n.T(ctx, "common.run_history") }</a>
									<button type="button"
										hx-delete={ templ.URL(PipelineWebPath(entry.Name)) }
										hx-target="#pipeline-list-container"
										data-confirm={ i18n.T(ctx, "confirm.delete_pipeline.message") }
										data-confirm-title={ i18n.T(ctx, "confirm.delete_pipeline.title") }
										data-confirm-btn={ i18n.T(ctx, "confirm.delete_pipeline.btn") }
										data-confirm-class="btn-error"
										class="btn btn-ghost btn-xs text-error">
										{ i18n.T(ctx, "common.delete") }
										@HtmxIndicator()
									</button>
								</div>
							</td>
						</tr>
					}
				</tbody>
			</table>
			</div>
		</div>
	}
}
