package partials

import "github.com/flowline-io/flowbot/pkg/i18n"

// ChatAgentSettingsCluster renders compact model, thinking, and approval selects for the
// bottom-left corner of the agents composer and thread input dialogs.
templ ChatAgentSettingsCluster(
	modelID string,
	thinkingID string,
	approvalID string,
	models []SelectableModelOption,
	selectedModel string,
	selectedThinking string,
	selectedApproval string,
	disabled bool,
) {
	<div
		class="chatagent-settings"
		data-testid="chatagent-settings"
		data-selected-multimodal={ chatAgentMultimodalAttr(chatAgentModelMultimodal(models, selectedModel)) }>
		if len(models) > 1 {
			<select
				id={ modelID }
				class="chatagent-settings-select"
				disabled?={ disabled }
				data-session-model={ selectedModel }
				data-testid={ modelID }
				aria-label={ i18n.T(ctx, "chatagent.settings.model_aria") }>
				for _, m := range models {
					if selectedModel != "" && m.ID == selectedModel {
						<option value={ m.ID } data-multimodal={ chatAgentMultimodalAttr(m.Multimodal) } selected>{ m.Name }</option>
					} else {
						<option value={ m.ID } data-multimodal={ chatAgentMultimodalAttr(m.Multimodal) }>{ m.Name }</option>
					}
				}
			</select>
			<span class="chatagent-settings-sep" aria-hidden="true">·</span>
		}
		<select
			id={ thinkingID }
			class="chatagent-settings-select"
			disabled?={ disabled }
			data-session-thinking={ selectedThinking }
			data-testid={ thinkingID }
			aria-label={ i18n.T(ctx, "chatagent.settings.thinking_aria") }>
			@chatAgentThinkingOption("default", i18n.T(ctx, "chatagent.settings.thinking.default"), selectedThinking)
			@chatAgentThinkingOption("off", i18n.T(ctx, "chatagent.settings.thinking.off"), selectedThinking)
			@chatAgentThinkingOption("low", i18n.T(ctx, "chatagent.settings.thinking.low"), selectedThinking)
			@chatAgentThinkingOption("medium", i18n.T(ctx, "chatagent.settings.thinking.medium"), selectedThinking)
			@chatAgentThinkingOption("high", i18n.T(ctx, "chatagent.settings.thinking.high"), selectedThinking)
		</select>
		<span class="chatagent-settings-sep" aria-hidden="true">·</span>
		<select
			id={ approvalID }
			class="chatagent-settings-select"
			disabled?={ disabled }
			data-session-approval={ selectedApproval }
			data-testid={ approvalID }
			aria-label={ i18n.T(ctx, "chatagent.settings.approval_aria") }>
			@chatAgentApprovalOption("manual", i18n.T(ctx, "chatagent.settings.approval.manual"), selectedApproval)
			@chatAgentApprovalOption("auto", i18n.T(ctx, "chatagent.settings.approval.auto"), selectedApproval)
			@chatAgentApprovalOption("off", i18n.T(ctx, "chatagent.settings.approval.off"), selectedApproval)
		</select>
	</div>
}

// ChatAgentWorkspaceSelect renders the composer workspace directory picker.
templ ChatAgentWorkspaceSelect(id string, options []WorkspaceOption, disabled bool) {
	if len(options) > 0 {
		<select
			id={ id }
			class="chatagent-settings-select"
			disabled?={ disabled }
			data-testid={ id }
			aria-label={ i18n.T(ctx, "chatagent.settings.workspace_aria") }>
			for _, opt := range options {
				<option value={ opt.Value }>{ opt.Label }</option>
			}
		</select>
		<span class="chatagent-settings-sep" aria-hidden="true">·</span>
	}
}

// ChatAgentAttachButton renders the circle-plus control used to attach media.
templ ChatAgentAttachButton(id string, hidden bool, disabled bool) {
	<button
		type="button"
		id={ id }
		class="chatagent-attach-btn"
		hidden?={ hidden }
		disabled?={ disabled }
		data-testid={ id }
		title={ i18n.T(ctx, "chatagent.attach_aria") }
		aria-label={ i18n.T(ctx, "chatagent.attach_aria") }>
		<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="none" class="chatagent-attach-icon" aria-hidden="true">
			<circle cx="10" cy="10" r="7.25" stroke="currentColor" stroke-width="1.5"></circle>
			<path stroke="currentColor" stroke-width="1.5" stroke-linecap="round" d="M10 6.75v6.5M6.75 10h6.5"></path>
		</svg>
	</button>
}

// ChatAgentRichInput is the contenteditable composer / follow-up shell with slash-skill support.
templ ChatAgentRichInput(id, className, placeholder, ariaLabel string, disabled bool) {
	<div class="chatagent-rich-shell is-empty">
		<div class="chatagent-rich-placeholder" aria-hidden="true">{ placeholder }</div>
		<div
			id={ id }
			class={ className }
			contenteditable={ chatAgentMultimodalAttr(!disabled) }
			role="textbox"
			aria-multiline="true"
			aria-label={ ariaLabel }
			data-testid={ id }></div>
	</div>
}

templ chatAgentThinkingOption(value, label, selectedThinking string) {
	if chatAgentThinkingSelected(value, selectedThinking) {
		<option value={ value } selected>{ label }</option>
	} else {
		<option value={ value }>{ label }</option>
	}
}

templ chatAgentApprovalOption(value, label, selectedApproval string) {
	if chatAgentApprovalSelected(value, selectedApproval) {
		<option value={ value } selected>{ label }</option>
	} else {
		<option value={ value }>{ label }</option>
	}
}
