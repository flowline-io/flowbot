package partials

import (
	"context"

	"github.com/flowline-io/flowbot/pkg/i18n"
	"github.com/flowline-io/flowbot/pkg/types/model"
)

templ NotifyRulesTable(ctx context.Context, rules []model.NotifyRule, templateIDs []string, highlight string) {
	<div id="notify-rules-table"
		data-testid="notify-rules-table"
		class="flowbot-surface">
		<div class="overflow-x-auto">
			<table class="table flowbot-table-pin">
				<thead>
				<tr>
					<th class="text-xs font-medium text-base-content/55">{ i18n.T(ctx, "table.col.priority") }</th>
					<th class="text-xs font-medium text-base-content/55">{ i18n.T(ctx, "table.col.name") }</th>
					<th class="text-xs font-medium text-base-content/55">{ i18n.T(ctx, "common.action") }</th>
					<th class="text-xs font-medium text-base-content/55">{ i18n.T(ctx, "table.col.event") }</th>
					<th class="text-xs font-medium text-base-content/55">{ i18n.T(ctx, "common.channel") }</th>
					<th class="text-xs font-medium text-base-content/55 text-center">{ i18n.T(ctx, "table.col.status") }</th>
					<th class="text-xs font-medium text-base-content/55">{ i18n.T(ctx, "table.col.actions") }</th>
				</tr>
				</thead>
				<tbody id="notify-rules-rows">
				for _, rule := range rules {
					@NotifyRuleRow(ctx, rule, templateIDs, highlight == rule.RuleID)
				}
				if len(rules) == 0 {
					<tr id="notify-rules-empty">
						<td colspan="7" class="p-0">
							@EmptyStateHXCTA(
								i18n.T(ctx, "notify.empty.rules_title"),
								i18n.T(ctx, "notify.empty.rules_detail"),
								"/service/web/notifications/rules/new",
								"#notify-rules-rows",
								"afterbegin",
								i18n.T(ctx, "common.create_rule"),
							)
						</td>
					</tr>
				}
				</tbody>
			</table>
		</div>
	</div>
}
