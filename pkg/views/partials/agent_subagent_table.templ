package partials

import (
	"github.com/flowline-io/flowbot/pkg/i18n"
	"github.com/flowline-io/flowbot/pkg/types/model"
)

templ AgentSubagentTable(items []model.AgentSubagent) {
	<div class="flowbot-surface" id="agent-subagents-table" data-testid="agent-subagents-table">
		<div class="overflow-x-auto">
			<table class="table flowbot-table-pin flowbot-table-cards">
				<thead>
				<tr>
					<th class="text-xs text-base-content/55">{ i18n.T(ctx, "common.flag") }</th>
					<th class="text-xs text-base-content/55">{ i18n.T(ctx, "table.col.name") }</th>
					<th class="text-xs text-base-content/55">{ i18n.T(ctx, "table.col.description") }</th>
					<th class="text-xs text-base-content/55">{ i18n.T(ctx, "table.col.model") }</th>
					<th class="text-xs text-base-content/55 text-center">{ i18n.T(ctx, "table.col.enabled") }</th>
					<th class="text-xs text-base-content/55">{ i18n.T(ctx, "table.col.updated") }</th>
					<th class="text-xs text-base-content/55">{ i18n.T(ctx, "table.col.actions") }</th>
				</tr>
				</thead>
				<tbody id="agent-subagents-rows">
				for _, item := range items {
					@AgentSubagentRow(ctx, item)
				}
				if len(items) == 0 {
					<tr id="agent-subagents-empty">
						<td colspan="7" class="p-0">
							@EmptyStateHXCTA(
								i18n.T(ctx, "table.empty.subagents"),
								i18n.T(ctx, "table.empty.subagents_detail"),
								"/service/web/agent-subagents/new",
								"#agent-subagents-rows",
								"afterbegin",
								i18n.T(ctx, "table.empty.subagents_cta"),
							)
						</td>
					</tr>
				}
				</tbody>
			</table>
		</div>
	</div>
}
