package partials

import (
	"context"

	"github.com/flowline-io/flowbot/pkg/i18n"
)

templ I18nScript(ctx context.Context) {
	@templ.JSONScript("flowbot-i18n", i18n.ClientMessages(ctx))
}

// LangSwitcher is the EN/中文 locale control for auth and nav shells.
templ LangSwitcher(ctx context.Context) {
	{{ lang := i18n.CookieLang(ctx) }}
	<div class="flex items-center text-xs" data-testid="lang-switcher">
		<button
			type="button"
			hx-post="/service/web/locale"
			hx-vals='{"lang":"en"}'
			hx-include="[name='csrf_token']"
			hx-swap="none"
			class={ "px-1.5 py-0.5 rounded hover:text-base-content", templ.KV("font-semibold text-base-content", lang == i18n.CookieEN), templ.KV("text-base-content/50", lang != i18n.CookieEN) }
			data-testid="lang-switch-en"
			aria-label={ i18n.T(ctx, "common.lang_en") }
		>{ i18n.T(ctx, "common.lang_en") }</button>
		<span class="text-base-content/30" aria-hidden="true">|</span>
		<button
			type="button"
			hx-post="/service/web/locale"
			hx-vals='{"lang":"zh"}'
			hx-include="[name='csrf_token']"
			hx-swap="none"
			class={ "px-1.5 py-0.5 rounded hover:text-base-content", templ.KV("font-semibold text-base-content", lang == i18n.CookieZH), templ.KV("text-base-content/50", lang != i18n.CookieZH) }
			data-testid="lang-switch-zh"
			aria-label={ i18n.T(ctx, "common.lang_zh") }
		>{ i18n.T(ctx, "common.lang_zh") }</button>
	</div>
}
