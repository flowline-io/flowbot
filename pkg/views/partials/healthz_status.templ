package partials

import (
	"context"

	"github.com/flowline-io/flowbot/pkg/i18n"
)

templ HealthzStatus(ctx context.Context, data HealthzData) {
	<div id="healthz-status"
		data-testid="healthz-status"
		hx-get="/service/web/healthz"
		hx-trigger="every 30s"
		hx-swap="outerHTML show:none"
		data-preserve-scroll>
		<div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
			<!-- DB Latency -->
			<div class="flowbot-surface" data-testid="healthz-db-latency">
				<div class="card-body">
					<h2 class="text-base font-semibold tracking-tight m-0 mb-2">{ i18n.T(ctx, "healthz.db_latency") }</h2>
					<div class="grid grid-cols-2 gap-4">
						<div class="stat">
							<div class="stat-title text-xs">{ i18n.T(ctx, "healthz.postgres") }</div>
							<div class="stat-value text-lg">
								if data.PostgresOk {
									{ formatDuration(data.PostgresLatency) }
								} else {
									<span class="text-error">{ i18n.T(ctx, "status.unreachable") }</span>
								}
							</div>
							<div class="stat-desc text-xs">
								if data.PostgresOk {
									<span class="text-success">{ i18n.T(ctx, "status.connected") }</span>
								} else {
									<span class="text-error">{ i18n.T(ctx, "status.disconnected") }</span>
								}
							</div>
						</div>
						<div class="stat">
							<div class="stat-title text-xs">{ i18n.T(ctx, "healthz.redis") }</div>
							<div class="stat-value text-lg">
								if data.RedisOk {
									{ formatDuration(data.RedisLatency) }
								} else {
									<span class="text-error">{ i18n.T(ctx, "status.unreachable") }</span>
								}
							</div>
							<div class="stat-desc text-xs">
								if data.RedisOk {
									<span class="text-success">{ i18n.T(ctx, "status.connected") }</span>
								} else {
									<span class="text-error">{ i18n.T(ctx, "status.disconnected") }</span>
								}
							</div>
						</div>
					</div>
				</div>
			</div>

			<!-- Runtime -->
			<div class="flowbot-surface" data-testid="healthz-runtime">
				<div class="card-body">
					<h2 class="text-base font-semibold tracking-tight m-0 mb-2">{ i18n.T(ctx, "healthz.runtime") }</h2>
					<div class="grid grid-cols-3 gap-4">
						<div class="stat">
							<div class="stat-title text-xs">{ i18n.T(ctx, "healthz.goroutines") }</div>
							<div class="stat-value text-lg">{ data.Goroutines }</div>
						</div>
						<div class="stat">
							<div class="stat-title text-xs">{ i18n.T(ctx, "healthz.heap_alloc") }</div>
							<div class="stat-value text-lg">{ formatBytes(data.HeapAlloc) }</div>
						</div>
						<div class="stat">
							<div class="stat-title text-xs">{ i18n.T(ctx, "healthz.total_alloc") }</div>
							<div class="stat-value text-lg">{ formatBytes(data.TotalAlloc) }</div>
						</div>
						<div class="stat">
							<div class="stat-title text-xs">{ i18n.T(ctx, "healthz.sys_memory") }</div>
							<div class="stat-value text-lg">{ formatBytes(data.SysMem) }</div>
						</div>
						<div class="stat">
							<div class="stat-title text-xs">{ i18n.T(ctx, "healthz.gc_cycles") }</div>
							<div class="stat-value text-lg">{ data.NumGC }</div>
						</div>
						<div class="stat">
							<div class="stat-title text-xs">{ i18n.T(ctx, "healthz.last_gc_pause") }</div>
							<div class="stat-value text-lg">{ formatDuration(data.LastGCPause) }</div>
						</div>
					</div>
				</div>
			</div>
		</div>

		<div class="flowbot-surface mb-6" data-testid="healthz-errors">
			<div class="card-body">
				<h2 class="text-base font-semibold tracking-tight m-0 mb-2">{ i18n.T(ctx, "healthz.recent_errors") }</h2>
				<div class="overflow-x-auto max-h-64 overflow-y-auto">
					if len(data.Errors) == 0 {
						<p class="text-base-content/50 text-sm">{ i18n.T(ctx, "healthz.no_recent_errors") }</p>
					} else {
						<ul class="list-disc list-inside space-y-1">
							for _, e := range data.Errors {
						<li class="text-xs text-error">
							<span class="text-base-content/50">{ e.Time.Format("15:04:05") }</span> { e.Message }
						</li>
							}
						</ul>
					}
				</div>
			</div>
		</div>
	</div>
}

// HealthzCapabilitiesPanel is the deferred capability probe panel (outside healthz-status swaps).
templ HealthzCapabilitiesPanel(ctx context.Context) {
	<div id="healthz-capabilities"
		class="flowbot-surface mb-6"
		data-testid="healthz-capabilities"
		hx-get="/service/web/healthz/capabilities"
		hx-trigger="load, every 30s"
		hx-swap="outerHTML show:none">
		<div class="card-body">
			<h2 class="text-base font-semibold tracking-tight m-0 mb-2">{ i18n.T(ctx, "healthz.capability_status") }</h2>
			@PanelSkeleton(ctx)
		</div>
	</div>
}

templ HealthzCapabilities(ctx context.Context, caps []HealthzCap) {
	<div id="healthz-capabilities"
		class="flowbot-surface mb-6"
		data-testid="healthz-capabilities"
		hx-get="/service/web/healthz/capabilities"
		hx-trigger="every 30s"
		hx-swap="outerHTML show:none">
		<div class="card-body">
			<h2 class="text-base font-semibold tracking-tight m-0 mb-2">{ i18n.T(ctx, "healthz.capability_status") }</h2>
			<div class="overflow-x-auto max-h-64 overflow-y-auto">
				<table class="table table-sm">
					<thead>
						<tr>
							<th>{ i18n.T(ctx, "healthz.col.capability") }</th>
							<th>{ i18n.T(ctx, "healthz.col.status") }</th>
						</tr>
					</thead>
					<tbody>
						for _, cap := range caps {
							<tr>
								<td class="font-medium">{ cap.Type }</td>
								<td>
									if cap.Status == "healthy" {
										<span class="flowbot-chip flowbot-chip-success">{ i18n.T(ctx, "status.healthy") }</span>
									} else if cap.Status == "timeout" {
										<span class="flowbot-chip flowbot-chip-warning">{ i18n.T(ctx, "status.timeout") }</span>
									} else if cap.Status == "na" {
										<span class="flowbot-chip flowbot-chip-muted">{ i18n.T(ctx, "status.na") }</span>
									} else {
										<span class="flowbot-chip flowbot-chip-error">{ cap.Status }</span>
										if cap.Error != "" {
											<span class="text-xs text-error ml-1">{ cap.Error }</span>
										}
									}
								</td>
							</tr>
						}
						if len(caps) == 0 {
							<tr>
								<td colspan="2" class="text-center text-base-content/50">{ i18n.T(ctx, "healthz.no_capabilities") }</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		</div>
	</div>
}
