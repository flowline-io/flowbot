package partials

import (
	"context"

	"github.com/flowline-io/flowbot/pkg/homelab"
	"github.com/flowline-io/flowbot/pkg/i18n"
)

templ HubAppsTable(ctx context.Context, apps []homelab.App, updatedAts map[string]string) {
	<div id="hub-apps-table"
		hx-get="/service/web/hub/list"
		hx-trigger="every 10s"
		hx-swap="outerHTML show:none"
		data-preserve-scroll
		data-testid="hub-apps-table">
		<div class="flowbot-surface">
			<div class="overflow-x-auto">
				<table class="table flowbot-table-pin">
					<thead>
						<tr>
							<th>{ i18n.T(ctx, "table.col.name") }</th>
							<th>{ i18n.T(ctx, "table.col.status") }</th>
							<th>{ i18n.T(ctx, "table.col.capabilities") }</th>
							<th>{ i18n.T(ctx, "table.col.last_updated") }</th>
						</tr>
					</thead>
					<tbody>
						if len(apps) == 0 {
							<tr data-testid="hub-apps-empty">
								<td colspan="4" class="p-0">
									@EmptyStateCTA(
										i18n.T(ctx, "hub.empty.title"),
										i18n.T(ctx, "hub.empty.detail"),
										"/service/web/homelab",
										i18n.T(ctx, "homelab.empty.cta"),
									)
								</td>
							</tr>
						} else {
							for _, a := range apps {
								<tr class="hover">
									<td class="font-medium text-base-content">
										<a href={ templ.URL("/service/web/hub/" + a.Name) } class="link link-hover"
											data-testid={ "hub-app-link-" + a.Name }>
											{ a.Name }
										</a>
									</td>
									<td>
										@AppStatusBadge(ctx, a.Status)
									</td>
									<td>
										if len(a.Capabilities) > 0 {
											<p class="text-xs text-base-content/60 m-0 truncate" title={ capsLabel(a.Capabilities) }>{ capsLabel(a.Capabilities) }</p>
										}
									</td>
									<td class="text-base-content/50 text-xs">
										if ts, ok := updatedAts[a.Name]; ok {
											{ ts }
										}
									</td>
								</tr>
							}
						}
					</tbody>
				</table>
			</div>
		</div>
	</div>
}
