package pages

import (
	"context"

	"github.com/flowline-io/flowbot/pkg/homelab"
	"github.com/flowline-io/flowbot/pkg/i18n"
	"github.com/flowline-io/flowbot/pkg/views/layout"
	"github.com/flowline-io/flowbot/pkg/views/partials"
)

templ HomelabDetailPage(ctx context.Context, app homelab.App, status homelab.AppStatus, version string, scannedAt string) {
	@layout.Base(ctx, DocTitleLiteral(ctx, app.Name)) {
		<div class="mb-4">
			<a href="/service/web/homelab" class="btn btn-ghost btn-sm">{ i18n.T(ctx, "common.back_to_registry") }</a>
		</div>
		<div class="flowbot-surface mb-6">
			<div class="p-6">
				<div class="flex items-center gap-3 mb-4">
					<div class="avatar placeholder bg-primary">
						<div class="w-12 rounded-md text-white">
							<span class="text-xl font-semibold">
								if app.Name != "" {
									{ string(app.Name[0]) }
								}
							</span>
						</div>
					</div>
					<div>
						<h1 class="text-2xl font-semibold tracking-tight m-0">{ app.Name }</h1>
						<div class="flex items-center gap-2 mt-1">
							@partials.AppStatusBadge(ctx, status)
							<span class="text-sm text-base-content/50">{ i18n.T(ctx, "homelab.detail.health") } { string(app.Health) }</span>
						</div>
					</div>
				</div>
				<div class="grid grid-cols-2 gap-2 text-sm text-base-content/70 mb-4">
					<div>
						<span class="text-base-content/50">{ i18n.T(ctx, "homelab.detail.path") }</span>
						<code class="text-xs">{ app.Path }</code>
					</div>
					if app.ComposeFile != "" {
						<div>
							<span class="text-base-content/50">{ i18n.T(ctx, "homelab.detail.compose") }</span>
							<code class="text-xs">{ app.ComposeFile }</code>
						</div>
					}
					if version != "" {
						<div>
							<span class="text-base-content/50">{ i18n.T(ctx, "homelab.detail.version") }</span>
							<span class="text-xs font-mono">{ version }</span>
						</div>
					}
					if scannedAt != "" {
						<div>
							<span class="text-base-content/50">{ i18n.T(ctx, "homelab.detail.last_discovered") }</span>
							<span>{ scannedAt }</span>
						</div>
					}
				</div>
			</div>
		</div>
		if len(app.Services) > 0 {
			<div class="flowbot-surface mb-6">
				<div class="p-6">
					<h2 class="text-lg font-semibold tracking-tight mb-2">{ i18n.T(ctx, "homelab.detail.services") }</h2>
					<div class="overflow-x-auto">
						<table class="table table-xs">
							<thead>
								<tr>
									<th>{ i18n.T(ctx, "table.col.service") }</th>
									<th>{ i18n.T(ctx, "table.col.image") }</th>
									<th>{ i18n.T(ctx, "table.col.container") }</th>
									<th>{ i18n.T(ctx, "table.col.ports") }</th>
								</tr>
							</thead>
							<tbody>
								for _, svc := range app.Services {
									<tr>
										<td class="font-medium">{ svc.Name }</td>
										<td><code class="text-xs">{ svc.Image }</code></td>
										<td>{ svc.Container }</td>
										<td>
											<p class="text-xs font-mono text-base-content/70 m-0 break-all">
												for i, p := range svc.Ports {
													if i > 0 {
														<span class="text-base-content/40"> · </span>
													}
													if p.HostPort != "" {
														<span>{ p.HostPort }:{ p.Container }</span>
													} else {
														<span>{ p.Container }</span>
													}
													if p.Protocol != "" {
														<span>/{ p.Protocol }</span>
													}
												}
											</p>
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				</div>
			</div>
		}
		if len(app.Capabilities) > 0 {
			<div class="flowbot-surface mb-6">
				<div class="p-6">
					<h2 class="text-lg font-semibold tracking-tight mb-2">{ i18n.T(ctx, "homelab.detail.exposed_endpoints") }</h2>
					<div class="overflow-x-auto">
						<table class="table table-xs">
							<thead>
								<tr>
									<th>{ i18n.T(ctx, "healthz.col.capability") }</th>
									<th>{ i18n.T(ctx, "table.col.provider") }</th>
									<th>{ i18n.T(ctx, "table.col.base_url") }</th>
									<th>{ i18n.T(ctx, "table.col.auth") }</th>
									<th>{ i18n.T(ctx, "healthz.col.status") }</th>
								</tr>
							</thead>
							<tbody>
								for _, cap := range app.Capabilities {
									<tr>
										<td class="text-xs font-mono">{ cap.Capability }</td>
										<td>{ cap.Capability }</td>
										<td>
											if cap.Endpoint != nil && cap.Endpoint.BaseURL != "" {
												<a href={ cap.Endpoint.BaseURL } target="_blank"
													class="link link-hover text-xs">
													{ cap.Endpoint.BaseURL }
												</a>
											}
										</td>
										<td>
											if cap.Auth != nil {
												<span class="text-xs font-mono text-base-content/70">{ string(cap.Auth.Type) }</span>
											} else {
												<span class="text-base-content/50 text-xs">-</span>
											}
										</td>
										<td>
											if cap.Endpoint != nil && cap.Endpoint.Health != "" {
												<a href={ cap.Endpoint.Health } target="_blank"
													class="link link-hover text-xs">
													{ cap.Endpoint.Health }
												</a>
											} else {
												<span class="text-base-content/50 text-xs">-</span>
											}
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				</div>
			</div>
		}
	}
}
