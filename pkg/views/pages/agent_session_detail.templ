package pages

import (
	"context"

	"github.com/flowline-io/flowbot/pkg/i18n"
	"github.com/flowline-io/flowbot/pkg/types/model"
	"github.com/flowline-io/flowbot/pkg/views/layout"
	"github.com/flowline-io/flowbot/pkg/views/partials"
)

templ AgentSessionDetailPage(ctx context.Context, session model.AgentSession, entries []model.AgentSessionEntry, plans []model.AgentPlan, todos []model.AgentTodo, pending *partials.ChatAgentPendingConfirm) {
	@layout.Base(ctx, DocTitleAgentSession(ctx, session)) {
		if session.Title != "" {
			@partials.PageHeaderLiteral(ctx, session.Title, session.Flag) {
				<a href={ partials.AgentSessionThreadURL(session.Flag) } class="btn btn-ghost btn-sm" data-testid="agent-session-back">{ i18n.T(ctx, "agent.session.back_to_thread") }</a>
			}
		} else {
			@partials.PageHeaderLiteral(ctx, session.Flag, "") {
				<a href={ partials.AgentSessionThreadURL(session.Flag) } class="btn btn-ghost btn-sm" data-testid="agent-session-back">{ i18n.T(ctx, "agent.session.back_to_thread") }</a>
			}
		}
		<div
			id="chatagent-status-toast"
			class="chatagent-status-toast hidden shrink-0 mb-3 alert py-2 text-sm"
			data-testid="chatagent-status-toast"></div>
		@partials.ChatAgentApprovalPanel(session.Flag, partials.ChatAgentEndpoints{
			ConfirmURL: "/service/web/agent-sessions/" + session.Flag + "/confirm",
			EventsURL:  "/service/web/agent-sessions/" + session.Flag + "/events",
		}, pending)
		<div class="flowbot-surface mb-6">
			<div class="card-body">
				<div class="grid grid-cols-2 gap-2 text-sm text-base-content/70">
					if session.Title != "" {
						<div>
							<span class="text-base-content/50">{ i18n.T(ctx, "agent.session.session_id") }</span>
							<code class="text-xs ml-1">{ session.Flag }</code>
						</div>
					}
					<div>
						<span class="text-base-content/50">{ i18n.T(ctx, "agent.session.uid") }</span>
						<span class="font-mono text-xs ml-1">{ session.UID }</span>
					</div>
					<div>
						<span class="text-base-content/50">{ i18n.T(ctx, "agent.session.state") }</span>
						@partials.AgentSessionStateBadge(session.State)
					</div>
					<div>
						<span class="text-base-content/50">{ i18n.T(ctx, "agent.session.leaf_id") }</span>
						if session.LeafID != "" {
							<code class="text-xs ml-1">{ session.LeafID }</code>
						} else {
							<span class="text-base-content/30 ml-1">-</span>
						}
					</div>
					<div>
						<span class="text-base-content/50">{ i18n.T(ctx, "agent.session.created") }</span>
						<span class="ml-1">{ session.CreatedAt.Format("2006-01-02 15:04:05") }</span>
					</div>
					<div>
						<span class="text-base-content/50">{ i18n.T(ctx, "agent.session.updated") }</span>
						<span class="ml-1">{ session.UpdatedAt.Format("2006-01-02 15:04:05") }</span>
					</div>
				</div>
			</div>
		</div>
		@partials.AgentSessionPlansCard(session.Flag, plans)
		@partials.AgentSessionTodosCard(todos)
		<h2 class="text-lg font-semibold mb-3">{ i18n.T(ctx, "agent.session.entries") }</h2>
		@partials.AgentSessionEntriesTable(ctx, entries)
		@partials.ChatAgentApprovalScripts()
	}
}
