package pages

import (
	"context"

	"github.com/flowline-io/flowbot/pkg/i18n"
	"github.com/flowline-io/flowbot/pkg/views/layout"
	"github.com/flowline-io/flowbot/pkg/views/partials"
)

templ PipelineListPage(ctx context.Context, entries []partials.PipelineListEntry) {
	@layout.Base(ctx, DocTitleFlowbot(ctx, "nav.pipelines")) {
		@partials.PipelineStatsScripts()
		<div class="max-w-6xl mx-auto">
			@partials.PageHeader(ctx, "nav.pipelines", "") {
				<button type="button"
					onclick="document.getElementById('create-modal').showModal()"
					data-testid="btn-new-pipeline"
					class="btn btn-primary">
					{ i18n.T(ctx, "pipeline.create.new_btn") }
				</button>
			}
			<div hx-get={ partials.PipelineStatsURL("", 30, "day") } hx-trigger="revealed" hx-swap="outerHTML">
				@partials.PanelSkeleton(ctx)
			</div>
			<div id="pipeline-list-container" data-testid="pipeline-list-container">
				@partials.PipelineListTable(ctx, entries)
			</div>
		</div>
		<dialog id="create-modal" class="modal" data-testid="create-modal">
			<div class="modal-box">
				<h3 class="text-lg font-medium text-base-content mb-4">{ i18n.T(ctx, "pipeline.create.title") }</h3>
				<form id="create-form" hx-post="/service/web/pipelines" hx-target="body" data-testid="create-form">
					<div id="form-error" data-testid="form-error-slot"></div>
					<label class="label">
						<span class="label-text">{ i18n.T(ctx, "common.name") }</span>
					</label>
					<input type="text" name="name" required minlength="1" maxlength="128"
						class="input input-bordered w-full mb-3"
						placeholder={ i18n.T(ctx, "pipeline.create.name_placeholder") }
						title={ i18n.T(ctx, "pipeline.create.name_title") }
						data-testid="input-pipeline-name">
					<label class="label">
						<span class="label-text">{ i18n.T(ctx, "pipeline.create.desc_optional") }</span>
					</label>
					<input type="text" name="description"
						class="input input-bordered w-full mb-4"
						placeholder={ i18n.T(ctx, "pipeline.create.desc_placeholder") }
						data-testid="input-pipeline-desc">
					<div class="modal-action">
						<button type="button"
							onclick="document.getElementById('create-modal').close()"
							class="btn btn-ghost"
							data-testid="btn-cancel-create">{ i18n.T(ctx, "common.cancel") }</button>
						<button type="submit"
							class="btn btn-primary"
							data-testid="btn-submit-create">{ i18n.T(ctx, "common.create") }</button>
					</div>
				</form>
			</div>
		</dialog>
	}
}
