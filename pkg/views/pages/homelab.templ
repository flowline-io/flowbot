package pages

import (
	"context"
	
	"github.com/flowline-io/flowbot/pkg/homelab"
	"github.com/flowline-io/flowbot/pkg/views/layout"
	"github.com/flowline-io/flowbot/pkg/views/partials"
)

templ HomelabPage(ctx context.Context, apps []homelab.App, scannedAt string) {
	@layout.Base(ctx, DocTitleFlowbot(ctx, "nav.registry")) {
		@partials.HomelabRegistryScripts()
		@partials.PageHeader(ctx, "page.homelab.title", "") {
		}
		@partials.HomelabGrid(ctx, apps, scannedAt)
	}
}
