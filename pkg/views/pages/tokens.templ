// Package pages provides full-page Templ views.
package pages

import (
	"context"
	
	"github.com/flowline-io/flowbot/pkg/i18n"
	"github.com/flowline-io/flowbot/pkg/types/model"
	"github.com/flowline-io/flowbot/pkg/views/layout"
	"github.com/flowline-io/flowbot/pkg/views/partials"
)

templ TokensPage(ctx context.Context, items []model.TokenItem) {
	@layout.Base(ctx, DocTitleFlowbot(ctx, "nav.tokens")) {
		@partials.TableFilterScripts()
		@partials.PageHeader(ctx, "nav.tokens", "") {
			<button
				hx-get="/service/web/tokens/new"
				hx-target="#tokens-rows"
				hx-swap="afterbegin"
				data-testid="token-new-btn"
				class="btn btn-primary btn-sm">
				{ i18n.T(ctx, "btn.new_token") }
			</button>
		}
		<div id="token-alert-container" class="mb-4"></div>
		@partials.TokenTable(ctx, items)
	}
}
