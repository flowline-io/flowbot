package pages

import (
	"github.com/flowline-io/flowbot/pkg/views/layout"
	"github.com/flowline-io/flowbot/pkg/views/partials"
)

// InboxPage renders the user notification inbox.
templ InboxPage(filter string) {
	@layout.Base("Inbox — Flowbot") {
		@partials.PageHeader("Inbox", "Messages delivered to the in-app channel") {
		}
		<div
			hx-get={ templ.URL(partials.InboxListURL(filter)) }
			hx-trigger="load, every 30s"
			hx-swap="outerHTML"
			data-testid="inbox-panel">
			@partials.PanelSkeleton()
		</div>
	}
}
