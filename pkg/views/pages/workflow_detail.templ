package pages

import (
	"context"

	"github.com/flowline-io/flowbot/pkg/i18n"
	"github.com/flowline-io/flowbot/pkg/types/model"
	"github.com/flowline-io/flowbot/pkg/types"
	"github.com/flowline-io/flowbot/pkg/views/layout"
	"github.com/flowline-io/flowbot/pkg/views/partials"
)

templ WorkflowDetailPage(ctx context.Context, meta *types.WorkflowMetadata, triggers []model.WorkflowTrigger, recentRuns []model.WorkflowRun, yamlText string, publicOrigin string) {
	@layout.Base(ctx, DocTitleNamed(ctx, "page.doc_title.workflow", map[string]any{"Name": meta.Name})) {
		@partials.ClipCopyScripts()
		<div class="max-w-4xl mx-auto space-y-6">
			@partials.PageHeaderLiteral(ctx, meta.Name, meta.Describe) {
				<a href="/service/web/workflows" class="btn btn-ghost btn-sm" data-testid="workflow-back">{ i18n.T(ctx, "common.back_to_workflows") }</a>
				<a href={ templ.URL(partials.WorkflowWebPath(meta.Name) + "/runs") }
					class="btn btn-ghost btn-sm"
					data-testid="workflow-detail-runs-link">{ i18n.T(ctx, "common.runs") }</a>
			}
			<div class="flex flex-wrap items-center gap-2 text-sm" data-testid="workflow-meta">
				@partials.StatusIcon(partials.EnabledStatusIcon(meta.Enabled), "workflow-detail-enabled")
				if meta.Resumable {
					<span class="flowbot-chip flowbot-chip-primary">{ i18n.T(ctx, "workflow.resumable") }</span>
				}
				<span class="text-base-content/50">
					{ i18n.TData(ctx, "workflow.max_concurrency", map[string]any{"Count": meta.MaxConcurrency}) }
				</span>
			</div>

			<div role="tablist" class="tabs tabs-bordered" data-testid="workflow-detail-tabs">
				<input
					type="radio"
					name="workflow-detail-tabs"
					class="tab"
					aria-label={ i18n.T(ctx, "workflow.tab.overview") }
					checked="checked"
					data-testid="workflow-tab-overview"
				/>
				<div class="tab-content pt-4 space-y-6">
					<section>
						<h2 class="text-base font-semibold tracking-tight mb-2">{ i18n.T(ctx, "workflow.section.inputs") }</h2>
						@partials.WorkflowInputsReadonly(ctx, meta.Inputs)
					</section>

					<section>
						<h2 class="text-base font-semibold tracking-tight mb-2">{ i18n.T(ctx, "workflow.section.triggers") }</h2>
						@partials.WorkflowTriggersTable(ctx, meta.Name, triggers, publicOrigin)
					</section>

					<section>
						<h2 class="text-base font-semibold tracking-tight mb-2">{ i18n.T(ctx, "workflow.section.execution_graph") }</h2>
						@partials.WorkflowDAG(ctx, partials.BuildWorkflowDAGView(meta.Tasks, meta.Pipeline, meta.MaxConcurrency))
					</section>

					@partials.WorkflowRunNowForm(ctx, meta.Name, meta.Inputs)

					<section>
						<div class="flex items-center justify-between mb-2">
							<h2 class="text-base font-semibold tracking-tight m-0">{ i18n.T(ctx, "workflow.section.recent_runs") }</h2>
							<a href={ templ.URL(partials.WorkflowWebPath(meta.Name) + "/runs") }
								class="link link-hover text-sm"
								data-testid="workflow-recent-runs-all">{ i18n.T(ctx, "common.view_all") }</a>
						</div>
						@partials.WorkflowRunsTable(ctx, meta.Name, recentRuns)
					</section>
				</div>

				<input
					type="radio"
					name="workflow-detail-tabs"
					class="tab"
					aria-label={ i18n.T(ctx, "workflow.tab.yaml") }
					data-testid="workflow-tab-yaml"
				/>
				<div class="tab-content pt-4 min-w-0 max-w-full">
					@partials.WorkflowYAMLSource(ctx, yamlText)
				</div>
			</div>
		</div>
	}
}

templ WorkflowRunsPage(ctx context.Context, name string, runs []model.WorkflowRun) {
	@layout.Base(ctx, DocTitleNamed(ctx, "page.doc_title.runs", map[string]any{"Name": name})) {
		@partials.WorkflowStatsScripts()
		<div class="max-w-4xl mx-auto">
			@partials.PageHeaderLiteral(ctx, i18n.T(ctx, "page.run_history.title"), name) {
				<a href="/service/web/workflows" class="btn btn-ghost btn-sm" data-testid="workflow-runs-list-back">{ i18n.T(ctx, "common.back_to_workflows") }</a>
				<a href={ templ.URL(partials.WorkflowWebPath(name)) }
					class="btn btn-ghost btn-sm"
					data-testid="workflow-runs-back">{ name }</a>
			}
			<div hx-get={ templ.URL(partials.WorkflowStatsURL(name, 30, "day")) } hx-trigger="revealed" hx-swap="outerHTML">
				@partials.PanelSkeleton(ctx)
			</div>
			<div
				id="workflow-runs-panel"
				hx-get={ templ.URL(partials.WorkflowWebPath(name) + "/runs/list") }
				hx-trigger="every 10s"
				hx-swap="innerHTML show:none"
				data-preserve-scroll
				data-testid="workflow-runs-panel"
			>
				@partials.WorkflowRunsTable(ctx, name, runs)
			</div>
		</div>
	}
}
