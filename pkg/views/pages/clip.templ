// Package pages provides full-page Templ views.
package pages

import (
	"context"
	"time"

	"github.com/flowline-io/flowbot/pkg/i18n"
	"github.com/flowline-io/flowbot/pkg/views/layout"
)

// ClipPageData carries fields for the clip reader page.
type ClipPageData struct {
	// Slug is the public short identifier.
	Slug string
	// Title is the display and Open Graph title.
	Title string
	// Description is the preview text for meta tags.
	Description string
	// CreatedAt is when the clip was created.
	CreatedAt time.Time
	// WordCount is a rough word count of the markdown body.
	WordCount int
	// BodyHTML is sanitized HTML rendered from markdown.
	BodyHTML string
	// ContentMD is the raw markdown used by Copy MD.
	ContentMD string
	// NotFound marks a missing or inaccessible clip.
	NotFound bool
}

// ClipPage renders a shareable markdown clip.
templ ClipPage(ctx context.Context, d ClipPageData) {
	@layout.Clip(ctx, clipPageTitle(ctx, d), d.Description, clipHeaderActions(ctx, d)) {
		if d.NotFound {
			<section class="clip-article" data-testid="clip-not-found">
				<h1 class="clip-title">{ i18n.T(ctx, "clip.not_found.title") }</h1>
				<p class="clip-meta">{ i18n.T(ctx, "clip.not_found.meta") }</p>
			</section>
		} else {
			<section class="clip-article" data-testid="clip-page">
				<h1 class="clip-title" data-testid="clip-title">{ d.Title }</h1>
				<p class="clip-meta" data-testid="clip-meta">
					{ formatClipMeta(ctx, d.CreatedAt, d.WordCount) }
				</p>
				<article class="clip-markdown" data-testid="clip-body">
					@templ.Raw(d.BodyHTML)
				</article>
				<footer class="clip-footer" data-testid="clip-footer">
					<span class="clip-footer-slug">{ i18n.T(ctx, "clip.slug_label") } { d.Slug }</span>
				</footer>
			</section>
		}
	}
}

// clipHeaderActions renders Copy MD when the visitor may read the clip body.
templ clipHeaderActions(ctx context.Context, d ClipPageData) {
	if d.NotFound {
		<span></span>
	} else {
		<button
			type="button"
			class="clip-btn clip-btn-secondary"
			data-testid="clip-copy-md"
			data-clip-copy
			data-clip-markdown={ d.ContentMD }
		>
			{ i18n.T(ctx, "clip.copy_md") }
		</button>
	}
}
