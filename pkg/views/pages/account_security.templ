package pages

import (
	"context"

	"github.com/flowline-io/flowbot/pkg/i18n"
	"github.com/flowline-io/flowbot/pkg/views/layout"
	"github.com/flowline-io/flowbot/pkg/views/partials"
)

templ AccountSecurityPage(ctx context.Context, username string, totpEnabled bool, backupRemaining int, flash string, errorMsg string, csrfToken string) {
	@layout.Base(ctx, DocTitlePage(ctx, "page.account_security.title")) {
		@partials.PageHeader(ctx, "page.account_security.title", "page.account_security.subtitle")
		<div class="max-w-xl space-y-6" data-testid="account-security-page">
			if flash != "" {
				<div class="alert alert-success text-sm" data-testid="account-security-flash">
					<span>{ flash }</span>
				</div>
			}
			if errorMsg != "" {
				<div class="alert alert-error text-sm" data-testid="account-security-error">
					<span>{ errorMsg }</span>
				</div>
			}
			<section class="flowbot-surface" data-testid="account-2fa-section">
				<div class="card-body gap-3">
					<div class="flex flex-wrap items-center justify-between gap-2">
						<h2 class="text-base font-semibold tracking-tight m-0">{ i18n.T(ctx, "account.2fa.title") }</h2>
						if totpEnabled {
							<span class="flowbot-chip flowbot-chip-success" data-testid="account-2fa-status">{ i18n.T(ctx, "account.2fa.enabled") }</span>
						} else {
							<span class="flowbot-chip flowbot-chip-warning" data-testid="account-2fa-status">{ i18n.T(ctx, "account.2fa.not_enabled") }</span>
						}
					</div>
					if totpEnabled {
						<p class="text-sm text-base-content/60 m-0">
							{ i18n.T(ctx, "account.2fa.bound_hint") }
							<code class="font-mono text-xs bg-base-200/60 px-1 py-0.5 rounded">composer admin auth reset-2fa</code>
							on the server.
						</p>
					} else {
						<p class="text-sm text-base-content/60 m-0">{ i18n.T(ctx, "account.2fa.setup_hint") }</p>
					}
				</div>
			</section>
			<section class="flowbot-surface">
				<div class="card-body gap-4">
					<div>
						<h2 class="text-base font-semibold tracking-tight m-0">{ i18n.T(ctx, "account.password.title") }</h2>
						<p class="text-sm text-base-content/60 mt-1 mb-0">
							{ i18n.T(ctx, "account.password.signed_in_as") } <strong data-testid="account-username">{ username }</strong>.
						</p>
					</div>
					<form method="post" action="/service/web/account/password"
						data-testid="change-password-form"
						class="space-y-4">
						<input type="hidden" name="csrf_token" value={ csrfToken }/>
						<div class="form-control">
							<label class="label py-0" for="current_password">
								<span class="label-text">{ i18n.T(ctx, "account.password.current") }</span>
							</label>
							<input type="password" id="current_password" name="current_password" required
								data-testid="current-password" class="input input-bordered input-sm w-full"/>
						</div>
						<div class="form-control">
							<label class="label py-0" for="new_password">
								<span class="label-text">{ i18n.T(ctx, "account.password.new") }</span>
							</label>
							<input type="password" id="new_password" name="new_password" required minlength="12"
								data-testid="new-password" class="input input-bordered input-sm w-full"/>
						</div>
						<div>
							<button type="submit" class="btn btn-primary btn-sm" data-testid="change-password-submit">{ i18n.T(ctx, "account.password.update") }</button>
						</div>
					</form>
				</div>
			</section>
			<section class="flowbot-surface">
				<div class="card-body gap-4">
					<div class="flex flex-wrap items-center justify-between gap-2">
						<h2 class="text-base font-semibold tracking-tight m-0">{ i18n.T(ctx, "account.backup.title") }</h2>
						<span class={ backupRemainingChipClass(backupRemaining) } data-testid="backup-remaining">
							{ backupRemainingChipLabel(ctx, backupRemaining) }
						</span>
					</div>
					<p class="text-sm text-base-content/60 m-0">{ i18n.T(ctx, "account.backup.hint") }</p>
					<form method="post" action="/service/web/account/backup-codes"
						data-testid="regen-backup-form" class="space-y-4">
						<input type="hidden" name="csrf_token" value={ csrfToken }/>
						<div class="form-control">
							<label class="label py-0" for="confirm_password">
								<span class="label-text">{ i18n.T(ctx, "account.backup.confirm_password") }</span>
							</label>
							<input type="password" id="confirm_password" name="password" required
								data-testid="regen-password" class="input input-bordered input-sm w-full"
								disabled?={ !totpEnabled }/>
						</div>
						<div>
							<button type="submit"
								class="btn btn-outline btn-sm"
								data-testid="regen-backup-submit"
								disabled?={ !totpEnabled }
								data-confirm={ i18n.T(ctx, "confirm.regenerate_backup_codes.message") }
								data-confirm-title={ i18n.T(ctx, "confirm.regenerate_backup_codes.title") }
								data-confirm-btn={ i18n.T(ctx, "confirm.regenerate_backup_codes.btn") }
								data-confirm-class="btn-warning">
								{ i18n.T(ctx, "account.backup.regenerate") }
							</button>
						</div>
					</form>
				</div>
			</section>
		</div>
	}
}

templ RegeneratedBackupCodesPage(ctx context.Context, codes []string) {
	@layout.Base(ctx, DocTitlePage(ctx, "page.account_security.backup_title")) {
		@partials.PageHeader(ctx, "page.account_security.new_backup_codes_title", "page.account_security.new_backup_codes_subtitle")
		<div class="max-w-xl space-y-6" data-testid="regen-backup-codes-page">
			<div class="flowbot-surface">
				<div class="card-body">
					<ul class="font-mono text-sm space-y-1 m-0 list-none p-0" data-testid="backup-codes-list">
						for _, c := range codes {
							<li>{ c }</li>
						}
					</ul>
				</div>
			</div>
			<a href="/service/web/account" class="btn btn-primary btn-sm" data-testid="backup-codes-done">{ i18n.T(ctx, "common.back_to_account") }</a>
		</div>
	}
}

func backupRemainingChipLabel(ctx context.Context, n int) string {
	if n == 0 {
		return i18n.T(ctx, "account.backup.none_remaining")
	}
	if n == 1 {
		return i18n.T(ctx, "account.backup.one_remaining")
	}
	return i18n.TData(ctx, "account.backup.n_remaining", map[string]any{"Count": n})
}

func backupRemainingChipClass(n int) string {
	switch {
	case n == 0:
		return "flowbot-chip flowbot-chip-error"
	case n <= 3:
		return "flowbot-chip flowbot-chip-warning"
	default:
		return "flowbot-chip flowbot-chip-muted"
	}
}
