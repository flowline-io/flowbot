package pages

import (
	"context"

	"github.com/flowline-io/flowbot/pkg/i18n"
	"github.com/flowline-io/flowbot/pkg/types/model"
	"github.com/flowline-io/flowbot/pkg/views/layout"
	"github.com/flowline-io/flowbot/pkg/views/partials"
)

templ AgentScheduledTaskDetailPage(ctx context.Context, task model.AgentScheduledTask, runs []model.AgentScheduledTaskRun) {
	@layout.Base(ctx, DocTitleAgentScheduledTask(ctx, task)) {
		if task.Name != "" {
			@partials.PageHeaderLiteral(ctx, task.Name, task.TaskID) {
				<a href="/service/web/agent-scheduled-tasks" class="btn btn-ghost btn-sm" data-testid="agent-scheduled-task-back">{ i18n.T(ctx, "common.back_to_scheduled_tasks") }</a>
			}
		} else {
			@partials.PageHeaderLiteral(ctx, task.TaskID, "") {
				<a href="/service/web/agent-scheduled-tasks" class="btn btn-ghost btn-sm" data-testid="agent-scheduled-task-back">{ i18n.T(ctx, "common.back_to_scheduled_tasks") }</a>
			}
		}
		<div class="flowbot-surface mb-6">
			<div class="card-body">
				<div class="grid grid-cols-1 md:grid-cols-2 gap-2 text-sm text-base-content/70">
					<div>
						@partials.AgentScheduledTaskStatePanel(task)
					</div>
					<div>
						<span class="text-base-content/50">{ i18n.T(ctx, "scheduled_task.kind") }</span>
						<span class="ml-1">{ partials.AgentScheduledTaskKindLabel(ctx, task.ScheduleKind) }</span>
					</div>
					<div>
						<span class="text-base-content/50">{ i18n.T(ctx, "scheduled_task.schedule") }</span>
						<code class="text-xs ml-1">{ partials.AgentScheduledTaskScheduleSummary(task) }</code>
					</div>
					<div>
						<span class="text-base-content/50">{ i18n.T(ctx, "scheduled_task.source_session") }</span>
						if task.SourceSessionID != "" {
							<a href={ "/service/web/agent-sessions/" + task.SourceSessionID } class="link link-hover font-mono text-xs ml-1">{ task.SourceSessionID }</a>
						} else {
							<span class="text-base-content/30 ml-1">-</span>
						}
					</div>
					<div>
						<span class="text-base-content/50">{ i18n.T(ctx, "scheduled_task.next_run") }</span>
						<span class="ml-1">{ partials.AgentScheduledTaskTimeOrDash(task.NextRunAt) }</span>
					</div>
					<div>
						<span class="text-base-content/50">{ i18n.T(ctx, "scheduled_task.last_run") }</span>
						<span class="ml-1">{ partials.AgentScheduledTaskTimeOrDash(task.LastRunAt) }</span>
					</div>
					<div>
						<span class="text-base-content/50">{ i18n.T(ctx, "agent.session.created") }</span>
						<span class="ml-1">{ task.CreatedAt.Format("2006-01-02 15:04:05") }</span>
					</div>
					<div>
						<span class="text-base-content/50">{ i18n.T(ctx, "agent.session.updated") }</span>
						<span class="ml-1">{ task.UpdatedAt.Format("2006-01-02 15:04:05") }</span>
					</div>
				</div>
				<div class="mt-4">
					<div class="text-sm font-semibold mb-2">{ i18n.T(ctx, "scheduled_task.prompt") }</div>
					<pre class="bg-base-200 rounded-box p-4 whitespace-pre-wrap text-sm" data-testid="agent-scheduled-task-prompt">{ task.Prompt }</pre>
				</div>
			</div>
		</div>
		@partials.AgentScheduledTaskRunsTable(runs)
	}
}
