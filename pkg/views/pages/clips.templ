// Package pages provides full-page Templ views.
package pages

import (
	"context"
	
	"github.com/flowline-io/flowbot/pkg/views/layout"
	"github.com/flowline-io/flowbot/pkg/views/partials"
)

templ ClipsPage(ctx context.Context, items []partials.ClipListItem) {
	@layout.Base(ctx, DocTitleFlowbot(ctx, "nav.clips")) {
		@partials.PageHeader(ctx, "nav.clips", "") {
		}
		@partials.ClipsTable(ctx, items)
	}
}
