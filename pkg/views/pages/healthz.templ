package pages

import (
	"context"
	
	"github.com/flowline-io/flowbot/pkg/views/layout"
	"github.com/flowline-io/flowbot/pkg/views/partials"
)

templ HealthzPage(ctx context.Context, data partials.HealthzData) {
	@layout.Base(ctx, DocTitlePage(ctx, "page.healthz.title")) {
		@partials.PageHeader(ctx, "page.healthz.title", "page.healthz.subtitle") {
			<span class="text-sm text-base-content/50">
				Auto-refreshes every 30s
			</span>
		}
		@partials.HealthzStatus(data)
		@partials.HealthzCapabilitiesPanel()
	}
}
