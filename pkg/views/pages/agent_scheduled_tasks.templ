package pages

import (
	"context"
	
	"github.com/flowline-io/flowbot/pkg/i18n"
	"github.com/flowline-io/flowbot/pkg/types/model"
	"github.com/flowline-io/flowbot/pkg/views/layout"
	"github.com/flowline-io/flowbot/pkg/views/partials"
)

templ AgentScheduledTasksPage(ctx context.Context, items []model.AgentScheduledTask) {
	@layout.Base(ctx, DocTitleFlowbot(ctx, "nav.scheduled_tasks")) {
		@partials.PageHeader(ctx, "nav.scheduled_tasks", "") {
			<button hx-get="/service/web/agent-scheduled-tasks/list"
				hx-target="#agent-scheduled-tasks-table"
				hx-swap="outerHTML"
				data-testid="agent-scheduled-tasks-refresh"
				class="btn btn-ghost btn-sm">
				{ i18n.T(ctx, "common.refresh") }
				@partials.HtmxIndicator()
			</button>
		}
		@partials.AgentScheduledTaskTable(items)
	}
}
