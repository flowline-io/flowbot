package pages

import (
	"fmt"
	"strings"

	"github.com/flowline-io/flowbot/pkg/views/layout"
	"github.com/flowline-io/flowbot/pkg/views/partials"
)

templ LifeDashboardPage(data LifeCharacterData) {
	@layout.Base("Life — Flowbot") {
		@partials.LifeRadarScripts()
		@lifeModuleShell("life", data.PendingCount) {
			<div class="life-dashboard" data-testid="life-dashboard">
				<div class="life-dashboard-grid">
					<section class="life-panel" data-testid="life-profile-card">
						@lifeProfileSummary(data)
					</section>
					<section class="life-panel life-radar-wrap" data-testid="life-radar-panel">
						<canvas
							data-testid="life-radar-chart"
							data-labels={ data.RadarLabelsJSON }
							data-values={ data.RadarValuesJSON }
							width="360"
							height="360"
						></canvas>
					</section>
				</div>
				<section class="life-panel" data-testid="life-stats-list">
					<ul class="life-stat-list" data-testid="life-characteristics">
						for _, c := range data.Characteristics {
							<li class="life-stat-row">
								<span class="life-stat-name">
									@lifeStatIcon(c.Code)
									{ c.Name }
								</span>
								<div class="life-seg-bar" aria-hidden="true">
									for i := range LifeSegmentIndexes(c.TotalSegs) {
										if i < c.FilledSegs {
											<span class="life-seg is-filled"></span>
										} else {
											<span class="life-seg"></span>
										}
									}
								</div>
								<span class="life-seg-nums">{ fmt.Sprintf("%d / %d", c.Exp, c.ExpToNext) }</span>
								<span class="life-stat-lv">LV{ fmt.Sprintf("%d", c.Level) }</span>
							</li>
						}
					</ul>
				</section>
			</div>
		}
	}
}

templ LifeCharacterPage(data LifeCharacterData) {
	@layout.Base("Character — Life") {
		@lifeModuleShell("character", data.PendingCount) {
			<div class="life-identity" data-testid="life-character">
				<div class="life-identity-title">
					<div class="life-identity-title-box" data-testid="life-identity-title">Character</div>
				</div>
				<section class="life-panel life-profile-panel" data-testid="life-profile-card">
					@lifeProfileSummary(data)
					<form
						hx-post="/service/web/life/character/class"
						hx-swap="none"
						class="life-class-form"
						data-testid="life-class-form"
					>
						<label class="life-field">
							<span class="life-field-label">Class</span>
							<select name="class_type" class="life-field-control" data-testid="life-class-select">
								<option value="Architect" selected?={ data.ClassType == "Architect" }>Architect</option>
								<option value="Mage" selected?={ data.ClassType == "Mage" }>Mage</option>
								<option value="Warrior" selected?={ data.ClassType == "Warrior" }>Warrior</option>
								<option value="Rogue" selected?={ data.ClassType == "Rogue" }>Rogue</option>
							</select>
						</label>
						<button type="submit" class="btn btn-sm btn-primary" data-testid="life-class-save">Save</button>
					</form>
				</section>
			</div>
		}
	}
}

templ LifeGoalsPage(data LifeGoalsData) {
	@layout.Base("Goals — Life") {
		@lifeModuleShell("goals", data.PendingCount) {
			<div class="life-shell" data-testid="life-goals-page">
				<header class="life-shell-header">
					<div>
						<h1>Goals</h1>
						<p>PARA · Project, Area, Resource — the objectives that steer quests and buffs.</p>
					</div>
					if len(data.Goals) > 0 {
						<span class="life-section-count">{ fmt.Sprintf("%d", len(data.Goals)) }</span>
					}
				</header>
				<section class="life-panel life-section life-goals" data-testid="life-goals">
					<form
						hx-post="/service/web/life/goals"
						hx-swap="none"
						hx-disabled-elt="find button[type='submit'], find input, find select"
						class="life-goals-compose"
						data-testid="life-goal-form"
					>
						<input
							name="title"
							class="life-goals-compose-title"
							required
							placeholder="Ship the book this year"
							autocomplete="off"
							data-testid="life-goal-title"
						/>
						<select name="category" class="life-goals-compose-cat" data-testid="life-goal-category" aria-label="Category">
							<option value="Project">Project</option>
							<option value="Area">Area</option>
							<option value="Resource">Resource</option>
						</select>
						<button type="submit" class="btn btn-sm btn-primary life-goals-compose-btn" data-testid="life-goal-create">
							@partials.HtmxIndicator()
							Add
						</button>
					</form>
					if len(data.Goals) == 0 {
						<p class="life-goals-empty">No goals yet — add one above.</p>
					} else {
						<ul class="life-goal-list">
							for _, g := range data.Goals {
								<li class="life-goal-card" data-testid={ "life-goal-card-" + g.Flag }>
									<form
										hx-post={ "/service/web/life/goals/" + g.Flag }
										hx-swap="none"
										hx-disabled-elt="find button, find input, find select"
										class="life-goal-card-main"
										data-testid={ "life-goal-edit-" + g.Flag }
									>
										<input name="title" class="life-goal-card-title" required value={ g.Title } aria-label="Goal title"/>
										<div class="life-goal-card-meta">
											<select name="category" class="life-goal-card-cat" aria-label="Category">
												<option value="Project" selected?={ g.Category == "Project" }>Project</option>
												<option value="Area" selected?={ g.Category == "Area" }>Area</option>
												<option value="Resource" selected?={ g.Category == "Resource" }>Resource</option>
											</select>
											<span class="life-meta-chip">{ g.Status }</span>
										</div>
										<button type="submit" class="life-goal-link" data-testid={ "life-goal-save-" + g.Flag }>
											@partials.HtmxIndicator()
											Save
										</button>
									</form>
									<div class="life-goal-actions">
										if g.Status == "Active" {
											<button
												type="button"
												class="life-goal-link"
												hx-post={ "/service/web/life/goals/" + g.Flag + "/status" }
												hx-vals='{"status":"Paused"}'
												hx-swap="none"
												data-testid={ "life-goal-pause-" + g.Flag }
											>Pause</button>
										}
										if g.Status == "Paused" {
											<button
												type="button"
												class="life-goal-link"
												hx-post={ "/service/web/life/goals/" + g.Flag + "/status" }
												hx-vals='{"status":"Active"}'
												hx-swap="none"
												data-testid={ "life-goal-resume-" + g.Flag }
											>Resume</button>
										}
										<button
											type="button"
											class="life-goal-link life-goal-link-danger"
											hx-post={ "/service/web/life/goals/" + g.Flag + "/delete" }
											hx-swap="none"
											hx-confirm="Delete this goal?"
											data-testid={ "life-goal-delete-" + g.Flag }
										>Delete</button>
									</div>
								</li>
							}
						</ul>
					}
					<p class="life-goals-foot">
						Drop buff +{ fmt.Sprintf("%.0f%%", data.DropRateBonus*100) } · Gold ×{ fmt.Sprintf("%.2f", data.GoldMult) }
					</p>
				</section>
			</div>
		}
	}
}

templ LifePlanPage(data LifePlanData) {
	@layout.Base("Plan — Life") {
		@lifeModuleShell("plan", data.PendingCount) {
			<div class="life-shell" data-testid="life-plan-page">
				<header class="life-shell-header">
					<div>
						<h1>Plan Tree</h1>
						<p>Goal → Milestone → Project → Action · decompose with the Life DM, then confirm import.</p>
					</div>
					if len(data.PlanTree) > 0 {
						<span class="life-section-count">{ fmt.Sprintf("%d", len(data.PlanTree)) }</span>
					}
				</header>
				<section class="life-panel life-section life-goals" data-testid="life-plan-tree">
					<form
						hx-post="/service/web/life/character/plan/breakdown/preview"
						hx-target="[data-testid='life-plan-tree']"
						hx-select="[data-testid='life-plan-tree']"
						hx-swap="outerHTML"
						class="life-breakdown-compose"
						data-testid="life-breakdown-preview-form"
					>
						<div class="life-breakdown-compose-row">
							<input
								name="root_title"
								class="life-goals-compose-title"
								required
								placeholder="Ask AI to decompose a concrete goal"
								autocomplete="off"
								data-testid="life-breakdown-root-title"
							/>
							<button type="submit" class="btn btn-sm btn-secondary life-goals-compose-btn" data-testid="life-breakdown-preview">
								@partials.HtmxIndicator()
								Preview AI breakdown
							</button>
						</div>
						<textarea
							name="description"
							class="life-goals-compose-title life-plan-compose-textarea"
							rows="2"
							placeholder="Optional outcome / constraints"
							data-testid="life-breakdown-description"
						></textarea>
					</form>
					if data.BreakdownPreview != nil && data.BreakdownPreview.Tree != nil {
						<div class="life-goal-card" data-testid="life-breakdown-preview-card">
							<div class="life-goal-card-main">
								<div>
									<p class="life-goal-card-title">AI suggestion: { data.BreakdownPreview.RootTitle }</p>
									if data.BreakdownPreview.Description != "" {
										<p class="life-goals-sub">{ data.BreakdownPreview.Description }</p>
									}
								</div>
							</div>
							<div class="life-goal-list">
								@lifeBreakdownSuggestion(*data.BreakdownPreview.Tree, 0)
							</div>
							<form
								method="post"
								action="/service/web/life/character/plan/breakdown/import"
							>
								<input type="hidden" name="payload_json" value={ data.BreakdownPreview.PayloadJSON }/>
								<button type="submit" class="btn btn-sm btn-primary" data-testid="life-breakdown-import">
									@partials.HtmxIndicator()
									Import suggestion
								</button>
							</form>
						</div>
					}
					if len(data.PlanTree) == 0 {
						<p class="life-goals-empty">No plan nodes yet — preview an AI breakdown to start the tree.</p>
					} else {
						<div class="life-goal-list">
							for _, node := range data.PlanTree {
								@lifePlanNode(node, 0)
							}
						</div>
					}
				</section>
			</div>
		}
	}
}

templ LifeSkillsPage(data LifeSkillTreeData) {
	@layout.Base("Skills — Life") {
		@lifeModuleShell("skills", data.PendingCount) {
			<div class="life-shell" data-testid="life-skills-page">
				<header class="life-shell-header">
					<div>
						<h1>Skill Tree</h1>
						<p>See which branches are actively trained and inspect the recent practice evidence behind each one.</p>
					</div>
					<div class="life-skills-summary">
						<span class="life-meta-chip">{ fmt.Sprintf("%d", data.ActiveLeafCount) } active</span>
						<span class="life-meta-chip">{ fmt.Sprintf("%d", data.TrackedLeafCount) } tracked</span>
					</div>
				</header>
				<div class="life-skills-grid">
					<section class="life-panel life-section life-skills-tree-panel" data-testid="life-skills-tree">
						<header class="life-goals-head">
							<div>
								<h2 class="life-goals-title">Growth Map</h2>
								<p class="life-goals-sub">The whole tree stays visible; active branches are highlighted by recent practice.</p>
							</div>
						</header>
						if len(data.Roots) == 0 {
							<p class="life-goals-empty">No tracked skills yet — complete quests or build action plans to grow the tree.</p>
						} else {
							<div class="life-skill-node-list">
								for _, node := range data.Roots {
									@lifeSkillTreeNode(node, 0)
								}
							</div>
						}
					</section>
					<section class="life-panel life-section life-skills-detail-panel" data-testid="life-skill-detail">
						<header class="life-goals-head">
							<div>
								<h2 class="life-goals-title">Practice Evidence</h2>
								<p class="life-goals-sub">Click a node to inspect the recent quests, actions, and habits that keep it active.</p>
							</div>
						</header>
						if data.SelectedNode == nil {
							<p class="life-goals-empty">Select a branch to inspect its recent practice evidence.</p>
						} else {
							<div class="life-goal-card life-skill-detail-card">
								<div class="life-goal-card-main life-skill-detail-main">
									<div class="life-skill-detail-head">
										<span class="life-skill-detail-badge" aria-hidden="true">{ LifeSkillMonogram(data.SelectedNode.Title) }</span>
										<div>
											<p class="life-skill-detail-title">{ data.SelectedNode.Title }</p>
											if data.SelectedNode.Subtitle != "" {
												<p class="life-skill-detail-subtitle">{ data.SelectedNode.Subtitle }</p>
											}
										</div>
									</div>
									<div class="life-goal-card-meta">
										<span class={ "life-meta-chip", LifeSkillStatusClass(data.SelectedNode.Status) }>{ data.SelectedNode.Status }</span>
										<span class="life-meta-chip">{ fmt.Sprintf("%d", data.SelectedNode.PracticeCount) } records</span>
										<span class="life-meta-chip">{ fmt.Sprintf("%d", data.SelectedNode.SkillCount) } skills</span>
									</div>
								</div>
								if data.SelectedNode.LastActivityLabel != "" {
									<p class="life-skill-detail-foot">Last activity: { data.SelectedNode.LastActivityLabel }</p>
								}
							</div>
							if len(data.SelectedNode.Evidence) == 0 {
								<p class="life-goals-empty">No recent evidence linked to this branch yet.</p>
							} else {
								<ul class="life-skill-evidence-list">
									for _, evidence := range data.SelectedNode.Evidence {
										<li class="life-goal-card life-skill-evidence-card">
											<div class="life-goal-card-main life-skill-evidence-main">
												<div class="life-skill-evidence-head">
													<span class="life-skill-evidence-badge" aria-hidden="true">{ LifeSkillMonogram(evidence.Title) }</span>
													<div>
														<p class="life-skill-evidence-title">{ evidence.Title }</p>
														if evidence.Detail != "" {
															<p class="life-skill-evidence-detail">{ evidence.Detail }</p>
														}
													</div>
												</div>
												<div class="life-goal-card-meta">
													<span class="life-meta-chip">{ evidence.SourceType }</span>
													<span class="life-meta-chip">{ evidence.When }</span>
												</div>
											</div>
										</li>
									}
								</ul>
							}
						}
					</section>
				</div>
			</div>
		}
	}
}

templ lifePlanNode(node LifePlanNodeRow, depth int) {
	if len(node.Children) > 0 {
		<details class="life-tree-node life-tree-branch" style={ LifeIndentStyle(depth) } open?={ depth > 0 && depth < 2 } data-testid={ "life-plan-node-" + node.Flag }>
			<summary class="life-tree-summary">
				<div class="life-goal-card-main">
					<div>
						<p class="life-tree-title">{ node.Title }</p>
						if node.Description != "" {
							<p class="life-tree-description">{ node.Description }</p>
						}
					</div>
					<div class="life-goal-card-meta">
						<span class="life-meta-chip">{ LifePlanNodeTypeLabel(node.NodeType) }</span>
						<span class="life-meta-chip">{ fmt.Sprintf("%d", len(node.Children)) } items</span>
						if node.TaskType != "" {
							<span class="life-meta-chip">{ LifeTaskTypeLabel(node.TaskType) }</span>
						}
					</div>
				</div>
			</summary>
			<div class="life-tree-children">
				for _, child := range node.Children {
					@lifePlanNode(child, depth + 1)
				}
			</div>
		</details>
	} else {
		<div class="life-tree-node life-goal-card" style={ LifeIndentStyle(depth) } data-testid={ "life-plan-node-" + node.Flag }>
			<div class="life-goal-card-main">
				<div>
					<p class="life-tree-title">{ node.Title }</p>
					if node.Description != "" {
						<p class="life-tree-description">{ node.Description }</p>
					}
				</div>
				<div class="life-goal-card-meta">
					<span class="life-meta-chip">{ LifePlanNodeTypeLabel(node.NodeType) }</span>
					if node.TaskType != "" {
						<span class="life-meta-chip">{ LifeTaskTypeLabel(node.TaskType) }</span>
					}
					if node.SuggestedCadence != "" {
						<span class="life-meta-chip">{ node.SuggestedCadence }</span>
					}
					if node.TrackingMode != "" && node.TaskType != "" {
						<span class="life-meta-chip">{ node.TrackingMode }</span>
					}
					if node.Exp > 0 {
						<span class="life-quest-reward">+<strong>{ fmt.Sprintf("%d", node.Exp) }</strong> EXP</span>
					}
					if node.Gold > 0 {
						<span class="life-quest-reward">+<strong>{ fmt.Sprintf("%d", node.Gold) }</strong> gold</span>
					}
				</div>
			</div>
			if node.NeedsConfirmation {
				<div class="life-goal-actions">
					<button
						type="button"
						class="life-goal-link"
						hx-post={ "/service/web/life/character/plan/" + node.Flag + "/confirm-habit" }
						hx-swap="none"
						data-testid={ "life-plan-confirm-" + node.Flag }
					>Confirm habit</button>
				</div>
			}
		</div>
	}
}

templ lifeBreakdownSuggestion(node LifeBreakdownSuggestionRow, depth int) {
	<div class="life-goal-card" style={ LifeIndentStyle(depth) } data-testid={ "life-breakdown-node-" + node.Title }>
		<div class="life-goal-card-main">
			<div>
				<p class="life-goal-card-title">{ node.Title }</p>
				if node.Description != "" {
					<p class="life-goals-sub">{ node.Description }</p>
				}
			</div>
			<div class="life-goal-card-meta">
				<span class="life-meta-chip">{ LifePlanNodeTypeLabel(node.NodeType) }</span>
				if node.TaskType != "" {
					<span class="life-meta-chip">{ LifeTaskTypeLabel(node.TaskType) }</span>
				}
				if node.SuggestedCadence != "" {
					<span class="life-meta-chip">{ node.SuggestedCadence }</span>
				}
				if node.Difficulty != "" {
					<span class="life-meta-chip">{ node.Difficulty }</span>
				}
				if node.Exp > 0 {
					<span class="life-quest-reward">+<strong>{ fmt.Sprintf("%d", node.Exp) }</strong> EXP</span>
				}
				if node.Gold > 0 {
					<span class="life-quest-reward">+<strong>{ fmt.Sprintf("%d", node.Gold) }</strong> gold</span>
				}
			</div>
		</div>
	</div>
	for _, child := range node.Children {
		@lifeBreakdownSuggestion(child, depth + 1)
	}
}

templ lifeModuleShell(active string, pendingCount int) {
	<div class="life-module" data-testid="life-module">
		<aside class="life-sidebar" aria-label="Life navigation">
			<p class="life-sidebar-brand">Life</p>
			<nav class="life-sidebar-nav">
				<a
					href="/service/web/life"
					class={ "life-sidebar-link", templ.KV("is-active", active == "life") }
					data-testid="life-goto-home"
				>Life</a>
				<a
					href="/service/web/life/quests"
					class={ "life-sidebar-link", templ.KV("is-active", active == "quests") }
					data-testid="life-goto-quests"
				>
					Quests
					if pendingCount > 0 {
						<span class="life-sidebar-badge">{ fmt.Sprintf("%d", pendingCount) }</span>
					}
				</a>
				<a
					href="/service/web/life/rewards"
					class={ "life-sidebar-link", templ.KV("is-active", active == "rewards") }
					data-testid="life-goto-rewards"
				>Rewards</a>
				<a
					href="/service/web/life/skills"
					class={ "life-sidebar-link", templ.KV("is-active", active == "skills") }
					data-testid="life-goto-skills"
				>Skills</a>
				<a
					href="/service/web/life/inventory"
					class={ "life-sidebar-link", templ.KV("is-active", active == "inventory") }
					data-testid="life-goto-inventory"
				>Inventory</a>
				<a
					href="/service/web/life/goals"
					class={ "life-sidebar-link", templ.KV("is-active", active == "goals") }
					data-testid="life-goto-goals"
				>Goals</a>
				<a
					href="/service/web/life/plan"
					class={ "life-sidebar-link", templ.KV("is-active", active == "plan") }
					data-testid="life-goto-plan"
				>Plan</a>
				<a
					href="/service/web/life/stats"
					class={ "life-sidebar-link", templ.KV("is-active", active == "stats") }
					data-testid="life-goto-stats"
				>Stats</a>
				<a
					href="/service/web/life/character"
					class={ "life-sidebar-link", templ.KV("is-active", active == "character") }
					data-testid="life-goto-character"
				>Character</a>
				<a
					href="/service/web/life/achievements"
					class={ "life-sidebar-link", templ.KV("is-active", active == "achievements") }
					data-testid="life-goto-achievements"
				>Achievements</a>
			</nav>
		</aside>
		<div class="life-module-main">
			{ children... }
		</div>
	</div>
}

templ lifeSkillTreeNode(node LifeSkillTreeNodeRow, depth int) {
	if len(node.Children) > 0 {
		<details class="life-tree-node life-tree-branch" style={ LifeIndentStyle(depth) } open?={ depth < 1 } data-testid={ "life-skill-node-" + node.Key }>
			<summary class="life-tree-summary">
				@lifeSkillTreeNodeCard(node)
			</summary>
			<div class="life-tree-children">
				for _, child := range node.Children {
					@lifeSkillTreeNode(child, depth + 1)
				}
			</div>
		</details>
	} else {
		<div class="life-tree-node life-goal-card" style={ LifeIndentStyle(depth) } data-testid={ "life-skill-node-" + node.Key }>
			@lifeSkillTreeNodeCard(node)
		</div>
	}
}

templ lifeSkillTreeNodeCard(node LifeSkillTreeNodeRow) {
	<a
		href={ "/service/web/life/skills?node=" + node.Key }
		class={ "life-skill-node-link", templ.KV("is-selected", node.IsSelected) }
	>
		<div class="life-skill-node-main">
			<span class="life-skill-node-badge" aria-hidden="true">{ LifeSkillMonogram(node.Title) }</span>
			<div class="life-skill-node-copy">
				<p class="life-tree-title">{ node.Title }</p>
				if node.Subtitle != "" {
					<p class="life-tree-description">{ node.Subtitle }</p>
				}
			</div>
		</div>
		<div class="life-goal-card-meta life-skill-node-meta">
			<span class={ "life-meta-chip", LifeSkillStatusClass(node.Status) }>{ node.Status }</span>
			<span class="life-meta-chip">{ fmt.Sprintf("%d", node.PracticeCount) } records</span>
			if node.SkillCount > 0 {
				<span class="life-meta-chip">{ fmt.Sprintf("%d", node.SkillCount) } skills</span>
			}
			if node.LastActivityLabel != "" {
				<span class="life-meta-chip">{ node.LastActivityLabel }</span>
			}
		</div>
	</a>
}

templ lifeProfileSummary(data LifeCharacterData) {
	<div class="life-avatar" aria-hidden="true">
		<img
			src="/static/img/life-avatar.svg"
			alt=""
			width="120"
			height="120"
			data-testid="life-avatar-img"
		/>
	</div>
	<p class="life-meta-line" data-testid="life-meta-line">
		<span data-testid="life-nickname">{ data.Nickname }</span>
		<span class="life-meta-sep">•</span>
		<span data-testid="life-level">Level { fmt.Sprintf("%d", data.Level) }</span>
		<span class="life-meta-sep">•</span>
		<span data-testid="life-gold">{ fmt.Sprintf("%d", data.Gold) } Coins</span>
	</p>
	<div class="life-hp-row" data-testid="life-hp-row">
		<span class="life-hp-label">HP:</span>
		<span class="life-hearts" aria-hidden="true">
			for i := range LifeSegmentIndexes(data.HeartsTotal) {
				if i < data.HeartsFilled {
					<svg class="life-heart is-filled" viewBox="0 0 16 16" fill="currentColor"><path d="M8 14s-5.5-3.3-7-6.2C-.2 5.4.8 2.8 3.2 2.3 4.7 2 6.1 2.8 8 4.6c1.9-1.8 3.3-2.6 4.8-2.3 2.4.5 3.4 3.1 2.2 5.5C13.5 10.7 8 14 8 14z"/></svg>
				} else {
					<svg class="life-heart" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M8 14s-5.5-3.3-7-6.2C-.2 5.4.8 2.8 3.2 2.3 4.7 2 6.1 2.8 8 4.6c1.9-1.8 3.3-2.6 4.8-2.3 2.4.5 3.4 3.1 2.2 5.5C13.5 10.7 8 14 8 14z"/></svg>
				}
			}
		</span>
		<span class="life-hp-nums" data-testid="life-hp">{ fmt.Sprintf("%d / %d", data.HPCurrent, data.HPMax) }</span>
	</div>
	<ul class="life-trait-list">
		<li class="life-trait-row">
			<span class="life-trait-label">Master Objective</span>
			<span class="life-trait-value" data-testid="life-master-objective">{ data.MasterObjective }</span>
		</li>
		<li class="life-trait-row">
			<span class="life-trait-label">Minor Objective</span>
			<span class="life-trait-value" data-testid="life-minor-objective">{ data.MinorObjective }</span>
		</li>
		<li class="life-trait-row">
			<span class="life-trait-label">Strength</span>
			<span class="life-trait-value" data-testid="life-strength">{ data.Strength }</span>
		</li>
		<li class="life-trait-row">
			<span class="life-trait-label">Weaknesses</span>
			<span class="life-trait-value" data-testid="life-weakness">{ data.Weakness }</span>
		</li>
	</ul>
	<div class="life-level-row" data-testid="life-level-progress">
		<span class="life-level-label">Level UP:</span>
		<div class="life-seg-bar" aria-hidden="true">
			for i := range LifeSegmentIndexes(data.LevelTotalSegs) {
				if i < data.LevelFilledSegs {
					<span class="life-seg is-filled"></span>
				} else {
					<span class="life-seg"></span>
				}
			}
		</div>
		<span class="life-seg-nums">{ fmt.Sprintf("%d / %d", data.Exp, data.ExpToNext) }</span>
	</div>
}

templ lifeStatIcon(code string) {
	switch code {
		case "PHY":
			<svg class="life-stat-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 3c-2 3-6 5-6 10a6 6 0 0 0 12 0c0-5-4-7-6-10z"/><path d="M12 13v7"/></svg>
		case "INT":
			<svg class="life-stat-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M9 18h6"/><path d="M10 21h4"/><path d="M12 3a7 7 0 0 1 4 12c-.8.7-1.2 1.5-1.4 2.5H9.4C9.2 16.5 8.8 15.7 8 15a7 7 0 0 1 4-12z"/></svg>
		case "WIL":
			<svg class="life-stat-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 3l2.2 6.6H21l-5.4 4 2.1 6.4L12 16.8 6.3 20l2.1-6.4L3 9.6h6.8L12 3z"/></svg>
		case "CHA":
			<svg class="life-stat-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="9" cy="8" r="3"/><circle cx="16" cy="9" r="2.5"/><path d="M3 19c1.5-3 4-4.5 6-4.5s4.5 1.5 6 4.5"/><path d="M13 19c.7-1.8 2-3 3.5-3 1.8 0 3.2 1.2 4.5 3"/></svg>
		case "CRE":
			<svg class="life-stat-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M9 18h6"/><path d="M12 2v2"/><path d="M12 14a4 4 0 0 0 4-4 4.2 4.2 0 0 0-2.5-3.8L12 2l-1.5 4.2A4.2 4.2 0 0 0 8 10a4 4 0 0 0 4 4z"/><path d="M10 22h4"/></svg>
		case "FIN":
			<svg class="life-stat-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="8"/><path d="M12 7v10"/><path d="M9.5 9.5c.5-1 1.5-1.5 2.5-1.5 1.4 0 2.5.8 2.5 2s-1.1 2-2.5 2-2.5.8-2.5 2 1.1 2 2.5 2c1 0 2-.5 2.5-1.5"/></svg>
		case "WRI":
			<svg class="life-stat-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 19.5V5a2 2 0 0 1 2-2h9l5 5v11.5a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 4 19.5z"/><path d="M14 3v5h5"/><path d="M8 13h8"/><path d="M8 17h6"/></svg>
		case "FOC":
			<svg class="life-stat-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="3"/><circle cx="12" cy="12" r="8"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="M2 12h2"/><path d="M20 12h2"/></svg>
		default:
			<svg class="life-stat-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="8"/></svg>
	}
}

templ LifeQuestsPage(data LifeQuestsData) {
	@layout.Base("Quests — Life") {
		@lifeModuleShell("quests", data.PendingCount) {
			<div class="life-shell" data-testid="life-quests-page">
				<header class="life-shell-header">
					<div>
						<h1>Quests</h1>
						<p>Describe work; the Life DM rates difficulty and loot.</p>
					</div>
				</header>

				<section class="life-panel life-section life-composer">
					<form
						hx-post="/service/web/life/quests"
						hx-swap="none"
						hx-disabled-elt="find button[type='submit'], find textarea, find select"
						data-testid="life-quest-form"
					>
						<label class="form-control w-full">
							<span class="label-text text-xs font-medium tracking-wide uppercase opacity-70">What will you do?</span>
							<textarea
								name="prompt"
								class="textarea textarea-bordered w-full mt-1"
								rows="3"
								required
								placeholder="e.g. Finish the API architecture diagram tonight"
								data-testid="life-quest-prompt"
							></textarea>
						</label>
						if len(data.Goals) > 0 {
							<label class="form-control w-full mt-2">
								<span class="label-text text-xs font-medium tracking-wide uppercase opacity-70">Link goal (optional)</span>
								<select name="goal_flag" class="select select-bordered select-sm w-full mt-1" data-testid="life-quest-goal">
									<option value="">None</option>
									for _, g := range data.Goals {
										<option value={ g.Flag }>{ g.Category }: { g.Title }</option>
									}
								</select>
							</label>
						}
						<div class="life-composer-actions">
							<p class="life-composer-hint">AI evaluates difficulty; server sets rewards and drop chance.</p>
							<button type="submit" class="btn btn-primary btn-sm" data-testid="life-quest-create">
								@partials.HtmxIndicator()
								Create quest
							</button>
						</div>
					</form>
				</section>

			<section class="life-panel life-section">
				<div class="life-section-head">
					<h2>Today actions</h2>
					<span class="life-section-count">{ fmt.Sprintf("%d", len(data.TodayActions)) }</span>
				</div>
				if len(data.TodayActions) == 0 {
					<p class="life-empty">No pending action occurrences for today.</p>
				} else {
					<ul class="life-quest-list life-action-list" data-testid="life-today-actions">
						for _, a := range data.TodayActions {
							<li class="life-quest-card life-action-card">
								<div class="life-quest-card-body life-action-body">
									<p class="life-quest-title">{ a.Title }</p>
									if a.ContextPath != "" {
										<p class="life-quest-prompt life-action-context">{ a.ContextPath }</p>
									}
									if a.Description != "" {
										<p class="life-action-description">{ a.Description }</p>
									}
									<div class="life-quest-meta life-action-meta">
										<span class="life-meta-chip">{ LifeTaskTypeLabel(a.TaskType) }</span>
										<span class="life-meta-chip">{ LifeOccurrenceKindLabel(a.Kind) }</span>
										if a.SuggestedCadence != "" {
											<span class="life-meta-chip">{ a.SuggestedCadence }</span>
										}
										if a.TrackingMode != "" {
											<span class="life-meta-chip">{ a.TrackingMode }</span>
										}
										if a.Difficulty != "" {
											<span class="life-meta-chip">{ a.Difficulty }</span>
										}
										if a.Exp > 0 {
											<span class="life-quest-reward">+<strong>{ fmt.Sprintf("%d", a.Exp) }</strong> EXP</span>
										}
										if a.Gold > 0 {
											<span class="life-quest-reward">+<strong>{ fmt.Sprintf("%d", a.Gold) }</strong> gold</span>
										}
										if a.DueLabel != "" {
											<span class="life-meta-chip">Due { a.DueLabel }</span>
										}
									</div>
								</div>
								<div class="life-quest-actions life-action-actions">
									<button type="button" class="btn btn-sm btn-primary" hx-post={ "/service/web/life/actions/" + a.Flag + "/complete" } hx-swap="none" data-testid={ "life-action-complete-" + a.Flag }>
										@partials.HtmxIndicator()
										Complete
									</button>
									<button type="button" class="btn btn-sm btn-ghost" hx-post={ "/service/web/life/actions/" + a.Flag + "/skip" } hx-swap="none" data-testid={ "life-action-skip-" + a.Flag }>
										@partials.HtmxIndicator()
										Skip
									</button>
								</div>
							</li>
						}
					</ul>
				}
			</section>

			<section class="life-panel life-section">
				<div class="life-section-head">
					<h2>Today habits</h2>
					<span class="life-section-count">{ fmt.Sprintf("%d", len(data.TodayHabits)) }</span>
				</div>
				if len(data.TodayHabits) == 0 {
					<p class="life-empty">No habits ready for check-in.</p>
				} else {
					<ul class="life-done-list" data-testid="life-today-habits">
						for _, h := range data.TodayHabits {
							<li class="life-done-row">
								<div class="life-done-main">
									<span class="life-done-title">{ h.Title }</span>
									<div class="life-quest-meta">
										<span class="life-meta-chip">{ LifeTaskTypeLabel(h.TaskType) }</span>
										if h.SuggestedCadence != "" {
											<span class="life-meta-chip">{ h.SuggestedCadence }</span>
										}
										if h.CheckedIn {
											<span class="life-meta-chip">done today</span>
										}
									</div>
								</div>
								<div class="life-quest-actions">
									if !h.CheckedIn {
										<button type="button" class="btn btn-sm btn-primary" hx-post={ "/service/web/life/habits/" + h.NodeFlag + "/checkin" } hx-swap="none" data-testid={ "life-habit-checkin-" + h.NodeFlag }>
											@partials.HtmxIndicator()
											Check in
										</button>
									}
								</div>
							</li>
						}
					</ul>
				}
			</section>

			<section class="life-panel life-section">
				<div class="life-section-head">
					<h2>Pending</h2>
					<span class="life-section-count" data-testid="life-pending-count">{ fmt.Sprintf("%d", len(data.Pending)) }</span>
				</div>
				if len(data.Pending) == 0 {
					<p class="life-empty">No pending quests. Write one above to begin.</p>
				} else {
					<ul class="life-quest-list" data-testid="life-quests-pending">
						for _, q := range data.Pending {
							<li class="life-quest-card life-quest-card-dm">
								<div class="life-quest-card-body">
									<p class="life-quest-title">{ q.Title }</p>
									if q.Prompt != "" {
										<p class="life-quest-prompt" title={ q.Prompt }>{ q.Prompt }</p>
									}
									<div class="life-quest-meta">
										<span class="life-meta-chip">{ q.Type }</span>
										<span class="life-meta-chip life-meta-chip-diff">{ q.Difficulty }</span>
										<span class="life-meta-chip">Fear { fmt.Sprintf("%d", q.Fear) }</span>
										<span class={ "life-meta-chip", "life-rarity-chip", LifeRarityClass(q.DropTier) }>{ q.DropTier }</span>
									</div>
									<div class="life-quest-rewards">
										<span class="life-quest-reward">+<strong>{ fmt.Sprintf("%d", q.Exp) }</strong> EXP</span>
										<span class="life-quest-reward">+<strong>{ fmt.Sprintf("%d", q.Gold) }</strong> gold</span>
										<span class="life-quest-reward">~<strong>{ fmt.Sprintf("%.0f%%", q.DropChance*100) }</strong> drop</span>
									</div>

									<section class="life-quest-evidence">
										<header class="life-quest-block-head">
											<span>Quest evidence</span>
											<span class="life-section-count">{ fmt.Sprintf("%d", len(q.Evidence)) }</span>
										</header>
										if len(q.Evidence) == 0 {
											<p class="life-empty">No evidence submitted yet.</p>
										} else {
											<ul class="life-quest-evidence-list">
												for _, ev := range q.Evidence {
													<li class="life-quest-evidence-row">
														<div class="life-quest-evidence-main">
															<span class="life-meta-chip">{ ev.SourceType }</span>
															<p class="life-quest-evidence-content">{ ev.Content }</p>
															if ev.SourceURL != "" {
																<a href={ templ.URL(ev.SourceURL) } class="life-quest-evidence-link" target="_blank" rel="noreferrer">Open source</a>
															}
														</div>
														<span class="life-quest-evidence-when">{ ev.When }</span>
													</li>
												}
											</ul>
										}
									</section>

									<form
										hx-post={ "/service/web/life/quests/" + q.Flag + "/evidence" }
										hx-swap="none"
										hx-disabled-elt="find button[type='submit'], find textarea, find input, find select"
										class="life-quest-evidence-form"
									>
										<label class="life-quest-field">
											<span class="life-quest-field-label">Submit evidence</span>
											<textarea
												name="content"
												class="life-quest-textarea"
												rows="3"
												required
												placeholder="Describe what you shipped, learned, or produced."
											></textarea>
										</label>
										<div class="life-quest-field-grid">
											<label class="life-quest-field">
												<span class="life-quest-field-label">Evidence type</span>
												<select name="source_type" class="life-quest-select">
													<option value="note">note</option>
													<option value="link">link</option>
													<option value="artifact">artifact</option>
												</select>
											</label>
											<label class="life-quest-field">
												<span class="life-quest-field-label">Source URL (optional)</span>
												<input name="source_url" class="life-quest-input" placeholder="https://..." />
											</label>
										</div>
										<div class="life-quest-toolbar">
											<button type="submit" class="btn btn-sm btn-outline" data-testid={ "life-quest-add-evidence-" + q.Flag }>
												@partials.HtmxIndicator()
												Add evidence
											</button>
											<button
												type="button"
												class="btn btn-sm btn-primary"
												hx-post={ "/service/web/life/quests/" + q.Flag + "/adjudicate" }
												hx-swap="none"
												hx-disabled-elt="this"
												data-testid={ "life-quest-adjudicate-" + q.Flag }
											>
												@partials.HtmxIndicator()
												Request ruling
											</button>
										</div>
									</form>

									if q.Adjudication != nil {
										<section class="life-quest-ruling">
											<div class="life-quest-meta">
												<span class={ "life-meta-chip", LifeVerdictChipClass(q.Adjudication.Verdict) }>{ q.Adjudication.Verdict }</span>
												<span class="life-meta-chip">{ q.Adjudication.Status }</span>
												<span class="life-meta-chip">{ q.Adjudication.When }</span>
											</div>
											<p class="life-quest-ruling-reason">{ q.Adjudication.Reason }</p>
											<div class="life-quest-rewards">
												<span class="life-quest-reward">Suggested +<strong>{ fmt.Sprintf("%d", q.Adjudication.SuggestedExp) }</strong> EXP</span>
												<span class="life-quest-reward">Suggested +<strong>{ fmt.Sprintf("%d", q.Adjudication.SuggestedGold) }</strong> gold</span>
											</div>
											if len(q.Adjudication.SuggestedNextSteps) > 0 {
												<ul class="life-quest-ruling-steps">
													for _, step := range q.Adjudication.SuggestedNextSteps {
														<li>{ step }</li>
													}
												</ul>
											}
										</section>
									}

									<div class="life-quest-toolbar life-quest-card-actions">
										if q.Adjudication != nil && q.Adjudication.Status == "suggested" {
											<button
												type="button"
												class="btn btn-sm btn-primary"
												hx-post={ "/service/web/life/quests/" + q.Flag + "/adjudication/" + q.Adjudication.Flag + "/apply" }
												hx-swap="none"
												hx-disabled-elt="this"
												data-testid={ "life-quest-apply-" + q.Flag }
											>
												@partials.HtmxIndicator()
												Apply ruling
											</button>
										}
										<button
											type="button"
											class="btn btn-sm btn-ghost"
											hx-post={ "/service/web/life/quests/" + q.Flag + "/dismiss" }
											hx-swap="none"
											hx-disabled-elt="this"
											data-confirm="Dismiss this quest? No penalty."
											data-testid={ "life-quest-dismiss-" + q.Flag }
										>
											@partials.HtmxIndicator()
											Dismiss
										</button>
									</div>
								</div>
							</li>
						}
					</ul>
				}
			</section>

			<section class="life-panel life-section">
				<div class="life-section-head">
					<h2>Recently completed</h2>
					<span class="life-section-count">{ fmt.Sprintf("%d", len(data.Completed)) }</span>
				</div>
				if len(data.Completed) == 0 {
					<p class="life-empty">Nothing completed yet.</p>
				} else {
					<ul class="life-done-list" data-testid="life-quests-completed">
						for _, q := range data.Completed {
							<li class="life-done-row">
								<div class="life-done-main">
									<span class="life-done-title" title={ q.Title }>{ q.Title }</span>
									if q.Prompt != "" {
										<span class="life-done-prompt" title={ q.Prompt }>{ q.Prompt }</span>
									}
								</div>
								<div class="life-done-meta">
									<span class="life-quest-reward">+<strong>{ fmt.Sprintf("%d", q.Exp) }</strong> EXP</span>
									<span class="life-quest-reward">+<strong>{ fmt.Sprintf("%d", q.Gold) }</strong> gold</span>
									<span class="life-meta-chip life-meta-chip-diff">{ q.Difficulty }</span>
								</div>
							</li>
						}
					</ul>
				}
			</section>

			<section class="life-panel life-section">
				<div class="life-section-head">
					<h2>Action log</h2>
					<span class="life-section-count">{ fmt.Sprintf("%d", len(data.ActionLogs)) }</span>
				</div>
				if len(data.ActionLogs) == 0 {
					<p class="life-empty">No completions logged yet.</p>
				} else {
					<ul class="life-done-list" data-testid="life-action-logs">
						for _, l := range data.ActionLogs {
							<li class="life-done-row">
								<div class="life-done-main">
									<span class="life-done-title" title={ l.QuestTitle }>{ l.QuestTitle }</span>
									<span class="life-done-prompt">{ LifeActionLogSourceLabel(l.SourceType) } · { l.When }</span>
								</div>
								<div class="life-done-meta">
									<span class="life-quest-reward">+<strong>{ fmt.Sprintf("%d", l.GainedExp) }</strong> EXP</span>
									<span class="life-quest-reward">+<strong>{ fmt.Sprintf("%d", l.GainedGold) }</strong> gold</span>
									if l.HasDice {
										<span class="life-meta-chip">dice { fmt.Sprintf("%.2f", l.Dice) }</span>
									}
									if l.Dropped {
										<span class="life-meta-chip">drop</span>
									}
								</div>
							</li>
						}
					</ul>
				}
			</section>
		</div>
		}
	}
}

templ LifeInventoryPage(data LifeInventoryData) {
	@layout.Base("Inventory — Life") {
		@lifeModuleShell("inventory", data.PendingCount) {
			<div class="life-shell" data-testid="life-inventory-page">
				<header class="life-shell-header">
					<div>
						<h1>Inventory</h1>
						<p>Equip gear to gain attribute and ability bonuses.</p>
					</div>
				</header>

				<section class="life-panel life-section" data-testid="life-equip-board">
					<div class="life-section-head">
						<h2>Equipped</h2>
						<span class="life-section-count">{ lifeEquippedCount(data.Slots) }</span>
					</div>
					<div class="life-equip-stage" data-testid="life-equip-slots">
						for _, slot := range data.Slots {
							<div
								class={
									"life-equip-slot",
									"life-equip-slot-" + strings.ToLower(slot.Label),
									templ.KV("is-filled", slot.Item != nil),
									LifeSlotRarityClass(slot),
								}
								data-testid={ "life-equip-slot-" + strings.ToLower(slot.Label) }
							>
								<div class="life-equip-slot-top">
									<span class="life-equip-slot-icon" aria-hidden="true">
										@lifeEquipSlotIcon(slot.Label)
									</span>
									<p class="life-equip-slot-label">{ slot.Label }</p>
								</div>
								if slot.Item != nil {
									<p class="life-equip-slot-name">{ slot.Item.Name }</p>
									<div class="life-equip-slot-meta">
										<span class={ "life-meta-chip", "life-rarity-chip", LifeRarityClass(slot.Item.Rarity) }>{ slot.Item.Rarity }</span>
										if slot.Item.BuffText != "" {
											<span class="life-meta-chip">{ slot.Item.BuffText }</span>
										}
										if slot.Item.PerkText != "" {
											<span class="life-meta-chip">Perk { slot.Item.PerkText }</span>
										}
										if slot.Item.Tarnished {
											<span class="life-meta-chip life-meta-chip-warn">Tarnished</span>
										}
									</div>
									<button
										type="button"
										class="btn btn-sm life-equip-slot-action"
										hx-post={ "/service/web/life/inventory/slots/" + slot.SlotField + "/unequip" }
										hx-swap="none"
										data-testid={ "life-slot-unequip-" + strings.ToLower(slot.Label) }
									>Unequip</button>
								} else {
									<p class="life-equip-slot-empty">Empty</p>
								}
							</div>
						}
					</div>
				</section>

				<section class="life-panel life-section" data-testid="life-inventory">
					<div class="life-section-head">
						<h2>Backpack</h2>
						<span class="life-section-count">{ fmt.Sprintf("%d", len(data.Items)) }</span>
					</div>
					if len(data.Items) == 0 {
						<p class="life-empty">Backpack empty — complete quests to earn loot.</p>
					} else {
						<ul class="life-inv-list">
							for _, it := range data.Items {
								<li class={ "life-inv-card", templ.KV("is-equipped", it.Equipped), LifeRarityClass(it.Rarity) }>
									<div class="life-inv-icon" aria-hidden="true">
										@lifeEquipSlotIcon(it.Slot)
									</div>
									<div class="life-inv-body min-w-0">
										<p class="life-inv-title">
											{ it.Name }
											if it.Equipped {
												<span class="flowbot-chip flowbot-chip-info text-xs ml-1 align-middle">Equipped</span>
											}
										</p>
										<div class="life-quest-meta">
											<span class={ "life-meta-chip", "life-rarity-chip", LifeRarityClass(it.Rarity) }>{ it.Rarity }</span>
											<span class="life-meta-chip">{ it.Slot }</span>
											if it.BuffText != "" {
												<span class="life-meta-chip">{ it.BuffText }</span>
											}
											if it.PerkText != "" {
												<span class="life-meta-chip">Perk { it.PerkText }</span>
											}
											<span class="life-meta-chip">Lore { it.LoreStatus }</span>
											if it.Tarnished {
												<span class="life-meta-chip life-meta-chip-warn">Tarnished</span>
											}
										</div>
										if it.Lore != "" {
											<p class="life-inv-lore">{ it.Lore }</p>
										}
									</div>
									<div class="life-quest-actions">
										if it.Equipped {
											<button
												type="button"
												class="btn btn-sm"
												hx-post={ "/service/web/life/inventory/slots/" + it.SlotField + "/unequip" }
												hx-swap="none"
												data-testid={ "life-unequip-" + it.Flag }
											>Unequip</button>
										} else {
											<button
												type="button"
												class="btn btn-sm btn-primary"
												hx-post={ "/service/web/life/inventory/" + it.Flag + "/equip" }
												hx-swap="none"
												data-testid={ "life-equip-" + it.Flag }
											>Equip</button>
										}
									</div>
								</li>
							}
						</ul>
					}
				</section>
			</div>
		}
	}
}

templ LifeAchievementsPage(data LifeAchievementsData) {
	@layout.Base("Achievements — Life") {
		@lifeModuleShell("achievements", data.PendingCount) {
			<div class="life-shell" data-testid="life-achievements-page">
				<header class="life-shell-header">
					<div>
						<h1>Achievements</h1>
						<p>Memorial milestones from quest completions.</p>
					</div>
					<span class="life-section-count" data-testid="life-achievements-count">
						{ fmt.Sprintf("%d / %d unlocked", data.UnlockedCount, len(data.Items)) }
					</span>
				</header>

				<section class="life-panel life-section" data-testid="life-achievements-list">
					if len(data.Items) == 0 {
						<p class="life-empty">No achievements seeded yet.</p>
					} else {
						<ul class="life-achievement-list">
							for _, item := range data.Items {
								<li
									class={
										"life-achievement-card",
										templ.KV("is-unlocked", item.Unlocked),
										templ.KV("is-retired", item.Retired),
									}
									data-testid={ "life-achievement-" + item.Flag }
								>
									<div class="life-achievement-head">
										<h2 class="life-achievement-name">{ item.Name }</h2>
										if item.Unlocked {
											<span class="flowbot-chip flowbot-chip-success">Unlocked</span>
										} else {
											<span class="flowbot-chip">Locked</span>
										}
									</div>
									<p class="life-achievement-desc">{ item.Description }</p>
									if item.ShowProgress {
										<div class="life-achievement-progress" data-testid={ "life-achievement-progress-" + item.Flag }>
											<div class="life-seg-bar" aria-hidden="true">
												<div
													class="life-achievement-progress-fill"
													style={ fmt.Sprintf("width:%d%%", lifeAchievementProgressPct(item.Current, item.Target)) }
												></div>
											</div>
											<span class="life-seg-nums">{ fmt.Sprintf("%d / %d", item.Current, item.Target) }</span>
										</div>
									}
									if item.Unlocked && item.UnlockedAt != "" {
										<p class="life-achievement-meta">Unlocked { item.UnlockedAt }</p>
									}
									if item.Retired {
										<p class="life-achievement-meta">Retired from catalog</p>
									}
								</li>
							}
						</ul>
					}
				</section>
			</div>
		}
	}
}

templ LifeRewardsPage(data LifeRewardsData) {
	@layout.Base("Rewards — Life") {
		@lifeModuleShell("rewards", data.PendingCount) {
			<div class="life-shell" data-testid="life-rewards-page">
				<header class="life-shell-header">
					<div>
						<h1>Rewards</h1>
						<p>Spend gold on real-life treats you define. Honor system — redeem when you claim it.</p>
					</div>
					<div class="life-rewards-balance" data-testid="life-rewards-gold">
						<span class="life-rewards-balance-label">Balance</span>
						<span class="life-rewards-balance-value">{ fmt.Sprintf("%d", data.Gold) }</span>
						<span class="life-rewards-balance-unit">gold</span>
					</div>
				</header>

				<section class="life-panel life-section" data-testid="life-rewards-create">
					<header class="life-goals-head">
						<div>
							<h2 class="life-goals-title">Add reward</h2>
							<p class="life-goals-sub">Name it, price it, optional cooldown.</p>
						</div>
					</header>
					<form
						class="life-rewards-compose"
						hx-post="/service/web/life/rewards"
						hx-swap="none"
						hx-disabled-elt="find button[type='submit'], find input"
						data-testid="life-rewards-create-form"
					>
						<input
							type="text"
							name="name"
							class="life-rewards-compose-name"
							required
							placeholder="Milk tea"
							autocomplete="off"
							data-testid="life-reward-name-input"
						/>
						<div class="life-rewards-compose-row">
							<label class="life-rewards-compose-field">
								<span class="life-field-label">Price</span>
								<input type="number" name="price" class="life-rewards-compose-num" min="1" required value="10" data-testid="life-reward-price-input"/>
							</label>
							<label class="life-rewards-compose-field">
								<span class="life-field-label">Cooldown h</span>
								<input type="number" name="cooldown_hours" class="life-rewards-compose-num" min="0" value="0" data-testid="life-reward-cooldown-input"/>
							</label>
							<label class="life-rewards-compose-field life-rewards-compose-notes">
								<span class="life-field-label">Notes</span>
								<input type="text" name="notes" class="life-rewards-compose-text" placeholder="Weekends only" data-testid="life-reward-notes-input"/>
							</label>
							<button type="submit" class="btn btn-sm btn-primary life-goals-compose-btn" data-testid="life-reward-create-submit">
								@partials.HtmxIndicator()
								Add
							</button>
						</div>
					</form>
				</section>

				<section class="life-panel life-section" data-testid="life-rewards-active">
					<header class="life-goals-head">
						<div>
							<h2 class="life-goals-title">Active</h2>
							<p class="life-goals-sub">Redeem when you take the treat.</p>
						</div>
						if len(data.Active) > 0 {
							<span class="life-goals-count">{ fmt.Sprintf("%d", len(data.Active)) }</span>
						}
					</header>
					if len(data.Active) == 0 {
						<p class="life-empty">No rewards yet — add one above.</p>
					} else {
						<ul class="life-reward-list">
							for _, item := range data.Active {
								<li class="life-reward-card" data-testid={ "life-reward-" + item.Flag }>
									<div class="life-reward-main">
										<div class="life-reward-copy">
											<div class="life-reward-head">
												<h3 class="life-reward-name">{ item.Name }</h3>
												<span class="life-meta-chip" data-testid={ "life-reward-price-" + item.Flag }>
													{ fmt.Sprintf("%d gold", item.Price) }
												</span>
											</div>
											if item.Notes != "" {
												<p class="life-reward-notes">{ item.Notes }</p>
											}
											<div class="life-reward-meta-row">
												if item.OnCooldown {
													<span class="life-meta-chip life-meta-chip-warn" data-testid={ "life-reward-cooldown-" + item.Flag }>
														if item.CooldownEndsAt != "" {
															{ fmt.Sprintf("Cooldown · until %s", item.CooldownEndsAt) }
														} else {
															On cooldown
														}
													</span>
												} else if item.CooldownHours > 0 {
													<span class="life-meta-chip">{ fmt.Sprintf("%dh cooldown", item.CooldownHours) }</span>
												} else {
													<span class="life-meta-chip">No cooldown</span>
												}
												if !item.CanAfford && !item.OnCooldown {
													<span class="life-meta-chip" data-testid={ "life-reward-unaffordable-" + item.Flag }>Need more gold</span>
												}
											</div>
										</div>
										<div class="life-reward-cta">
											if item.CanRedeem {
												<form
													hx-post={ "/service/web/life/rewards/" + item.Flag + "/redeem" }
													hx-swap="none"
													data-testid={ "life-reward-redeem-" + item.Flag }
												>
													<button type="submit" class="btn btn-primary btn-sm">
														@partials.HtmxIndicator()
														Redeem
													</button>
												</form>
											} else {
												<button type="button" class="btn btn-ghost btn-sm" disabled>Redeem</button>
											}
										</div>
									</div>
									<div class="life-reward-footer">
										<details class="life-reward-edit" data-testid={ "life-reward-edit-" + item.Flag }>
											<summary class="life-goal-link">Edit</summary>
											<form
												class="life-rewards-edit-form"
												hx-post={ "/service/web/life/rewards/" + item.Flag }
												hx-swap="none"
												hx-disabled-elt="find button[type='submit'], find input"
											>
												<label class="life-rewards-compose-field life-rewards-compose-notes">
													<span class="life-field-label">Name</span>
													<input type="text" name="name" class="life-rewards-compose-text" value={ item.Name } required aria-label="Name"/>
												</label>
												<label class="life-rewards-compose-field">
													<span class="life-field-label">Price</span>
													<input type="number" name="price" class="life-rewards-compose-num" min="1" value={ fmt.Sprintf("%d", item.Price) } required aria-label="Price"/>
												</label>
												<label class="life-rewards-compose-field">
													<span class="life-field-label">Cooldown h</span>
													<input type="number" name="cooldown_hours" class="life-rewards-compose-num" min="0" value={ fmt.Sprintf("%d", item.CooldownHours) } aria-label="Cooldown hours"/>
												</label>
												<label class="life-rewards-compose-field life-rewards-compose-notes">
													<span class="life-field-label">Notes</span>
													<input type="text" name="notes" class="life-rewards-compose-text" value={ item.Notes } aria-label="Notes"/>
												</label>
												<button type="submit" class="btn btn-sm btn-primary">
													@partials.HtmxIndicator()
													Save
												</button>
											</form>
										</details>
										<button
											type="button"
											class="life-goal-link life-goal-link-danger"
											hx-post={ "/service/web/life/rewards/" + item.Flag + "/deactivate" }
											hx-swap="none"
											data-confirm="Deactivate this reward?"
											data-testid={ "life-reward-deactivate-" + item.Flag }
										>Deactivate</button>
									</div>
								</li>
							}
						</ul>
					}
				</section>

				<section class="life-panel life-section" data-testid="life-rewards-history">
					<header class="life-goals-head">
						<div>
							<h2 class="life-goals-title">Recent redemptions</h2>
							<p class="life-goals-sub">Snapshot of what you claimed.</p>
						</div>
						if len(data.Redemptions) > 0 {
							<span class="life-goals-count">{ fmt.Sprintf("%d", len(data.Redemptions)) }</span>
						}
					</header>
					if len(data.Redemptions) == 0 {
						<p class="life-empty">No redemptions yet.</p>
					} else {
						<ul class="life-reward-history" data-testid="life-rewards-history-list">
							for _, item := range data.Redemptions {
								<li data-testid={ "life-redemption-" + item.Flag }>
									<span class="life-reward-history-name">{ item.RewardName }</span>
									<span class="life-reward-history-meta">
										<span class="life-reward-history-price">{ fmt.Sprintf("−%d gold", item.PricePaid) }</span>
										<span class="life-reward-history-time">{ item.RedeemedAt }</span>
									</span>
								</li>
							}
						</ul>
					}
				</section>

				if len(data.Inactive) > 0 {
					<details class="life-panel life-section life-rewards-inactive" data-testid="life-rewards-inactive">
						<summary class="life-rewards-inactive-summary">
							<span class="life-goals-title">Deactivated</span>
							<span class="life-goals-count">{ fmt.Sprintf("%d", len(data.Inactive)) }</span>
						</summary>
						<ul class="life-reward-list">
							for _, item := range data.Inactive {
								<li class="life-reward-card is-inactive" data-testid={ "life-reward-inactive-" + item.Flag }>
									<div class="life-reward-main">
										<div class="life-reward-copy">
											<div class="life-reward-head">
												<h3 class="life-reward-name">{ item.Name }</h3>
												<span class="life-meta-chip">{ fmt.Sprintf("%d gold", item.Price) }</span>
											</div>
											if item.Notes != "" {
												<p class="life-reward-notes">{ item.Notes }</p>
											}
										</div>
										<form
											hx-post={ "/service/web/life/rewards/" + item.Flag + "/restore" }
											hx-swap="none"
											data-testid={ "life-reward-restore-" + item.Flag }
										>
											<button type="submit" class="btn btn-sm btn-primary">
												@partials.HtmxIndicator()
												Restore
											</button>
										</form>
									</div>
								</li>
							}
						</ul>
					</details>
				}
			</div>
		}
	}
}

templ LifeStatsPage(data LifeStatsShellData) {
	@layout.Base("Stats — Life") {
		@partials.LifeStatsScripts()
		@lifeModuleShell("stats", data.PendingCount) {
			<div class="life-shell" data-testid="life-stats-page">
				<header class="life-shell-header">
					<div>
						<h1>Stats</h1>
						<p>Last 30 days of activity, growth, quests, gold, and loot.</p>
					</div>
				</header>
				<div id="life-stats-container" data-testid="life-stats-loader">
					@partials.PanelSkeleton()
				</div>
			</div>
		}
	}
}

templ lifeEquipSlotIcon(slot string) {
	switch slot {
		case "Head":
			<svg class="life-equip-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M8 14v1.5A2.5 2.5 0 0 0 10.5 18h3A2.5 2.5 0 0 0 16 15.5V14"/><path d="M7 14c0-3.5 2.2-6 5-6s5 2.5 5 6"/><path d="M9.5 8.2C10 6.5 11 5.5 12 5.5s2 1 2.5 2.7"/><path d="M12 5.5V4"/></svg>
		case "Weapon":
			<svg class="life-equip-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M15 4l5 5"/><path d="M14 6l4 4"/><path d="M12.5 7.5L5 15l-1.2 5.2L9 19l7.5-7.5"/><path d="M8 16l2.5 2.5"/><path d="M4.5 19.5l2-.5"/></svg>
		case "Armor":
			<svg class="life-equip-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 5.5L12 4l3 1.5 2.5 2V10l-2 1v7.5H8.5V11l-2-1V7.5L9 5.5z"/><path d="M10 11h4"/><path d="M12 11v7.5"/></svg>
		case "Shoes":
			<svg class="life-equip-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 13.5l1.5-5.5h5.5l1 3h5a2 2 0 0 1 0 4H6a1.5 1.5 0 0 1-1.5-1.5z"/><path d="M7.5 15v2"/><path d="M16.5 15v2"/></svg>
		case "Accessory":
			<svg class="life-equip-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="13" r="5.5"/><circle cx="12" cy="13" r="2"/><path d="M12 4v3.2"/><path d="M10.2 5.2h3.6"/></svg>
		case "Artifact":
			<svg class="life-equip-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3.5l2.8 5.6 6.2.6-4.7 4.2 1.4 6.1L12 17.2 6.3 20l1.4-6.1L3 9.7l6.2-.6L12 3.5z"/></svg>
		default:
			<svg class="life-equip-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="5" width="14" height="14" rx="2"/></svg>
	}
}
