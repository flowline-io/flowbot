package pages

import (
	"context"
	"fmt"
	"strings"

	"github.com/flowline-io/flowbot/pkg/i18n"
	"github.com/flowline-io/flowbot/pkg/views/layout"
	"github.com/flowline-io/flowbot/pkg/views/partials"
)

templ LifeDashboardPage(data LifeCharacterData) {
	@layout.Base(ctx, DocTitleFlowbot(ctx, "nav.life")) {
		@partials.LifeRadarScripts()
		@lifeModuleShell(ctx, "life", data.PendingCount) {
			<div class="life-dashboard" data-testid="life-dashboard">
				<div class="life-dashboard-grid">
					<section class="life-panel" data-testid="life-profile-card">
						@lifeProfileSummary(data)
					</section>
					<section class="life-panel life-radar-wrap" data-testid="life-radar-panel">
						<canvas
							data-testid="life-radar-chart"
							data-labels={ data.RadarLabelsJSON }
							data-values={ data.RadarValuesJSON }
							width="360"
							height="360"
						></canvas>
					</section>
				</div>
				<section class="life-panel" data-testid="life-stats-list">
					<ul class="life-stat-list" data-testid="life-characteristics">
						for _, c := range data.Characteristics {
							<li class="life-stat-row">
								<span class="life-stat-name">
									@lifeStatIcon(c.Code)
									{ LifeCharacteristicLabel(ctx, c.Code, c.Name) }
								</span>
								<div class="life-seg-bar" aria-hidden="true">
									for i := range LifeSegmentIndexes(c.TotalSegs) {
										if i < c.FilledSegs {
											<span class="life-seg is-filled"></span>
										} else {
											<span class="life-seg"></span>
										}
									}
								</div>
								<span class="life-seg-nums">{ fmt.Sprintf("%d / %d", c.Exp, c.ExpToNext) }</span>
								<span class="life-stat-lv">{ i18n.TData(ctx, "life.meta.level_prefix", map[string]any{"Value": fmt.Sprintf("%d", c.Level)}) }</span>
							</li>
						}
					</ul>
				</section>
			</div>
		}
	}
}

templ LifeCharacterPage(data LifeCharacterData) {
	@layout.Base(ctx, DocTitleLife(ctx, "life.page.character.title")) {
		@lifeModuleShell(ctx, "character", data.PendingCount) {
			<div class="life-identity" data-testid="life-character">
				<div class="life-identity-title">
					<div class="life-identity-title-box" data-testid="life-identity-title">{ i18n.T(ctx, "life.page.character.title") }</div>
				</div>
				<section class="life-panel life-profile-panel" data-testid="life-profile-card">
					@lifeProfileSummary(data)
					<form
						hx-post="/service/web/life/character/class"
						hx-swap="none"
						class="life-class-form"
						data-testid="life-class-form"
					>
						<label class="life-field">
							<span class="life-field-label">{ i18n.T(ctx, "life.class.label") }</span>
							<select name="class_type" class="life-field-control" data-testid="life-class-select">
								<option value="Architect" selected?={ data.ClassType == "Architect" }>{ i18n.T(ctx, "life.class.architect") }</option>
								<option value="Mage" selected?={ data.ClassType == "Mage" }>{ i18n.T(ctx, "life.class.mage") }</option>
								<option value="Warrior" selected?={ data.ClassType == "Warrior" }>{ i18n.T(ctx, "life.class.warrior") }</option>
								<option value="Rogue" selected?={ data.ClassType == "Rogue" }>{ i18n.T(ctx, "life.class.rogue") }</option>
							</select>
						</label>
						<button type="submit" class="btn btn-sm btn-primary" data-testid="life-class-save">{ i18n.T(ctx, "life.btn.save") }</button>
					</form>
				</section>
			</div>
		}
	}
}

templ LifeGoalsPage(data LifeGoalsData) {
	@layout.Base(ctx, DocTitleLife(ctx, "life.page.goals.title")) {
		@lifeModuleShell(ctx, "goals", data.PendingCount) {
			<div class="life-shell" data-testid="life-goals-page">
				<header class="life-shell-header">
					<div>
						<h1>{ i18n.T(ctx, "life.page.goals.title") }</h1>
						<p>{ i18n.T(ctx, "life.page.goals.subtitle") }</p>
					</div>
					if len(data.Goals) > 0 {
						<span class="life-section-count">{ fmt.Sprintf("%d", len(data.Goals)) }</span>
					}
				</header>
				<section class="life-panel life-section life-goals" data-testid="life-goals">
					<form
						hx-post="/service/web/life/goals"
						hx-swap="none"
						hx-disabled-elt="find button[type='submit'], find input, find select"
						class="life-goals-compose"
						data-testid="life-goal-form"
						x-data="lifeGoalCompose"
					>
						<input
							name="title"
							class="life-goals-compose-title"
							required
							placeholder={ i18n.T(ctx, "life.goal.title_placeholder") }
							autocomplete="off"
							data-testid="life-goal-title"
						/>
						<select
							name="category"
							class="life-goals-compose-cat"
							data-testid="life-goal-category"
							aria-label={ i18n.T(ctx, "life.category.label") }
							x-model="cat"
						>
							<option value="Project">{ i18n.T(ctx, "life.category.project") }</option>
							<option value="Area">{ i18n.T(ctx, "life.category.area") }</option>
							<option value="Resource">{ i18n.T(ctx, "life.category.resource") }</option>
						</select>
						<select
							name="area_flag"
							class="life-goals-compose-cat life-goals-compose-area"
							data-testid="life-goal-area"
							aria-label={ i18n.T(ctx, "life.category.area_label") }
							x-show="showArea"
							x-bind:disabled="!showArea"
						>
							<option value="">{ i18n.T(ctx, "life.category.no_area") }</option>
							for _, a := range data.ActiveAreas {
								<option value={ a.Flag }>{ a.Title }</option>
							}
						</select>
						<button type="submit" class="btn btn-sm btn-primary life-goals-compose-btn" data-testid="life-goal-create">
							@partials.HtmxIndicator()
							{ i18n.T(ctx, "life.goal.create") }
						</button>
					</form>
					if len(data.Goals) == 0 {
						<p class="life-goals-empty">{ i18n.T(ctx, "life.empty.goals") }</p>
					} else {
						<div class="life-goal-groups" data-testid="life-goal-groups">
							for _, group := range data.Groups {
								<section class="life-goal-group" data-testid={ LifeGoalGroupTestID(group) }>
									if group.Area != nil {
										@lifeGoalCard(*group.Area, data.ActiveAreas)
									} else {
										<h2 class="life-goal-group-title">{ i18n.T(ctx, "life.goal.ungrouped") }</h2>
									}
									if len(group.Children) > 0 {
										<div class="life-goal-list">
											for _, child := range group.Children {
												@lifeGoalCard(child, data.ActiveAreas)
											}
										</div>
									} else if group.Area != nil {
										<p class="life-goal-group-empty">{ i18n.T(ctx, "life.empty.goal_group") }</p>
									}
								</section>
							}
						</div>
					}
					<p class="life-goals-foot">
						{ i18n.TData(ctx, "life.dashboard.bonus", map[string]any{"DropRate": fmt.Sprintf("%.0f", data.DropRateBonus*100), "GoldMult": fmt.Sprintf("%.2f", data.GoldMult)}) }
					</p>
				</section>
			</div>
		}
	}
}

templ lifeGoalCard(g LifeGoalRow, activeAreas []LifeGoalRow) {
	<article
		class={
			"life-goal-card",
			templ.KV("is-area", g.Category == "Area"),
			templ.KV("is-paused", g.Status == "Paused"),
		}
		data-testid={ "life-goal-card-" + g.Flag }
	>
		<form
			hx-post={ "/service/web/life/goals/" + g.Flag }
			hx-swap="none"
			hx-disabled-elt="find button, find input, find select"
			class="life-goal-card-main"
			data-testid={ "life-goal-edit-" + g.Flag }
		>
			<input name="title" class="life-goal-card-title" required value={ g.Title } aria-label={ i18n.T(ctx, "life.goal.title_label") }/>
			<select name="category" class="life-goal-card-cat" aria-label={ i18n.T(ctx, "life.category.label") }>
				<option value="Project" selected?={ g.Category == "Project" }>{ i18n.T(ctx, "life.category.project") }</option>
				<option value="Area" selected?={ g.Category == "Area" }>{ i18n.T(ctx, "life.category.area") }</option>
				<option value="Resource" selected?={ g.Category == "Resource" }>{ i18n.T(ctx, "life.category.resource") }</option>
			</select>
			if g.Category == "Project" || g.Category == "Resource" {
				<select name="area_flag" class="life-goal-card-cat life-goal-card-area" aria-label={ i18n.T(ctx, "life.category.area_label") } data-testid={ "life-goal-area-" + g.Flag }>
					<option value="">{ i18n.T(ctx, "life.category.no_area") }</option>
					for _, a := range LifeGoalAreaOptions(activeAreas, g.AreaFlag, g.AreaTitle) {
						<option value={ a.Flag } selected?={ a.Flag == g.AreaFlag }>{ a.Title }</option>
					}
				</select>
			}
			<button type="submit" class="btn btn-sm life-goal-save" data-testid={ "life-goal-save-" + g.Flag }>
				@partials.HtmxIndicator()
				{ i18n.T(ctx, "life.btn.save") }
			</button>
		</form>
		<div class="life-goal-card-toolbar">
			<span class={ "life-meta-chip", LifeGoalStatusClass(g.Status) }>
				{ LifeGoalStatusLabel(ctx, g.Status) }
			</span>
			if g.Status == "Active" {
				<button
					type="button"
					class="btn btn-ghost btn-sm"
					hx-post={ "/service/web/life/goals/" + g.Flag + "/status" }
					hx-vals='{"status":"Paused"}'
					hx-swap="none"
					data-testid={ "life-goal-pause-" + g.Flag }
				>{ i18n.T(ctx, "life.btn.pause") }</button>
			}
			if g.Status == "Paused" {
				<button
					type="button"
					class="btn btn-ghost btn-sm"
					hx-post={ "/service/web/life/goals/" + g.Flag + "/status" }
					hx-vals='{"status":"Active"}'
					hx-swap="none"
					data-testid={ "life-goal-resume-" + g.Flag }
				>{ i18n.T(ctx, "life.btn.resume") }</button>
			}
			<button
				type="button"
				class="btn btn-ghost btn-sm life-goal-delete"
				hx-post={ "/service/web/life/goals/" + g.Flag + "/delete" }
				hx-swap="none"
				data-confirm={ i18n.T(ctx, "confirm.delete_goal.message") }
				data-confirm-title={ i18n.T(ctx, "confirm.delete_goal.title") }
				data-confirm-btn={ i18n.T(ctx, "confirm.delete_goal.btn") }
				data-confirm-class="btn-error"
				data-testid={ "life-goal-delete-" + g.Flag }
			>{ i18n.T(ctx, "life.btn.delete") }</button>
		</div>
	</article>
}

templ LifePlanPage(data LifePlanData) {
	@layout.Base(ctx, DocTitleLife(ctx, "life.page.plan.title")) {
		@lifeModuleShell(ctx, "plan", data.PendingCount) {
			<div class="life-shell" data-testid="life-plan-page">
				<header class="life-shell-header">
					<div>
						<h1>{ i18n.T(ctx, "life.page.plan.title") }</h1>
						<p>{ i18n.T(ctx, "life.page.plan.subtitle") }</p>
					</div>
					if len(data.PlanTree) > 0 {
						<span class="life-section-count">{ fmt.Sprintf("%d", len(data.PlanTree)) }</span>
					}
				</header>
				<section class="life-panel life-section life-goals" data-testid="life-plan-tree">
					<form
						hx-post="/service/web/life/character/plan/breakdown/preview"
						hx-target="[data-testid='life-plan-tree']"
						hx-select="[data-testid='life-plan-tree']"
						hx-swap="outerHTML"
						class="life-breakdown-compose"
						data-testid="life-breakdown-preview-form"
					>
						<div class="life-breakdown-compose-row">
							<input
								name="root_title"
								class="life-goals-compose-title"
								required
								placeholder={ i18n.T(ctx, "life.plan.breakdown_placeholder") }
								autocomplete="off"
								data-testid="life-breakdown-root-title"
							/>
							<button type="submit" class="btn btn-sm btn-secondary life-goals-compose-btn" data-testid="life-breakdown-preview">
								@partials.HtmxIndicator()
								{ i18n.T(ctx, "life.btn.preview_breakdown") }
							</button>
						</div>
						<textarea
							name="description"
							class="life-goals-compose-title life-plan-compose-textarea"
							rows="2"
							placeholder={ i18n.T(ctx, "life.plan.outcome_placeholder") }
							data-testid="life-breakdown-description"
						></textarea>
					</form>
					if data.BreakdownPreview != nil && data.BreakdownPreview.Tree != nil {
						<div class="life-goal-card" data-testid="life-breakdown-preview-card">
							<div class="life-goal-card-main">
								<div>
									<p class="life-goal-card-title">{ i18n.TData(ctx, "life.plan.ai_suggestion", map[string]any{"Title": data.BreakdownPreview.RootTitle}) }</p>
									if data.BreakdownPreview.Description != "" {
										<p class="life-goals-sub">{ data.BreakdownPreview.Description }</p>
									}
								</div>
							</div>
							<div class="life-goal-list">
								@lifeBreakdownSuggestion(*data.BreakdownPreview.Tree, 0)
							</div>
							<form
								method="post"
								action="/service/web/life/character/plan/breakdown/import"
							>
								<input type="hidden" name="payload_json" value={ data.BreakdownPreview.PayloadJSON }/>
								<button type="submit" class="btn btn-sm btn-primary" data-testid="life-breakdown-import">
									@partials.HtmxIndicator()
									{ i18n.T(ctx, "life.btn.import_suggestion") }
								</button>
							</form>
						</div>
					}
					if len(data.PlanTree) == 0 {
						<p class="life-goals-empty">{ i18n.T(ctx, "life.empty.plan_nodes") }</p>
					} else {
						<div class="life-goal-list">
							for _, node := range data.PlanTree {
								@lifePlanNode(node, 0)
							}
						</div>
					}
				</section>
			</div>
		}
	}
}

templ LifeSkillsPage(data LifeSkillTreeData) {
	@layout.Base(ctx, DocTitleLife(ctx, "life.page.skills.title")) {
		@lifeModuleShell(ctx, "skills", data.PendingCount) {
			<div class="life-shell" data-testid="life-skills-page">
				<header class="life-shell-header">
					<div>
						<h1>{ i18n.T(ctx, "life.page.skills.title") }</h1>
						<p>{ i18n.T(ctx, "life.page.skills.subtitle") }</p>
					</div>
					<div class="life-skills-summary">
						<span class="life-meta-chip">{ i18n.TData(ctx, "life.meta.active_count", map[string]any{"Count": data.ActiveLeafCount}) }</span>
						<span class="life-meta-chip">{ i18n.TData(ctx, "life.meta.tracked_count", map[string]any{"Count": data.TrackedLeafCount}) }</span>
					</div>
				</header>
				<div class="life-skills-grid">
					<section class="life-panel life-section life-skills-tree-panel" data-testid="life-skills-tree">
						<header class="life-goals-head">
							<div>
								<h2 class="life-goals-title">{ i18n.T(ctx, "life.skills.growth_map") }</h2>
								<p class="life-goals-sub">{ i18n.T(ctx, "life.skills.growth_map_sub") }</p>
							</div>
						</header>
						if len(data.Roots) == 0 {
							<p class="life-goals-empty">{ i18n.T(ctx, "life.empty.skills") }</p>
						} else {
							<div class="life-skill-node-list">
								for _, node := range data.Roots {
									@lifeSkillTreeNode(node, 0)
								}
							</div>
						}
					</section>
					<section class="life-panel life-section life-skills-detail-panel" data-testid="life-skill-detail">
						<header class="life-goals-head">
							<div>
								<h2 class="life-goals-title">{ i18n.T(ctx, "life.skills.practice_evidence") }</h2>
								<p class="life-goals-sub">{ i18n.T(ctx, "life.skills.practice_evidence_sub") }</p>
							</div>
						</header>
						if data.SelectedNode == nil {
							<p class="life-goals-empty">{ i18n.T(ctx, "life.empty.skill_evidence") }</p>
						} else {
							<div class="life-goal-card life-skill-detail-card">
								<div class="life-goal-card-main life-skill-detail-main">
									<div class="life-skill-detail-head">
										<span class="life-skill-detail-badge" aria-hidden="true">{ LifeSkillMonogram(data.SelectedNode.Title) }</span>
										<div>
											<p class="life-skill-detail-title">{ data.SelectedNode.Title }</p>
											if data.SelectedNode.Subtitle != "" {
												<p class="life-skill-detail-subtitle">{ data.SelectedNode.Subtitle }</p>
											}
										</div>
									</div>
									<div class="life-goal-card-meta">
										<span class={ "life-meta-chip", LifeSkillStatusClass(data.SelectedNode.Status) }>{ LifeSkillStatusLabel(ctx, data.SelectedNode.Status) }</span>
										<span class="life-meta-chip">{ i18n.TData(ctx, "life.meta.records_count", map[string]any{"Count": data.SelectedNode.PracticeCount}) }</span>
										<span class="life-meta-chip">{ i18n.TData(ctx, "life.meta.skills_count", map[string]any{"Count": data.SelectedNode.SkillCount}) }</span>
									</div>
								</div>
								if data.SelectedNode.LastActivityLabel != "" {
									<p class="life-skill-detail-foot">{ i18n.TData(ctx, "life.skills.last_activity", map[string]any{"Label": data.SelectedNode.LastActivityLabel}) }</p>
								}
							</div>
							if len(data.SelectedNode.Evidence) == 0 {
								<p class="life-goals-empty">{ i18n.T(ctx, "life.empty.skill_evidence_node") }</p>
							} else {
								<ul class="life-skill-evidence-list">
									for _, evidence := range data.SelectedNode.Evidence {
										<li class="life-goal-card life-skill-evidence-card">
											<div class="life-goal-card-main life-skill-evidence-main">
												<div class="life-skill-evidence-head">
													<span class="life-skill-evidence-badge" aria-hidden="true">{ LifeSkillMonogram(evidence.Title) }</span>
													<div>
														<p class="life-skill-evidence-title">{ evidence.Title }</p>
														if evidence.Detail != "" {
															<p class="life-skill-evidence-detail">{ evidence.Detail }</p>
														}
													</div>
												</div>
												<div class="life-goal-card-meta">
													<span class="life-meta-chip">{ LifeEvidenceSourceTypeLabel(ctx, evidence.SourceType) }</span>
													<span class="life-meta-chip">{ evidence.When }</span>
												</div>
											</div>
										</li>
									}
								</ul>
							}
						}
					</section>
				</div>
			</div>
		}
	}
}

templ lifePlanNode(node LifePlanNodeRow, depth int) {
	if len(node.Children) > 0 {
		<details class="life-tree-node life-tree-branch" style={ LifeIndentStyle(depth) } open?={ depth > 0 && depth < 2 } data-testid={ "life-plan-node-" + node.Flag }>
			<summary class="life-tree-summary">
				<div class="life-goal-card-main">
					<div>
						<p class="life-tree-title">{ node.Title }</p>
						if node.Description != "" {
							<p class="life-tree-description">{ node.Description }</p>
						}
					</div>
					<div class="life-goal-card-meta">
						<span class="life-meta-chip">{ LifePlanNodeTypeLabel(ctx, node.NodeType) }</span>
						<span class="life-meta-chip">{ i18n.TData(ctx, "life.meta.items_count", map[string]any{"Count": len(node.Children)}) }</span>
						if node.TaskType != "" {
							<span class="life-meta-chip">{ LifeTaskTypeLabel(ctx, node.TaskType) }</span>
						}
					</div>
				</div>
			</summary>
			<div class="life-tree-children">
				for _, child := range node.Children {
					@lifePlanNode(child, depth + 1)
				}
			</div>
		</details>
	} else {
		<div class="life-tree-node life-goal-card" style={ LifeIndentStyle(depth) } data-testid={ "life-plan-node-" + node.Flag }>
			<div class="life-goal-card-main">
				<div>
					<p class="life-tree-title">{ node.Title }</p>
					if node.Description != "" {
						<p class="life-tree-description">{ node.Description }</p>
					}
				</div>
				<div class="life-goal-card-meta">
					<span class="life-meta-chip">{ LifePlanNodeTypeLabel(ctx, node.NodeType) }</span>
					if node.TaskType != "" {
						<span class="life-meta-chip">{ LifeTaskTypeLabel(ctx, node.TaskType) }</span>
					}
					if node.SuggestedCadence != "" {
						<span class="life-meta-chip">{ i18n.TDefault(ctx, "life.cadence."+strings.ToLower(node.SuggestedCadence), node.SuggestedCadence) }</span>
					}
					if node.TrackingMode != "" && node.TaskType != "" {
						<span class="life-meta-chip">{ LifeTrackingModeLabel(ctx, node.TrackingMode) }</span>
					}
					if node.Exp > 0 {
						<span class="life-quest-reward"><strong>{ i18n.TData(ctx, "life.reward.exp", map[string]any{"Value": node.Exp}) }</strong></span>
					}
					if node.Gold > 0 {
						<span class="life-quest-reward"><strong>{ i18n.TData(ctx, "life.reward.gold", map[string]any{"Value": node.Gold}) }</strong></span>
					}
				</div>
			</div>
			if node.NeedsConfirmation {
				<div class="life-goal-actions">
					<button
						type="button"
						class="life-goal-link"
						hx-post={ "/service/web/life/character/plan/" + node.Flag + "/confirm-habit" }
						hx-swap="none"
						data-testid={ "life-plan-confirm-" + node.Flag }
					>{ i18n.T(ctx, "life.btn.confirm_habit") }</button>
				</div>
			}
		</div>
	}
}

templ lifeBreakdownSuggestion(node LifeBreakdownSuggestionRow, depth int) {
	<div class="life-goal-card" style={ LifeIndentStyle(depth) } data-testid={ "life-breakdown-node-" + node.Title }>
		<div class="life-goal-card-main">
			<div>
				<p class="life-goal-card-title">{ node.Title }</p>
				if node.Description != "" {
					<p class="life-goals-sub">{ node.Description }</p>
				}
			</div>
			<div class="life-goal-card-meta">
				<span class="life-meta-chip">{ LifePlanNodeTypeLabel(ctx, node.NodeType) }</span>
				if node.TaskType != "" {
					<span class="life-meta-chip">{ LifeTaskTypeLabel(ctx, node.TaskType) }</span>
				}
				if node.SuggestedCadence != "" {
					<span class="life-meta-chip">{ i18n.TDefault(ctx, "life.cadence."+strings.ToLower(node.SuggestedCadence), node.SuggestedCadence) }</span>
				}
				if node.Difficulty != "" {
					<span class="life-meta-chip">{ node.Difficulty }</span>
				}
				if node.Exp > 0 {
					<span class="life-quest-reward"><strong>{ i18n.TData(ctx, "life.reward.exp", map[string]any{"Value": node.Exp}) }</strong></span>
				}
				if node.Gold > 0 {
					<span class="life-quest-reward"><strong>{ i18n.TData(ctx, "life.reward.gold", map[string]any{"Value": node.Gold}) }</strong></span>
				}
			</div>
		</div>
	</div>
	for _, child := range node.Children {
		@lifeBreakdownSuggestion(child, depth + 1)
	}
}

templ lifeModuleShell(ctx context.Context, active string, pendingCount int) {
	<div class="life-module" data-testid="life-module">
		<aside class="life-sidebar" aria-label={ i18n.T(ctx, "life.nav.aria_label") }>
			<p class="life-sidebar-brand">{ i18n.T(ctx, "life.brand") }</p>
			<nav class="life-sidebar-nav">
				<a
					href="/service/web/life"
					class={ "life-sidebar-link", templ.KV("is-active", active == "life") }
					data-testid="life-goto-home"
				>{ i18n.T(ctx, "nav.life") }</a>
				<a
					href="/service/web/life/quests"
					class={ "life-sidebar-link", templ.KV("is-active", active == "quests") }
					data-testid="life-goto-quests"
				>
					{ i18n.T(ctx, "nav.quests") }
					if pendingCount > 0 {
						<span class="life-sidebar-badge">{ fmt.Sprintf("%d", pendingCount) }</span>
					}
				</a>
				<a
					href="/service/web/life/rewards"
					class={ "life-sidebar-link", templ.KV("is-active", active == "rewards") }
					data-testid="life-goto-rewards"
				>{ i18n.T(ctx, "nav.rewards") }</a>
				<a
					href="/service/web/life/skills"
					class={ "life-sidebar-link", templ.KV("is-active", active == "skills") }
					data-testid="life-goto-skills"
				>{ i18n.T(ctx, "nav.skills") }</a>
				<a
					href="/service/web/life/inventory"
					class={ "life-sidebar-link", templ.KV("is-active", active == "inventory") }
					data-testid="life-goto-inventory"
				>{ i18n.T(ctx, "nav.inventory") }</a>
				<a
					href="/service/web/life/goals"
					class={ "life-sidebar-link", templ.KV("is-active", active == "goals") }
					data-testid="life-goto-goals"
				>{ i18n.T(ctx, "life.nav.goals") }</a>
				<a
					href="/service/web/life/plan"
					class={ "life-sidebar-link", templ.KV("is-active", active == "plan") }
					data-testid="life-goto-plan"
				>{ i18n.T(ctx, "life.nav.plan") }</a>
				<a
					href="/service/web/life/stats"
					class={ "life-sidebar-link", templ.KV("is-active", active == "stats") }
					data-testid="life-goto-stats"
				>{ i18n.T(ctx, "nav.stats") }</a>
				<a
					href="/service/web/life/character"
					class={ "life-sidebar-link", templ.KV("is-active", active == "character") }
					data-testid="life-goto-character"
				>{ i18n.T(ctx, "nav.character") }</a>
				<a
					href="/service/web/life/achievements"
					class={ "life-sidebar-link", templ.KV("is-active", active == "achievements") }
					data-testid="life-goto-achievements"
				>{ i18n.T(ctx, "nav.achievements") }</a>
			</nav>
		</aside>
		<div class="life-module-main">
			{ children... }
		</div>
	</div>
}

templ lifeSkillTreeNode(node LifeSkillTreeNodeRow, depth int) {
	if len(node.Children) > 0 {
		<details class="life-tree-node life-tree-branch" style={ LifeIndentStyle(depth) } open?={ LifeSkillTreeBranchOpen(node) } data-testid={ "life-skill-node-" + node.Key }>
			<summary class="life-tree-summary">
				@lifeSkillTreeNodeCard(node)
			</summary>
			<div class="life-tree-children">
				for _, child := range node.Children {
					@lifeSkillTreeNode(child, depth + 1)
				}
			</div>
		</details>
	} else {
		<div class="life-tree-node life-goal-card" style={ LifeIndentStyle(depth) } data-testid={ "life-skill-node-" + node.Key }>
			@lifeSkillTreeNodeCard(node)
		</div>
	}
}

templ lifeSkillTreeNodeCard(node LifeSkillTreeNodeRow) {
	<a
		href={ "/service/web/life/skills?node=" + node.Key }
		class={ "life-skill-node-link", templ.KV("is-selected", node.IsSelected) }
	>
		<div class="life-skill-node-main">
			<span class="life-skill-node-badge" aria-hidden="true">{ LifeSkillMonogram(node.Title) }</span>
			<div class="life-skill-node-copy">
				<p class="life-tree-title">{ node.Title }</p>
				if node.Subtitle != "" {
					<p class="life-tree-description">{ node.Subtitle }</p>
				}
			</div>
		</div>
		<div class="life-goal-card-meta life-skill-node-meta">
			<span class={ "life-meta-chip", LifeSkillStatusClass(node.Status) }>{ LifeSkillStatusLabel(ctx, node.Status) }</span>
			<span class="life-meta-chip">{ i18n.TData(ctx, "life.meta.records_count", map[string]any{"Count": node.PracticeCount}) }</span>
			if node.SkillCount > 0 {
				<span class="life-meta-chip">{ i18n.TData(ctx, "life.meta.skills_count", map[string]any{"Count": node.SkillCount}) }</span>
			}
			if node.LastActivityLabel != "" {
				<span class="life-meta-chip">{ node.LastActivityLabel }</span>
			}
		</div>
	</a>
}

templ lifeProfileSummary(data LifeCharacterData) {
	<div class="life-avatar" aria-hidden="true">
		<img
			src="/static/img/life-avatar.svg"
			alt=""
			width="120"
			height="120"
			data-testid="life-avatar-img"
		/>
	</div>
	<p class="life-meta-line" data-testid="life-meta-line">
		<span data-testid="life-nickname">{ data.Nickname }</span>
		<span class="life-meta-sep">•</span>
		<span data-testid="life-level">{ i18n.TData(ctx, "life.profile.level", map[string]any{"Value": data.Level}) }</span>
		<span class="life-meta-sep">•</span>
		<span data-testid="life-gold">{ i18n.TData(ctx, "life.profile.coins", map[string]any{"Count": data.Gold}) }</span>
	</p>
	<div class="life-hp-row" data-testid="life-hp-row">
		<span class="life-hp-label">{ i18n.T(ctx, "life.profile.hp_label") }</span>
		<span class="life-hearts" aria-hidden="true">
			for i := range LifeSegmentIndexes(data.HeartsTotal) {
				if i < data.HeartsFilled {
					<svg class="life-heart is-filled" viewBox="0 0 16 16" fill="currentColor"><path d="M8 14s-5.5-3.3-7-6.2C-.2 5.4.8 2.8 3.2 2.3 4.7 2 6.1 2.8 8 4.6c1.9-1.8 3.3-2.6 4.8-2.3 2.4.5 3.4 3.1 2.2 5.5C13.5 10.7 8 14 8 14z"/></svg>
				} else {
					<svg class="life-heart" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M8 14s-5.5-3.3-7-6.2C-.2 5.4.8 2.8 3.2 2.3 4.7 2 6.1 2.8 8 4.6c1.9-1.8 3.3-2.6 4.8-2.3 2.4.5 3.4 3.1 2.2 5.5C13.5 10.7 8 14 8 14z"/></svg>
				}
			}
		</span>
		<span class="life-hp-nums" data-testid="life-hp">{ fmt.Sprintf("%d / %d", data.HPCurrent, data.HPMax) }</span>
	</div>
	<ul class="life-trait-list">
		<li class="life-trait-row">
			<span class="life-trait-label">{ i18n.T(ctx, "life.profile.master_objective") }</span>
			<span class="life-trait-value" data-testid="life-master-objective">{ data.MasterObjective }</span>
		</li>
		<li class="life-trait-row">
			<span class="life-trait-label">{ i18n.T(ctx, "life.profile.minor_objective") }</span>
			<span class="life-trait-value" data-testid="life-minor-objective">{ data.MinorObjective }</span>
		</li>
		<li class="life-trait-row">
			<span class="life-trait-label">{ i18n.T(ctx, "life.profile.strength") }</span>
			<span class="life-trait-value" data-testid="life-strength">{ data.Strength }</span>
		</li>
		<li class="life-trait-row">
			<span class="life-trait-label">{ i18n.T(ctx, "life.profile.weaknesses") }</span>
			<span class="life-trait-value" data-testid="life-weakness">{ data.Weakness }</span>
		</li>
	</ul>
	<div class="life-level-row" data-testid="life-level-progress">
		<span class="life-level-label">{ i18n.T(ctx, "life.profile.level_up") }</span>
		<div class="life-seg-bar" aria-hidden="true">
			for i := range LifeSegmentIndexes(data.LevelTotalSegs) {
				if i < data.LevelFilledSegs {
					<span class="life-seg is-filled"></span>
				} else {
					<span class="life-seg"></span>
				}
			}
		</div>
		<span class="life-seg-nums">{ fmt.Sprintf("%d / %d", data.Exp, data.ExpToNext) }</span>
	</div>
}

templ lifeStatIcon(code string) {
	switch code {
		case "PHY":
			<svg class="life-stat-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 3c-2 3-6 5-6 10a6 6 0 0 0 12 0c0-5-4-7-6-10z"/><path d="M12 13v7"/></svg>
		case "INT":
			<svg class="life-stat-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M9 18h6"/><path d="M10 21h4"/><path d="M12 3a7 7 0 0 1 4 12c-.8.7-1.2 1.5-1.4 2.5H9.4C9.2 16.5 8.8 15.7 8 15a7 7 0 0 1 4-12z"/></svg>
		case "WIL":
			<svg class="life-stat-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 3l2.2 6.6H21l-5.4 4 2.1 6.4L12 16.8 6.3 20l2.1-6.4L3 9.6h6.8L12 3z"/></svg>
		case "CHA":
			<svg class="life-stat-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="9" cy="8" r="3"/><circle cx="16" cy="9" r="2.5"/><path d="M3 19c1.5-3 4-4.5 6-4.5s4.5 1.5 6 4.5"/><path d="M13 19c.7-1.8 2-3 3.5-3 1.8 0 3.2 1.2 4.5 3"/></svg>
		case "CRE":
			<svg class="life-stat-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M9 18h6"/><path d="M12 2v2"/><path d="M12 14a4 4 0 0 0 4-4 4.2 4.2 0 0 0-2.5-3.8L12 2l-1.5 4.2A4.2 4.2 0 0 0 8 10a4 4 0 0 0 4 4z"/><path d="M10 22h4"/></svg>
		case "FIN":
			<svg class="life-stat-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="8"/><path d="M12 7v10"/><path d="M9.5 9.5c.5-1 1.5-1.5 2.5-1.5 1.4 0 2.5.8 2.5 2s-1.1 2-2.5 2-2.5.8-2.5 2 1.1 2 2.5 2c1 0 2-.5 2.5-1.5"/></svg>
		case "WRI":
			<svg class="life-stat-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 19.5V5a2 2 0 0 1 2-2h9l5 5v11.5a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 4 19.5z"/><path d="M14 3v5h5"/><path d="M8 13h8"/><path d="M8 17h6"/></svg>
		case "FOC":
			<svg class="life-stat-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="3"/><circle cx="12" cy="12" r="8"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="M2 12h2"/><path d="M20 12h2"/></svg>
		default:
			<svg class="life-stat-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="8"/></svg>
	}
}

templ lifeListPager(info LifePageInfo, testID string) {
	if info.TotalPages > 1 {
		<nav class="life-pager" data-testid={ testID }>
			if info.HasPrev {
				<a class="life-pager-btn" href={ templ.URL(info.PrevURL) } data-testid={ testID + "-prev" }>{ i18n.T(ctx, "life.btn.prev") }</a>
			} else {
				<span class="life-pager-btn is-disabled" aria-disabled="true">{ i18n.T(ctx, "life.btn.prev") }</span>
			}
			<span class="life-pager-status">
				{ i18n.TData(ctx, "life.pager.page_of", map[string]any{"Page": info.Page, "Total": info.TotalPages}) }
			</span>
			if info.HasNext {
				<a class="life-pager-btn" href={ templ.URL(info.NextURL) } data-testid={ testID + "-next" }>{ i18n.T(ctx, "life.btn.next") }</a>
			} else {
				<span class="life-pager-btn is-disabled" aria-disabled="true">{ i18n.T(ctx, "life.btn.next") }</span>
			}
		</nav>
	}
}

templ LifeQuestsPage(data LifeQuestsData) {
	@layout.Base(ctx, DocTitleLife(ctx, "life.page.quests.title")) {
		@lifeModuleShell(ctx, "quests", data.PendingCount) {
			<div class="life-shell" data-testid="life-quests-page">
				<header class="life-shell-header">
					<div>
						<h1>{ i18n.T(ctx, "life.page.quests.title") }</h1>
						<p>{ i18n.T(ctx, "life.page.quests.subtitle") }</p>
					</div>
				</header>

				<section class="life-panel life-section life-composer">
					<form
						hx-post="/service/web/life/quests"
						hx-swap="none"
						hx-disabled-elt="find button[type='submit'], find textarea, find select"
						data-testid="life-quest-form"
					>
						<label class="form-control w-full">
							<span class="label-text text-xs font-medium tracking-wide uppercase opacity-70">{ i18n.T(ctx, "life.quest.what_will_you_do") }</span>
							<textarea
								name="prompt"
								class="textarea textarea-bordered w-full mt-1"
								rows="3"
								required
								placeholder={ i18n.T(ctx, "life.quest.prompt_placeholder") }
								data-testid="life-quest-prompt"
							></textarea>
						</label>
						if len(data.Goals) > 0 {
							<label class="form-control w-full mt-2">
								<span class="label-text text-xs font-medium tracking-wide uppercase opacity-70">{ i18n.T(ctx, "life.quest.link_goal") }</span>
								<select name="goal_flag" class="select select-bordered select-sm w-full mt-1" data-testid="life-quest-goal">
									<option value="">{ i18n.T(ctx, "life.quest.link_goal_none") }</option>
									for _, g := range data.Goals {
										<option value={ g.Flag }>{ LifeGoalCategoryLabel(ctx, g.Category) }: { g.Title }</option>
									}
								</select>
							</label>
						}
						<div class="life-composer-actions">
							<p class="life-composer-hint">{ i18n.T(ctx, "life.quest.composer_hint") }</p>
							<button type="submit" class="btn btn-primary btn-sm" data-testid="life-quest-create">
								@partials.HtmxIndicator()
								{ i18n.T(ctx, "life.btn.create") }
							</button>
						</div>
					</form>
				</section>

			<section class="life-panel life-section">
				<div class="life-section-head">
					<h2>{ i18n.T(ctx, "life.quest.today_actions") }</h2>
					<span class="life-section-count">{ fmt.Sprintf("%d", len(data.TodayActions)) }</span>
				</div>
				if len(data.TodayActions) == 0 {
					<p class="life-empty">{ i18n.T(ctx, "life.empty.today_actions") }</p>
				} else {
					<ul class="life-quest-list life-action-list" data-testid="life-today-actions">
						for _, a := range data.TodayActions {
							<li class="life-quest-card life-action-card">
								<div class="life-quest-card-body life-action-body">
									<p class="life-quest-title">{ a.Title }</p>
									if a.ContextPath != "" {
										<p class="life-quest-prompt life-action-context">{ a.ContextPath }</p>
									}
									if a.Description != "" {
										<p class="life-action-description">{ a.Description }</p>
									}
									<div class="life-quest-meta life-action-meta">
										<span class="life-meta-chip">{ LifeTaskTypeLabel(ctx, a.TaskType) }</span>
										<span class="life-meta-chip">{ LifeOccurrenceKindLabel(ctx, a.Kind) }</span>
										if a.SuggestedCadence != "" {
											<span class="life-meta-chip">{ i18n.TDefault(ctx, "life.cadence."+strings.ToLower(a.SuggestedCadence), a.SuggestedCadence) }</span>
										}
										if a.TrackingMode != "" {
											<span class="life-meta-chip">{ LifeTrackingModeLabel(ctx, a.TrackingMode) }</span>
										}
										if a.Difficulty != "" {
											<span class="life-meta-chip">{ a.Difficulty }</span>
										}
										if a.Exp > 0 {
											<span class="life-quest-reward"><strong>{ i18n.TData(ctx, "life.reward.exp", map[string]any{"Value": a.Exp}) }</strong></span>
										}
										if a.Gold > 0 {
											<span class="life-quest-reward"><strong>{ i18n.TData(ctx, "life.reward.gold", map[string]any{"Value": a.Gold}) }</strong></span>
										}
										if a.DueLabel != "" {
											<span class="life-meta-chip">{ i18n.TData(ctx, "life.meta.due", map[string]any{"Label": a.DueLabel}) }</span>
										}
									</div>
								</div>
								<div class="life-quest-actions life-action-actions">
									<button type="button" class="btn btn-sm btn-primary" hx-post={ "/service/web/life/actions/" + a.Flag + "/complete" } hx-swap="none" data-testid={ "life-action-complete-" + a.Flag }>
										@partials.HtmxIndicator()
										{ i18n.T(ctx, "life.btn.complete") }
									</button>
									<button type="button" class="btn btn-sm btn-ghost" hx-post={ "/service/web/life/actions/" + a.Flag + "/skip" } hx-swap="none" data-testid={ "life-action-skip-" + a.Flag }>
										@partials.HtmxIndicator()
										{ i18n.T(ctx, "life.btn.skip") }
									</button>
								</div>
							</li>
						}
					</ul>
				}
			</section>

			<section class="life-panel life-section">
				<div class="life-section-head">
					<h2>{ i18n.T(ctx, "life.quest.today_habits") }</h2>
					<span class="life-section-count">{ fmt.Sprintf("%d", len(data.TodayHabits)) }</span>
				</div>
				if len(data.TodayHabits) == 0 {
					<p class="life-empty">{ i18n.T(ctx, "life.empty.today_habits") }</p>
				} else {
					<ul class="life-done-list" data-testid="life-today-habits">
						for _, h := range data.TodayHabits {
							<li class="life-done-row">
								<div class="life-done-main">
									<span class="life-done-title">{ h.Title }</span>
									<div class="life-quest-meta">
										<span class="life-meta-chip">{ LifeTaskTypeLabel(ctx, h.TaskType) }</span>
										if h.SuggestedCadence != "" {
											<span class="life-meta-chip">{ i18n.TDefault(ctx, "life.cadence."+strings.ToLower(h.SuggestedCadence), h.SuggestedCadence) }</span>
										}
										if h.CheckedIn {
											<span class="life-meta-chip">{ i18n.T(ctx, "life.meta.done_today") }</span>
										}
									</div>
								</div>
								<div class="life-quest-actions">
									if !h.CheckedIn {
										<button type="button" class="btn btn-sm btn-primary" hx-post={ "/service/web/life/habits/" + h.NodeFlag + "/checkin" } hx-swap="none" data-testid={ "life-habit-checkin-" + h.NodeFlag }>
											@partials.HtmxIndicator()
											{ i18n.T(ctx, "life.btn.check_in") }
										</button>
									}
								</div>
							</li>
						}
					</ul>
				}
			</section>

			<section class="life-panel life-section">
				<div class="life-section-head">
					<h2>{ i18n.T(ctx, "life.quest.pending") }</h2>
					<span class="life-section-count" data-testid="life-pending-count">{ fmt.Sprintf("%d", len(data.Pending)) }</span>
				</div>
				if len(data.Pending) == 0 {
					<p class="life-empty">{ i18n.T(ctx, "life.empty.quests_pending") }</p>
				} else {
					<ul class="life-quest-list" data-testid="life-quests-pending">
						for _, q := range data.Pending {
							<li class="life-quest-card life-quest-card-dm">
								<div class="life-quest-card-body">
									<p class="life-quest-title">{ q.Title }</p>
									if q.Prompt != "" {
										<p class="life-quest-prompt" title={ q.Prompt }>{ q.Prompt }</p>
									}
									<div class="life-quest-meta">
										<span class="life-meta-chip">{ LifeQuestTypeLabel(ctx, q.Type) }</span>
										<span class="life-meta-chip life-meta-chip-diff">{ q.Difficulty }</span>
										<span class="life-meta-chip">{ i18n.TData(ctx, "life.quest.fear", map[string]any{"Value": q.Fear}) }</span>
										<span class={ "life-meta-chip", "life-rarity-chip", LifeRarityClass(q.DropTier) }>{ LifeRarityLabel(ctx, q.DropTier) }</span>
									</div>
									<div class="life-quest-rewards">
										<span class="life-quest-reward"><strong>{ i18n.TData(ctx, "life.reward.exp", map[string]any{"Value": q.Exp}) }</strong></span>
										<span class="life-quest-reward"><strong>{ i18n.TData(ctx, "life.reward.gold", map[string]any{"Value": q.Gold}) }</strong></span>
										<span class="life-quest-reward"><strong>{ i18n.TData(ctx, "life.quest.drop_chance", map[string]any{"Percent": fmt.Sprintf("%.0f", q.DropChance*100)}) }</strong></span>
									</div>

									<section class="life-quest-evidence">
										<header class="life-quest-block-head">
											<span>{ i18n.T(ctx, "life.quest.evidence") }</span>
											<span class="life-section-count">{ fmt.Sprintf("%d", len(q.Evidence)) }</span>
										</header>
										if len(q.Evidence) == 0 {
											<p class="life-empty">{ i18n.T(ctx, "life.empty.quest_evidence") }</p>
										} else {
											<ul class="life-quest-evidence-list">
												for _, ev := range q.Evidence {
													<li class="life-quest-evidence-row">
														<div class="life-quest-evidence-main">
															<span class="life-meta-chip">{ LifeEvidenceSourceTypeLabel(ctx, ev.SourceType) }</span>
															<p class="life-quest-evidence-content">{ ev.Content }</p>
															if ev.SourceURL != "" {
																<a href={ templ.URL(ev.SourceURL) } class="life-quest-evidence-link" target="_blank" rel="noreferrer">{ i18n.T(ctx, "life.quest.open_source") }</a>
															}
														</div>
														<span class="life-quest-evidence-when">{ ev.When }</span>
													</li>
												}
											</ul>
										}
									</section>

									<form
										hx-post={ "/service/web/life/quests/" + q.Flag + "/evidence" }
										hx-swap="none"
										hx-disabled-elt="find button[type='submit'], find textarea, find input, find select"
										class="life-quest-evidence-form"
									>
										<label class="life-quest-field">
											<span class="life-quest-field-label">{ i18n.T(ctx, "life.quest.submit_evidence") }</span>
											<textarea
												name="content"
												class="life-quest-textarea"
												rows="3"
												required
												placeholder={ i18n.T(ctx, "life.quest.evidence_placeholder") }
											></textarea>
										</label>
										<div class="life-quest-field-grid">
											<label class="life-quest-field">
												<span class="life-quest-field-label">{ i18n.T(ctx, "life.quest.evidence_type") }</span>
												<select name="source_type" class="life-quest-select">
													<option value="note">{ i18n.T(ctx, "life.quest.evidence_type_note") }</option>
													<option value="link">{ i18n.T(ctx, "life.quest.evidence_type_link") }</option>
													<option value="artifact">{ i18n.T(ctx, "life.quest.evidence_type_artifact") }</option>
												</select>
											</label>
											<label class="life-quest-field">
												<span class="life-quest-field-label">{ i18n.T(ctx, "life.quest.source_url") }</span>
												<input name="source_url" class="life-quest-input" placeholder="https://..." />
											</label>
										</div>
										<div class="life-quest-toolbar">
											<button type="submit" class="btn btn-sm btn-outline" data-testid={ "life-quest-add-evidence-" + q.Flag }>
												@partials.HtmxIndicator()
												{ i18n.T(ctx, "life.quest.add_evidence") }
											</button>
											<button
												type="button"
												class="btn btn-sm btn-primary"
												hx-post={ "/service/web/life/quests/" + q.Flag + "/adjudicate" }
												hx-swap="none"
												hx-disabled-elt="this"
												data-testid={ "life-quest-adjudicate-" + q.Flag }
											>
												@partials.HtmxIndicator()
												{ i18n.T(ctx, "life.quest.request_ruling") }
											</button>
										</div>
									</form>

									if q.Adjudication != nil {
										<section class="life-quest-ruling">
											<div class="life-quest-meta">
												<span class={ "life-meta-chip", LifeVerdictChipClass(q.Adjudication.Verdict) }>{ LifeVerdictLabel(ctx, q.Adjudication.Verdict) }</span>
												<span class="life-meta-chip">{ LifeAdjudicationStatusLabel(ctx, q.Adjudication.Status) }</span>
												<span class="life-meta-chip">{ q.Adjudication.When }</span>
											</div>
											<p class="life-quest-ruling-reason">{ q.Adjudication.Reason }</p>
											<div class="life-quest-rewards">
												<span class="life-quest-reward"><strong>{ i18n.TData(ctx, "life.quest.suggested_exp", map[string]any{"Value": q.Adjudication.SuggestedExp}) }</strong></span>
												<span class="life-quest-reward"><strong>{ i18n.TData(ctx, "life.quest.suggested_gold", map[string]any{"Value": q.Adjudication.SuggestedGold}) }</strong></span>
											</div>
											if len(q.Adjudication.SuggestedNextSteps) > 0 {
												<ul class="life-quest-ruling-steps">
													for _, step := range q.Adjudication.SuggestedNextSteps {
														<li>{ step }</li>
													}
												</ul>
											}
										</section>
									}

									<div class="life-quest-toolbar life-quest-card-actions">
										if q.Adjudication != nil && q.Adjudication.Status == "suggested" {
											<button
												type="button"
												class="btn btn-sm btn-primary"
												hx-post={ "/service/web/life/quests/" + q.Flag + "/adjudication/" + q.Adjudication.Flag + "/apply" }
												hx-swap="none"
												hx-disabled-elt="this"
												data-testid={ "life-quest-apply-" + q.Flag }
											>
												@partials.HtmxIndicator()
												{ i18n.T(ctx, "life.quest.apply_ruling") }
											</button>
										}
										<button
											type="button"
											class="btn btn-sm btn-ghost"
											hx-post={ "/service/web/life/quests/" + q.Flag + "/dismiss" }
											hx-swap="none"
											hx-disabled-elt="this"
											data-confirm={ i18n.T(ctx, "confirm.dismiss_quest.message") }
											data-confirm-title={ i18n.T(ctx, "confirm.dismiss_quest.title") }
											data-confirm-btn={ i18n.T(ctx, "confirm.dismiss_quest.btn") }
											data-testid={ "life-quest-dismiss-" + q.Flag }
										>
											@partials.HtmxIndicator()
											{ i18n.T(ctx, "life.btn.dismiss") }
										</button>
									</div>
								</div>
							</li>
						}
					</ul>
				}
			</section>

			<section id={ LifeHistoryAnchor } class="life-panel life-section life-anchor-target" data-testid="life-history-section">
				<div class="life-tabs" role="tablist" aria-label={ i18n.T(ctx, "life.quest.completed") } data-testid="life-history-tabs">
					<a
						role="tab"
						class={ LifeHistoryTabClass(data.HistoryTab, LifeHistoryTabCompleted) }
						href={ templ.URL(LifeQuestsListURL(data.CompletedPage.Page, data.ActionLogsPage.Page, LifeHistoryTabCompleted, LifeHistoryAnchor)) }
						if data.HistoryTab == LifeHistoryTabCompleted {
							aria-selected="true"
						} else {
							aria-selected="false"
						}
						data-testid="life-history-tab-completed"
					>
						{ i18n.T(ctx, "life.quest.completed") }
						<span class="life-tab-count">{ fmt.Sprintf("%d", data.CompletedPage.Total) }</span>
					</a>
					<a
						role="tab"
						class={ LifeHistoryTabClass(data.HistoryTab, LifeHistoryTabActionLogs) }
						href={ templ.URL(LifeQuestsListURL(data.CompletedPage.Page, data.ActionLogsPage.Page, LifeHistoryTabActionLogs, LifeHistoryAnchor)) }
						if data.HistoryTab == LifeHistoryTabActionLogs {
							aria-selected="true"
						} else {
							aria-selected="false"
						}
						data-testid="life-history-tab-logs"
					>
						{ i18n.T(ctx, "life.quest.completions_log") }
						<span class="life-tab-count">{ fmt.Sprintf("%d", data.ActionLogsPage.Total) }</span>
					</a>
				</div>

				<div
					role="tabpanel"
					class="life-tab-panel"
					id="life-history-completed"
					data-testid="life-quests-completed-section"
					if data.HistoryTab != LifeHistoryTabCompleted {
						hidden
					}
				>
					if len(data.Completed) == 0 {
						<p class="life-empty">{ i18n.T(ctx, "life.empty.quest_completed") }</p>
					} else {
						<ul class="life-done-list" data-testid="life-quests-completed">
							for _, q := range data.Completed {
								<li class="life-done-row">
									<div class="life-done-main">
										<span class="life-done-title" title={ q.Title }>{ q.Title }</span>
										if q.Prompt != "" {
											<span class="life-done-prompt" title={ q.Prompt }>{ q.Prompt }</span>
										}
									</div>
									<div class="life-done-meta">
										<span class="life-quest-reward"><strong>{ i18n.TData(ctx, "life.reward.exp", map[string]any{"Value": q.Exp}) }</strong></span>
										<span class="life-quest-reward"><strong>{ i18n.TData(ctx, "life.reward.gold", map[string]any{"Value": q.Gold}) }</strong></span>
										<span class="life-meta-chip life-meta-chip-diff">{ q.Difficulty }</span>
									</div>
								</li>
							}
						</ul>
						@lifeListPager(data.CompletedPage, "life-completed-pager")
					}
				</div>

				<div
					role="tabpanel"
					class="life-tab-panel"
					id="life-history-logs"
					data-testid="life-action-logs-section"
					if data.HistoryTab != LifeHistoryTabActionLogs {
						hidden
					}
				>
					if len(data.ActionLogs) == 0 {
						<p class="life-empty">{ i18n.T(ctx, "life.empty.completions_log") }</p>
					} else {
						<ul class="life-done-list" data-testid="life-action-logs">
							for _, l := range data.ActionLogs {
								<li class="life-done-row">
									<div class="life-done-main">
										<span class="life-done-title" title={ l.QuestTitle }>{ l.QuestTitle }</span>
										<span class="life-done-prompt">{ LifeActionLogSourceLabel(ctx, l.SourceType) } · { l.When }</span>
									</div>
									<div class="life-done-meta">
										<span class="life-quest-reward"><strong>{ i18n.TData(ctx, "life.reward.exp", map[string]any{"Value": l.GainedExp}) }</strong></span>
										<span class="life-quest-reward"><strong>{ i18n.TData(ctx, "life.reward.gold", map[string]any{"Value": l.GainedGold}) }</strong></span>
										if l.HasDice {
											<span class="life-meta-chip">{ i18n.TData(ctx, "life.meta.dice", map[string]any{"Value": fmt.Sprintf("%.2f", l.Dice)}) }</span>
										}
										if l.Dropped {
											<span class="life-meta-chip">{ i18n.T(ctx, "life.meta.drop") }</span>
										}
									</div>
								</li>
							}
						</ul>
						@lifeListPager(data.ActionLogsPage, "life-action-logs-pager")
					}
				</div>
			</section>
		</div>
		}
	}
}

templ LifeInventoryPage(data LifeInventoryData) {
	@layout.Base(ctx, DocTitleLife(ctx, "life.page.inventory.title")) {
		@lifeModuleShell(ctx, "inventory", data.PendingCount) {
			<div class="life-shell" data-testid="life-inventory-page">
				<header class="life-shell-header">
					<div>
						<h1>{ i18n.T(ctx, "life.page.inventory.title") }</h1>
						<p>{ i18n.T(ctx, "life.page.inventory.subtitle") }</p>
					</div>
				</header>

				<section class="life-panel life-section" data-testid="life-equip-board">
					<div class="life-section-head">
						<h2>{ i18n.T(ctx, "life.inventory.equipped") }</h2>
						<span class="life-section-count">{ lifeEquippedCount(data.Slots) }</span>
					</div>
					<div class="life-equip-stage" data-testid="life-equip-slots">
						for _, slot := range data.Slots {
							<div
								class={
									"life-equip-slot",
									"life-equip-slot-" + strings.ToLower(slot.Label),
									templ.KV("is-filled", slot.Item != nil),
									LifeSlotRarityClass(slot),
								}
								data-testid={ "life-equip-slot-" + strings.ToLower(slot.Label) }
							>
								<div class="life-equip-slot-top">
									<span class="life-equip-slot-icon" aria-hidden="true">
										@lifeEquipSlotIcon(slot.Label)
									</span>
									<p class="life-equip-slot-label">{ LifeEquipSlotLabel(ctx, slot.Label) }</p>
								</div>
								if slot.Item != nil {
									<p class="life-equip-slot-name">{ slot.Item.Name }</p>
									<div class="life-equip-slot-meta">
										<span class={ "life-meta-chip", "life-rarity-chip", LifeRarityClass(slot.Item.Rarity) }>{ LifeRarityLabel(ctx, slot.Item.Rarity) }</span>
										if slot.Item.BuffText != "" {
											<span class="life-meta-chip">{ slot.Item.BuffText }</span>
										}
										if slot.Item.PerkText != "" {
											<span class="life-meta-chip">{ i18n.TData(ctx, "life.inventory.perk", map[string]any{"Text": slot.Item.PerkText}) }</span>
										}
										if slot.Item.Tarnished {
											<span class="life-meta-chip life-meta-chip-warn">{ i18n.T(ctx, "life.inventory.tarnished") }</span>
										}
									</div>
									<button
										type="button"
										class="btn btn-sm life-equip-slot-action"
										hx-post={ "/service/web/life/inventory/slots/" + slot.SlotField + "/unequip" }
										hx-swap="none"
										data-testid={ "life-slot-unequip-" + strings.ToLower(slot.Label) }
									>{ i18n.T(ctx, "life.btn.unequip") }</button>
								} else {
									<p class="life-equip-slot-empty">{ i18n.T(ctx, "life.empty.inventory_slot") }</p>
								}
							</div>
						}
					</div>
				</section>

				<section id={ LifeBackpackAnchor } class="life-panel life-section life-anchor-target" data-testid="life-inventory">
					<div class="life-section-head">
						<h2>{ i18n.T(ctx, "life.inventory.backpack") }</h2>
						<span class="life-section-count">{ fmt.Sprintf("%d", data.BackpackPage.Total) }</span>
					</div>
					if len(data.Items) == 0 {
						<p class="life-empty">{ i18n.T(ctx, "life.empty.inventory_backpack") }</p>
					} else {
						<ul class="life-inv-list">
							for _, it := range data.Items {
								<li class={ "life-inv-card", templ.KV("is-equipped", it.Equipped), LifeRarityClass(it.Rarity) }>
									<div class="life-inv-icon" aria-hidden="true">
										@lifeEquipSlotIcon(it.Slot)
									</div>
									<div class="life-inv-body min-w-0">
										<p class="life-inv-title">
											{ it.Name }
											if it.Equipped {
												<span class="life-meta-chip life-meta-chip-ok text-xs ml-1 align-middle">{ i18n.T(ctx, "life.inventory.equipped_badge") }</span>
											}
										</p>
										<div class="life-quest-meta">
											<span class={ "life-meta-chip", "life-rarity-chip", LifeRarityClass(it.Rarity) }>{ LifeRarityLabel(ctx, it.Rarity) }</span>
											<span class="life-meta-chip">{ LifeEquipSlotLabel(ctx, it.Slot) }</span>
											if it.BuffText != "" {
												<span class="life-meta-chip">{ it.BuffText }</span>
											}
											if it.PerkText != "" {
												<span class="life-meta-chip">{ i18n.TData(ctx, "life.inventory.perk", map[string]any{"Text": it.PerkText}) }</span>
											}
											<span class="life-meta-chip">{ i18n.TData(ctx, "life.inventory.lore", map[string]any{"Status": LifeLoreStatusLabel(ctx, it.LoreStatus)}) }</span>
											if it.Tarnished {
												<span class="life-meta-chip life-meta-chip-warn">{ i18n.T(ctx, "life.inventory.tarnished") }</span>
											}
										</div>
										if it.Lore != "" {
											<p class="life-inv-lore">{ it.Lore }</p>
										}
									</div>
									<div class="life-quest-actions">
										if it.Equipped {
											<button
												type="button"
												class="btn btn-sm"
												hx-post={ "/service/web/life/inventory/slots/" + it.SlotField + "/unequip" }
												hx-swap="none"
												data-testid={ "life-unequip-" + it.Flag }
											>{ i18n.T(ctx, "life.btn.unequip") }</button>
										} else {
											<button
												type="button"
												class="btn btn-sm btn-primary"
												hx-post={ "/service/web/life/inventory/" + it.Flag + "/equip" }
												hx-swap="none"
												data-testid={ "life-equip-" + it.Flag }
											>{ i18n.T(ctx, "life.btn.equip") }</button>
										}
									</div>
								</li>
							}
						</ul>
						@lifeListPager(data.BackpackPage, "life-backpack-pager")
					}
				</section>
			</div>
		}
	}
}

templ LifeAchievementsPage(data LifeAchievementsData) {
	@layout.Base(ctx, DocTitleLife(ctx, "life.page.achievements.title")) {
		@lifeModuleShell(ctx, "achievements", data.PendingCount) {
			<div class="life-shell" data-testid="life-achievements-page">
				<header class="life-shell-header">
					<div>
						<h1>{ i18n.T(ctx, "life.page.achievements.title") }</h1>
						<p>{ i18n.T(ctx, "life.page.achievements.subtitle") }</p>
					</div>
					<span class="life-section-count" data-testid="life-achievements-count">
						{ i18n.TData(ctx, "life.achievements.unlocked_count", map[string]any{"Unlocked": data.UnlockedCount, "Total": len(data.Items)}) }
					</span>
				</header>

				<section class="life-panel life-section" data-testid="life-achievements-list">
					if len(data.Items) == 0 {
						<p class="life-empty">{ i18n.T(ctx, "life.empty.achievements") }</p>
					} else {
						<ul class="life-achievement-list">
							for _, item := range data.Items {
								<li
									class={
										"life-achievement-card",
										templ.KV("is-unlocked", item.Unlocked),
										templ.KV("is-retired", item.Retired),
									}
									data-testid={ "life-achievement-" + item.Flag }
								>
									<div class="life-achievement-head">
										<h2 class="life-achievement-name">{ LifeAchievementName(ctx, item.Flag, item.Name) }</h2>
										if item.Unlocked {
											<span class="life-meta-chip life-meta-chip-ok">{ i18n.T(ctx, "life.achievements.unlocked") }</span>
										} else {
											<span class="life-meta-chip">{ i18n.T(ctx, "life.achievements.locked") }</span>
										}
									</div>
									<p class="life-achievement-desc">{ LifeAchievementDescription(ctx, item.Flag, item.Description) }</p>
									if item.ShowProgress {
										<div class="life-achievement-progress" data-testid={ "life-achievement-progress-" + item.Flag }>
											<div class="life-seg-bar" aria-hidden="true">
												<div
													class="life-achievement-progress-fill"
													style={ fmt.Sprintf("width:%d%%", lifeAchievementProgressPct(item.Current, item.Target)) }
												></div>
											</div>
											<span class="life-seg-nums">{ fmt.Sprintf("%d / %d", item.Current, item.Target) }</span>
										</div>
									}
									if item.Unlocked && item.UnlockedAt != "" {
										<p class="life-achievement-meta">{ i18n.TData(ctx, "life.achievements.unlocked_at", map[string]any{"At": item.UnlockedAt}) }</p>
									}
									if item.Retired {
										<p class="life-achievement-meta">{ i18n.T(ctx, "life.achievements.retired") }</p>
									}
								</li>
							}
						</ul>
					}
				</section>
			</div>
		}
	}
}

templ LifeRewardsPage(data LifeRewardsData) {
	@layout.Base(ctx, DocTitleLife(ctx, "life.page.rewards.title")) {
		@lifeModuleShell(ctx, "rewards", data.PendingCount) {
			<div class="life-shell" data-testid="life-rewards-page">
				<header class="life-shell-header">
					<div>
						<h1>{ i18n.T(ctx, "life.page.rewards.title") }</h1>
						<p>{ i18n.T(ctx, "life.page.rewards.subtitle") }</p>
					</div>
					<div class="life-rewards-balance" data-testid="life-rewards-gold">
						<span class="life-rewards-balance-label">{ i18n.T(ctx, "life.rewards.balance") }</span>
						<span class="life-rewards-balance-value">{ fmt.Sprintf("%d", data.Gold) }</span>
						<span class="life-rewards-balance-unit">{ i18n.T(ctx, "life.rewards.balance_unit") }</span>
					</div>
				</header>

				<section class="life-panel life-section" data-testid="life-rewards-create">
					<header class="life-goals-head">
						<div>
							<h2 class="life-goals-title">{ i18n.T(ctx, "life.rewards.add_title") }</h2>
							<p class="life-goals-sub">{ i18n.T(ctx, "life.rewards.add_sub") }</p>
						</div>
					</header>
					<form
						class="life-rewards-compose"
						hx-post="/service/web/life/rewards"
						hx-swap="none"
						hx-disabled-elt="find button[type='submit'], find input"
						data-testid="life-rewards-create-form"
					>
						<input
							type="text"
							name="name"
							class="life-rewards-compose-name"
							required
							placeholder={ i18n.T(ctx, "life.rewards.name_placeholder") }
							autocomplete="off"
							data-testid="life-reward-name-input"
						/>
						<div class="life-rewards-compose-row">
							<label class="life-rewards-compose-field">
								<span class="life-field-label">{ i18n.T(ctx, "life.rewards.price") }</span>
								<input type="number" name="price" class="life-rewards-compose-num" min="1" required value="10" data-testid="life-reward-price-input"/>
							</label>
							<label class="life-rewards-compose-field">
								<span class="life-field-label">{ i18n.T(ctx, "life.rewards.cooldown") }</span>
								<input type="number" name="cooldown_hours" class="life-rewards-compose-num" min="0" value="0" data-testid="life-reward-cooldown-input"/>
							</label>
							<label class="life-rewards-compose-field life-rewards-compose-notes">
								<span class="life-field-label">{ i18n.T(ctx, "life.rewards.notes") }</span>
								<input type="text" name="notes" class="life-rewards-compose-text" placeholder={ i18n.T(ctx, "life.rewards.notes_placeholder") } data-testid="life-reward-notes-input"/>
							</label>
							<button type="submit" class="btn btn-sm btn-primary life-goals-compose-btn" data-testid="life-reward-create-submit">
								@partials.HtmxIndicator()
								{ i18n.T(ctx, "life.btn.add") }
							</button>
						</div>
					</form>
				</section>

				<section class="life-panel life-section" data-testid="life-rewards-active">
					<header class="life-goals-head">
						<div>
							<h2 class="life-goals-title">{ i18n.T(ctx, "life.rewards.active_title") }</h2>
							<p class="life-goals-sub">{ i18n.T(ctx, "life.rewards.active_sub") }</p>
						</div>
						if len(data.Active) > 0 {
							<span class="life-goals-count">{ fmt.Sprintf("%d", len(data.Active)) }</span>
						}
					</header>
					if len(data.Active) == 0 {
						<p class="life-empty">{ i18n.T(ctx, "life.empty.rewards_active") }</p>
					} else {
						<ul class="life-reward-list">
							for _, item := range data.Active {
								<li class="life-reward-card" data-testid={ "life-reward-" + item.Flag }>
									<div class="life-reward-main">
										<div class="life-reward-copy">
											<div class="life-reward-head">
												<h3 class="life-reward-name">{ item.Name }</h3>
												<span class="life-meta-chip" data-testid={ "life-reward-price-" + item.Flag }>
													{ fmt.Sprintf("%d %s", item.Price, i18n.T(ctx, "life.rewards.balance_unit")) }
												</span>
											</div>
											if item.Notes != "" {
												<p class="life-reward-notes">{ item.Notes }</p>
											}
											<div class="life-reward-meta-row">
												if item.OnCooldown {
													<span class="life-meta-chip life-meta-chip-warn" data-testid={ "life-reward-cooldown-" + item.Flag }>
														if item.CooldownEndsAt != "" {
															{ i18n.TData(ctx, "life.rewards.cooldown_until", map[string]any{"Until": item.CooldownEndsAt}) }
														} else {
															{ i18n.T(ctx, "life.rewards.on_cooldown") }
														}
													</span>
												} else if item.CooldownHours > 0 {
													<span class="life-meta-chip">{ i18n.TData(ctx, "life.rewards.cooldown_hours", map[string]any{"Hours": item.CooldownHours}) }</span>
												} else {
													<span class="life-meta-chip">{ i18n.T(ctx, "life.rewards.no_cooldown") }</span>
												}
												if !item.CanAfford && !item.OnCooldown {
													<span class="life-meta-chip" data-testid={ "life-reward-unaffordable-" + item.Flag }>{ i18n.T(ctx, "life.rewards.need_more_gold") }</span>
												}
											</div>
										</div>
										<div class="life-reward-cta">
											if item.CanRedeem {
												<form
													hx-post={ "/service/web/life/rewards/" + item.Flag + "/redeem" }
													hx-swap="none"
													data-testid={ "life-reward-redeem-" + item.Flag }
												>
													<button type="submit" class="btn btn-primary btn-sm">
														@partials.HtmxIndicator()
														{ i18n.T(ctx, "life.btn.redeem") }
													</button>
												</form>
											} else {
												<button type="button" class="btn btn-ghost btn-sm" disabled>{ i18n.T(ctx, "life.btn.redeem") }</button>
											}
										</div>
									</div>
									<div class="life-reward-footer">
										<details class="life-reward-edit" data-testid={ "life-reward-edit-" + item.Flag }>
											<summary class="life-goal-link">{ i18n.T(ctx, "life.btn.edit") }</summary>
											<form
												class="life-rewards-edit-form"
												hx-post={ "/service/web/life/rewards/" + item.Flag }
												hx-swap="none"
												hx-disabled-elt="find button[type='submit'], find input"
											>
												<label class="life-rewards-compose-field life-rewards-compose-notes">
													<span class="life-field-label">{ i18n.T(ctx, "life.rewards.name_label") }</span>
													<input type="text" name="name" class="life-rewards-compose-text" value={ item.Name } required aria-label={ i18n.T(ctx, "life.rewards.add_title") }/>
												</label>
												<label class="life-rewards-compose-field">
													<span class="life-field-label">{ i18n.T(ctx, "life.rewards.price") }</span>
													<input type="number" name="price" class="life-rewards-compose-num" min="1" value={ fmt.Sprintf("%d", item.Price) } required aria-label={ i18n.T(ctx, "life.rewards.price") }/>
												</label>
												<label class="life-rewards-compose-field">
													<span class="life-field-label">{ i18n.T(ctx, "life.rewards.cooldown") }</span>
													<input type="number" name="cooldown_hours" class="life-rewards-compose-num" min="0" value={ fmt.Sprintf("%d", item.CooldownHours) } aria-label={ i18n.T(ctx, "life.rewards.cooldown") }/>
												</label>
												<label class="life-rewards-compose-field life-rewards-compose-notes">
													<span class="life-field-label">{ i18n.T(ctx, "life.rewards.notes") }</span>
													<input type="text" name="notes" class="life-rewards-compose-text" value={ item.Notes } aria-label={ i18n.T(ctx, "life.rewards.notes") }/>
												</label>
												<button type="submit" class="btn btn-sm btn-primary">
													@partials.HtmxIndicator()
													{ i18n.T(ctx, "life.btn.save") }
												</button>
											</form>
										</details>
										<button
											type="button"
											class="life-goal-link life-goal-link-danger"
											hx-post={ "/service/web/life/rewards/" + item.Flag + "/deactivate" }
											hx-swap="none"
											data-confirm={ i18n.T(ctx, "confirm.deactivate_reward.message") }
											data-confirm-title={ i18n.T(ctx, "confirm.deactivate_reward.title") }
											data-confirm-btn={ i18n.T(ctx, "confirm.deactivate_reward.btn") }
											data-testid={ "life-reward-deactivate-" + item.Flag }
										>{ i18n.T(ctx, "life.btn.deactivate") }</button>
									</div>
								</li>
							}
						</ul>
					}
				</section>

				<section id={ LifeRewardsArchiveAnchor } class="life-panel life-section life-anchor-target" data-testid="life-rewards-archive">
					<div class="life-tabs" role="tablist" aria-label={ i18n.T(ctx, "life.rewards.redemptions") } data-testid="life-rewards-archive-tabs">
						<a
							role="tab"
							class={ LifeRewardsArchiveTabClass(data.ArchiveTab, LifeRewardsTabRedemptions) }
							href={ templ.URL(LifeRewardsListURL(data.RedemptionsPage.Page, data.InactivePage.Page, LifeRewardsTabRedemptions, LifeRewardsArchiveAnchor)) }
							if data.ArchiveTab == LifeRewardsTabRedemptions {
								aria-selected="true"
							} else {
								aria-selected="false"
							}
							data-testid="life-rewards-tab-redemptions"
						>
							{ i18n.T(ctx, "life.rewards.redemptions") }
							<span class="life-tab-count">{ fmt.Sprintf("%d", data.RedemptionsPage.Total) }</span>
						</a>
						<a
							role="tab"
							class={ LifeRewardsArchiveTabClass(data.ArchiveTab, LifeRewardsTabDeactivated) }
							href={ templ.URL(LifeRewardsListURL(data.RedemptionsPage.Page, data.InactivePage.Page, LifeRewardsTabDeactivated, LifeRewardsArchiveAnchor)) }
							if data.ArchiveTab == LifeRewardsTabDeactivated {
								aria-selected="true"
							} else {
								aria-selected="false"
							}
							data-testid="life-rewards-tab-deactivated"
						>
							{ i18n.T(ctx, "life.rewards.inactive") }
							<span class="life-tab-count">{ fmt.Sprintf("%d", data.InactivePage.Total) }</span>
						</a>
					</div>

					<div
						role="tabpanel"
						class="life-tab-panel"
						id="life-rewards-redemptions"
						data-testid="life-rewards-history"
						if data.ArchiveTab != LifeRewardsTabRedemptions {
							hidden
						}
					>
						if len(data.Redemptions) == 0 {
							<p class="life-empty">{ i18n.T(ctx, "life.empty.redemptions") }</p>
						} else {
							<ul class="life-reward-history" data-testid="life-rewards-history-list">
								for _, item := range data.Redemptions {
									<li data-testid={ "life-redemption-" + item.Flag }>
										<span class="life-reward-history-name">{ item.RewardName }</span>
										<span class="life-reward-history-meta">
											<span class="life-reward-history-price">{ fmt.Sprintf("−%d %s", item.PricePaid, i18n.T(ctx, "life.rewards.balance_unit")) }</span>
											<span class="life-reward-history-time">{ item.RedeemedAt }</span>
										</span>
									</li>
								}
							</ul>
							@lifeListPager(data.RedemptionsPage, "life-redemptions-pager")
						}
					</div>

					<div
						role="tabpanel"
						class="life-tab-panel"
						id="life-rewards-deactivated"
						data-testid="life-rewards-inactive"
						if data.ArchiveTab != LifeRewardsTabDeactivated {
							hidden
						}
					>
						if len(data.Inactive) == 0 {
							<p class="life-empty">{ i18n.T(ctx, "life.empty.rewards_inactive") }</p>
						} else {
							<ul class="life-reward-list">
								for _, item := range data.Inactive {
									<li class="life-reward-card is-inactive" data-testid={ "life-reward-inactive-" + item.Flag }>
										<div class="life-reward-main">
											<div class="life-reward-copy">
												<div class="life-reward-head">
													<h3 class="life-reward-name">{ item.Name }</h3>
													<span class="life-meta-chip">{ fmt.Sprintf("%d %s", item.Price, i18n.T(ctx, "life.rewards.balance_unit")) }</span>
												</div>
												if item.Notes != "" {
													<p class="life-reward-notes">{ item.Notes }</p>
												}
											</div>
											<form
												hx-post={ "/service/web/life/rewards/" + item.Flag + "/restore" }
												hx-swap="none"
												data-testid={ "life-reward-restore-" + item.Flag }
											>
												<button type="submit" class="btn btn-sm btn-primary">
													@partials.HtmxIndicator()
													{ i18n.T(ctx, "life.btn.restore") }
												</button>
											</form>
										</div>
									</li>
								}
							</ul>
							@lifeListPager(data.InactivePage, "life-inactive-pager")
						}
					</div>
				</section>
			</div>
		}
	}
}

templ LifeStatsPage(data LifeStatsShellData) {
	@layout.Base(ctx, DocTitleLife(ctx, "life.page.stats.title")) {
		@partials.LifeStatsScripts()
		@lifeModuleShell(ctx, "stats", data.PendingCount) {
			<div class="life-shell" data-testid="life-stats-page">
				<header class="life-shell-header">
					<div>
						<h1>{ i18n.T(ctx, "life.page.stats.title") }</h1>
						<p>{ i18n.T(ctx, "life.page.stats.subtitle") }</p>
					</div>
				</header>
				<div id="life-stats-container" data-testid="life-stats-loader">
					@partials.PanelSkeleton(ctx)
				</div>
			</div>
		}
	}
}

templ lifeEquipSlotIcon(slot string) {
	switch slot {
		case "Head":
			<svg class="life-equip-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M8 14v1.5A2.5 2.5 0 0 0 10.5 18h3A2.5 2.5 0 0 0 16 15.5V14"/><path d="M7 14c0-3.5 2.2-6 5-6s5 2.5 5 6"/><path d="M9.5 8.2C10 6.5 11 5.5 12 5.5s2 1 2.5 2.7"/><path d="M12 5.5V4"/></svg>
		case "Weapon":
			<svg class="life-equip-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M15 4l5 5"/><path d="M14 6l4 4"/><path d="M12.5 7.5L5 15l-1.2 5.2L9 19l7.5-7.5"/><path d="M8 16l2.5 2.5"/><path d="M4.5 19.5l2-.5"/></svg>
		case "Armor":
			<svg class="life-equip-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 5.5L12 4l3 1.5 2.5 2V10l-2 1v7.5H8.5V11l-2-1V7.5L9 5.5z"/><path d="M10 11h4"/><path d="M12 11v7.5"/></svg>
		case "Shoes":
			<svg class="life-equip-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 13.5l1.5-5.5h5.5l1 3h5a2 2 0 0 1 0 4H6a1.5 1.5 0 0 1-1.5-1.5z"/><path d="M7.5 15v2"/><path d="M16.5 15v2"/></svg>
		case "Accessory":
			<svg class="life-equip-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="13" r="5.5"/><circle cx="12" cy="13" r="2"/><path d="M12 4v3.2"/><path d="M10.2 5.2h3.6"/></svg>
		case "Artifact":
			<svg class="life-equip-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3.5l2.8 5.6 6.2.6-4.7 4.2 1.4 6.1L12 17.2 6.3 20l1.4-6.1L3 9.7l6.2-.6L12 3.5z"/></svg>
		default:
			<svg class="life-equip-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="5" width="14" height="14" rx="2"/></svg>
	}
}
