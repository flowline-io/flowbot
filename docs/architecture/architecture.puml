@startuml Flowbot Architecture
' =============================================================================
' Flowbot System Architecture — Component Diagram
' =============================================================================

skinparam componentStyle rectangle
skinparam backgroundColor #FEFEFE
skinparam defaultFontSize 12

title Flowbot System Architecture

' =============================================================================
' External
' =============================================================================
actor "Users" as Users
cloud "Chat Platforms\n(Discord / Slack / Tailchat)" as ChatCloud

package "PostgreSQL" as PostgreSQL #E8F5E9
package "Redis" as Redis #FFEBEE

' =============================================================================
' Entry Points
' =============================================================================
package "cmd/ — Entry Points" as EntryPoints #FFF3E0 {
  [Server\ncmd/main.go] as ServerEntry
  [Admin CLI\ncmd/cli/] as AdminCLI
  [Composer CLI\ncmd/composer/] as ComposerCLI
  [Gateway\ncmd/gateway/] as GatewayCLI
  [Agent CLI\ncmd/agent/] as AgentCLI
}

' =============================================================================
' Server Layer
' =============================================================================
package "internal/server/ — HTTP Layer (Fiber v3)" as ServerLayer #E3F2FD {
  [Router] as Router
  [Service Routes\n/service/{module}/*] as CapRoutes
  [Hub Routes\n/hub/*] as HubRoutes
  [Chatagent\n/chatagent/*] as ChatagentRoutes
  [Platform Callbacks] as PlatformRoutes
  [Swagger / OpenAPI] as Swagger
  [Media / Agent / OAuth] as MediaRoutes
}

' =============================================================================
' Platform Layer
' =============================================================================
package "internal/platforms/ — Chat Platform Adapters" as PlatformLayer #E8EAF6 {
  [Discord Adapter] as Discord
  [Slack Adapter] as SlackAdapter
  [Tailchat Adapter] as TailchatAdapter
}

' =============================================================================
' Modules
' =============================================================================
package "internal/modules/ — 5 Modules" as BotModules #F3E5F5 {
  [automate\nfunctions / pipeline / workflow] as AutomateMod
  [example] as ExampleMod
  [hub] as HubMod
  [life] as LifeMod
  [web\nSSR ops console] as WebMod
}

' =============================================================================
' Capability Layer
' =============================================================================
package "pkg/capability/ — Capability Abstraction" as CapLayer #FFF9C4 {
  [capability.Invoke] as Invoke
  [core / functions / gateway / life] as InternalCaps
  [Provider-backed caps\nkarakeep, miniflux, ...] as ProviderCaps
  [conformance/] as Conformance
}

' =============================================================================
' Provider Layer
' =============================================================================
package "pkg/providers/ — 29 Integrations" as ProviderLayer #E8F5E9 {
  [Forge\ngithub / gitea / drone] as ForgeP
  [Content\nkarakeep / miniflux / archivebox\ntrilium / memos / confluence] as ContentP
  [Ops\nbeszel / grafana / traefik\nuptimekuma / dozzle / wakapi\nnetalertx / scanopy / adguard] as OpsP
  [Work\nkanboard / trello / nocodb\nfireflyiii / n8n] as WorkP
  [Other\nemail / slack / slash\ntransmission / dropbox / example] as OtherP
}

' =============================================================================
' Workflow / Pipeline / Functions
' =============================================================================
package "Automate Engines" as WorkflowPipeline #FFCDD2 {
  [Workflow Engine\npkg/workflow/] as WorkflowEngine
  [Pipeline Engine\npkg/pipeline/] as PipelineEngine
  [Named Functions\npkg/functions/] as FunctionsEng
  [Executor\npkg/executor/] as Executor
}

' =============================================================================
' Hub / Homelab / Agent
' =============================================================================
package "Hub / Homelab / Agent" as HubHomelab #BBDEFB {
  [Homelab Scanner\npkg/homelab/] as HomelabScanner
  [Hub Manager\npkg/hub/] as HubManager
  [Agent Engine\npkg/agent/] as AgentEngine
  [Life Domain\npkg/life/] as LifeDomain
}

' =============================================================================
' Cross-Cutting
' =============================================================================
package "Cross-Cutting Packages" as CrossCutting #ECEFF1 {
  [auth / webauth] as Auth
  [notify (+ inapp)] as Notify
  [event] as Event
  [config / flog / types] as Config
  [cache / rdb / media / metrics] as InfraPkg
}

' =============================================================================
' Frontend (SSR Web UI)
' =============================================================================
package "pkg/views + internal/modules/web — SSR UI" as FrontendLayer #F3E5F5 {
  [templ pages/partials] as TemplViews
  [HTMX + Alpine.js] as HTMXAlpine
  [DaisyUI / Tailwind runtime] as DaisyUI
}

' =============================================================================
' Storage
' =============================================================================
package "internal/store/ — Data Layer" as StoreLayer #E0F2F1 {
  [DAO (Ent)\n~87 schemas] as DAO
  [Event Store] as EventStore
  [Audit Store] as AuditStore
}

' =============================================================================
' Connections — User → Platform → Server
' =============================================================================
Users --> ChatCloud : interacts via
ChatCloud --> Discord : webhooks
ChatCloud --> SlackAdapter : events
ChatCloud --> TailchatAdapter : messages
Discord --> Router
SlackAdapter --> Router
TailchatAdapter --> Router
ServerEntry --> Router
AdminCLI --> CapRoutes
ComposerCLI --> CapRoutes
GatewayCLI --> CapRoutes
AgentCLI --> ChatagentRoutes

' =============================================================================
' Connections — Server → Modules
' =============================================================================
Router --> AutomateMod
Router --> ExampleMod
Router --> HubMod
Router --> LifeMod
Router --> WebMod
ChatagentRoutes --> AgentEngine

' =============================================================================
' Connections — Module → Capability → Provider
' =============================================================================
AutomateMod --> Invoke : capability.Invoke()
HubMod --> Invoke
LifeMod --> Invoke
WebMod --> Invoke
AgentEngine --> Invoke

Invoke --> ProviderCaps
Invoke --> InternalCaps
ProviderCaps --> ForgeP
ProviderCaps --> ContentP
ProviderCaps --> OpsP
ProviderCaps --> WorkP
ProviderCaps --> OtherP

' =============================================================================
' Connections — Workflow / Pipeline
' =============================================================================
AutomateMod --> WorkflowEngine
AutomateMod --> PipelineEngine
AutomateMod --> FunctionsEng
WorkflowEngine --> Executor : Docker / kern
PipelineEngine --> Invoke
FunctionsEng --> Executor
Event --> PipelineEngine : Redis Stream

' =============================================================================
' Connections — Hub / Homelab / Life
' =============================================================================
HomelabScanner --> HubManager : scan / register
HubManager --> CapLayer : bind capability
HubMod --> HubManager
HubRoutes --> HubManager
LifeMod --> LifeDomain

' =============================================================================
' Connections — Storage
' =============================================================================
Router --> DAO : CRUD
Router --> EventStore : persist events
Router --> AuditStore : audit log
EventStore --> PostgreSQL
EventStore --> Redis : Redis Stream outbox
DAO --> PostgreSQL
AuditStore --> PostgreSQL
Event --> Redis : pub/sub
InfraPkg --> Redis

' =============================================================================
' Cross-cutting
' =============================================================================
Router --> Auth
Router --> Notify
Router --> Config

' =============================================================================
' Frontend
' =============================================================================
Users --> TemplViews : HTTPS /service/web/*
TemplViews --> Router : HTMX / form mutations
HTMXAlpine --> TemplViews
DaisyUI --> TemplViews

@enduml
