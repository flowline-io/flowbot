@startuml Layered Architecture
' =============================================================================
' Flowbot Layered Architecture Diagram
' =============================================================================

skinparam componentStyle rectangle
skinparam backgroundColor #FEFEFE
skinparam defaultFontSize 11

title Flowbot — Layered Architecture

' =============================================================================
' Layer 6: External
' =============================================================================
package "Layer 6 — External" as L6 #ECEFF1 {
  actor Users
  cloud "Discord / Slack / Tailchat" as Chat
  cloud "Third-Party APIs\n(GitHub, FireflyIII, Grafana, ...)" as APIs
}

' =============================================================================
' Layer 5: Platform Adapters
' =============================================================================
package "Layer 5 — Platform Adapters\ninternal/platforms/" as L5 #E8EAF6 {
  [Discord Driver] as DiscordDrv
  [Slack Driver] as SlackDrv
  [Tailchat Driver] as TailchatDrv
}

' =============================================================================
' Layer 4: HTTP / API Gateway
' =============================================================================
package "Layer 4 — HTTP Gateway\ninternal/server/ (Fiber v3)" as L4 #E3F2FD {
  [REST API\n/service/{module}/*] as REST
  [Hub API\n/hub/*] as HubAPI
  [Chatagent\n/chatagent/*] as ChatAPI
  [Platform Callbacks] as Callbacks
  [Auth Middleware] as AuthMW
  [Swagger] as Swagger
}

' =============================================================================
' Layer 3: Module / Business Logic
' =============================================================================
package "Layer 3 — Modules\ninternal/modules/ (5 modules)" as L3 #F3E5F5 {
  [Module Framework\npkg/module/] as ModuleFW
  [automate / hub / life / web / example] as BotMods
  [Workflow Engine\npkg/workflow/] as WF
  [Pipeline Engine\npkg/pipeline/] as Pipeline
  [Named Functions\npkg/functions/] as FaaS
  [LLM\npkg/agent/llm/] as LLM
  [Agent Engine\npkg/agent/] as AgentEng
}

' =============================================================================
' Layer 2: Capability Abstraction
' =============================================================================
package "Layer 2 — Capability Abstraction\npkg/capability/" as L2 #FFF9C4 {
  [capability.Invoke] as CapInvoke
  [Provider-backed\nkarakeep, miniflux, gitea, ...] as ProvCaps
  [Aggregates\ncore, devops, functions,\ngateway, life] as AggCaps
  note right
    capability.Invoke(capType, operation, params)
    Returns standard pagination (limit + opaque cursor)
    Wraps provider-specific errors to standard types
  end note
}

' =============================================================================
' Layer 1: Provider Adapters
' =============================================================================
package "Layer 1 — Provider Adapters\npkg/providers/ (29)" as L1 #E8F5E9 {
  [GitHub / Gitea / Drone] as DevGroup
  [Karakeep / ArchiveBox / Miniflux\nTrilium / Memos / Confluence] as ContentGroup
  [Kanboard / Trello / NocoDB] as KanbanGroup
  [Firefly III / n8n] as FinanceGroup
  [Beszel / Grafana / Traefik\nUptime Kuma / Dozzle / Wakapi\nNetAlertX / Scanopy / AdGuard] as OpsGroup
  [Transmission / Email / Slack\nSlash / Dropbox / Example] as OtherGroup
}

' =============================================================================
' Layer 0: Infrastructure
' =============================================================================
package "Layer 0 — Infrastructure" as L0 #FFEBEE {
  database "PostgreSQL 16" as PostgreSQL {
    [Data Events]
    [Audit Logs]
    [Users / Tokens]
    [Workflow / Pipeline / Function State]
  }
  database "Redis 7" as Redis {
    [Sessions]
    [Pub/Sub (Streams)]
    [Distributed Locks]
    [Cache]
  }
  [Docker / kern\n(pkg/executor/)] as Docker
}

' =============================================================================
' Hub / Homelab (Side Plane)
' =============================================================================
package "Management Plane — Hub & Homelab" as HubPlane #BBDEFB {
  [Homelab Scanner\npkg/homelab/] as Scanner
  [App Registry\ndocker-compose.yaml] as Registry
  [Hub Manager\npkg/hub/] as Hub
  [Capability Binding] as Binding
}

' =============================================================================
' Cross-Cutting
' =============================================================================
package "Cross-Cutting Concerns" as Cross #FFE0B2 {
  [AuthContext\npkg/auth/] as AuthCtx
  [Notifications\npkg/notify/] as Notify
  [Event System\npkg/event/] as EventSys
  [Structured Logging\npkg/flog/] as Flog
  [Metrics\npkg/metrics/] as Metrics
}

' =============================================================================
' Connections — Top to Bottom
' =============================================================================
Users --> Chat
Chat --> DiscordDrv
Chat --> SlackDrv
Chat --> TailchatDrv

DiscordDrv --> Callbacks
SlackDrv --> Callbacks
TailchatDrv --> Callbacks

REST --> BotMods : dispatch to modules
HubAPI --> Hub : management
ChatAPI --> AgentEng
Callbacks --> BotMods : platform events

BotMods --> CapInvoke : capability.Invoke()
AgentEng --> CapInvoke
WF --> CapInvoke
Pipeline --> CapInvoke
FaaS --> CapInvoke

CapInvoke --> ProvCaps
CapInvoke --> AggCaps

ProvCaps --> DevGroup
ProvCaps --> ContentGroup
ProvCaps --> KanbanGroup
ProvCaps --> FinanceGroup
ProvCaps --> OpsGroup
ProvCaps --> OtherGroup

BotMods --> WF : trigger workflows
BotMods --> Pipeline
BotMods --> FaaS
WF --> Docker : execute steps
FaaS --> Docker

REST --> PostgreSQL : persist
REST --> Redis : cache / lock

' =============================================================================
' Hub Plane
' =============================================================================
Scanner --> Registry : scan docker-compose.yaml
Registry --> Hub : register apps
Hub --> Binding : bind capability
Binding --> CapInvoke : register

' =============================================================================
' Cross-Cutting reaches all layers
' =============================================================================
AuthCtx -[hidden]-> REST
AuthCtx -[hidden]-> BotMods
Notify -[hidden]-> BotMods
EventSys -[hidden]-> BotMods

note bottom of L3
  <b>Architecture Rules:</b>
  1. Modules never import providers directly — use capability.Invoke()
  2. Providers never emit DataEvents or call Hub/Pipeline
  3. Never return provider-private types from adapters
  4. Durable events: DataEvent → PostgreSQL → Redis Stream → Pipeline
  5. Standard pagination: limit + opaque cursor
end note

@enduml
